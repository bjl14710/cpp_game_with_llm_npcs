.mfb.ok{background:rgba(52,211,153,.1);color:var(--green);border:1px solid rgba(52,211,153,.28)}
.mfb.no{background:rgba(248,113,113,.09);color:var(--red);border:1px solid rgba(248,113,113,.28)}

/* written */
textarea{width:100%;min-height:108px;background:var(--surf);border:1px solid var(--border);
         border-radius:6px;padding:.7rem .9rem;color:var(--text);font-family:inherit;
         font-size:.92rem;resize:vertical;line-height:1.55}
textarea:focus{outline:2px solid var(--accent)}
.wacts{display:flex;gap:.55rem;margin-top:.65rem;flex-wrap:wrap}
.kwres{margin-top:.8rem;display:none}
.tally{font-weight:700;margin-bottom:.4rem;font-size:.9rem}
.kwchips{display:flex;flex-wrap:wrap;gap:.35rem;margin-bottom:.55rem}
.kc{font-family:var(--mono);font-size:.75rem;padding:.18rem .5rem;border-radius:12px}
.kc.h{background:rgba(52,211,153,.12);color:var(--green);border:1px solid rgba(52,211,153,.28)}
.kc.m{background:rgba(248,113,113,.1);color:var(--red);border:1px solid rgba(248,113,113,.28)}
.knote{color:var(--dim);font-size:.78rem}
.modans{display:none;margin-top:.8rem;background:var(--surf);border:1px solid var(--border);
        border-radius:6px;padding:.8rem 1rem;font-size:.9rem;line-height:1.65}
.modlbl{font-family:var(--mono);font-size:.7rem;color:var(--dim);text-transform:uppercase;
        letter-spacing:.08em;margin-bottom:.35rem}
.sr{display:none;align-items:center;gap:.5rem;flex-wrap:wrap;
    font-size:.85rem;color:var(--dim);margin-top:.65rem}

/* nav + buttons */
.nav{display:flex;gap:.55rem;margin-top:1.5rem;flex-wrap:wrap;align-items:center}
.spc{flex:1}
.btn{font-family:var(--mono);font-size:.83rem;padding:.45rem 1rem;border:1px solid transparent;
     border-radius:5px;cursor:pointer;transition:opacity .15s;user-select:none}
.btn:focus{outline:2px solid var(--accent);outline-offset:2px}
.pri{background:var(--accent);color:#000}.pri:hover{opacity:.82}
.sec{background:var(--surf2);color:var(--text);border-color:var(--border)}
.sec:hover{border-color:var(--accent)}
.grn{background:var(--green);color:#000}
