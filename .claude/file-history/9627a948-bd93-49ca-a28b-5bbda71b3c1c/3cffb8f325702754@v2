<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Drill 0002 — Connections &amp; Documentation</title>
<style>
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
:root{
  --bg:#0c1320;--surf:#18223a;--surf2:#22304e;--surf3:#2c3e62;
  --accent:#60a5fa;--gold:#fcd34d;--green:#34d399;--red:#f87171;--orange:#fb923c;
  --text:#dde5f5;--dim:#5a6a8a;--border:#243052;--code:#080e1c;
  --mono:'Cascadia Code','Fira Mono','Consolas',monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);
     font-size:15px;line-height:1.68;min-height:100vh}
.screen{display:none;max-width:800px;margin:0 auto;padding:2rem 1.5rem 4rem}
.screen.active{display:block}

/* ── start ──────────────────────────────────────────────────── */
.hd{text-align:center;margin-bottom:2.2rem}
.lbl{font-family:var(--mono);font-size:.72rem;color:var(--dim);letter-spacing:.15em;
     text-transform:uppercase;margin-bottom:.4rem}
.ttl{font-size:2rem;color:#fff;margin-bottom:.4rem}
.sub{color:var(--accent);font-size:.95rem}

.chips{display:flex;flex-wrap:wrap;gap:.55rem;justify-content:center;margin:1.4rem 0}
.chip{font-family:var(--mono);font-size:.8rem;padding:.35rem .85rem;
      border:1px solid var(--border);border-radius:20px;cursor:pointer;
      background:var(--surf);color:var(--dim);user-select:none;transition:all .15s}
.chip.on{border-color:var(--accent);color:var(--accent);background:rgba(96,165,250,.1)}
.chip.all{border-color:var(--gold);color:var(--gold);background:rgba(252,211,77,.07)}
.chip.all.on{border-color:var(--gold);color:var(--gold)}

.smeta{text-align:center;color:var(--dim);font-size:.85rem;margin-bottom:.9rem}
.shuf{display:flex;align-items:center;justify-content:center;gap:.65rem;
      margin-bottom:1.4rem;font-size:.86rem;color:var(--dim)}
.tog{position:relative;display:inline-block;width:36px;height:20px}
.tog input{opacity:0;width:0;height:0}
.sl{position:absolute;inset:0;background:var(--surf2);border-radius:20px;cursor:pointer;transition:background .2s}
.sl:before{content:'';position:absolute;width:14px;height:14px;left:3px;top:3px;
           background:#fff;border-radius:50%;transition:transform .2s}
input:checked+.sl{background:var(--accent)}
input:checked+.sl:before{transform:translateX(16px)}

/* ── question ───────────────────────────────────────────────── */
.qhdr{display:flex;align-items:center;gap:.8rem;margin-bottom:1.5rem;flex-wrap:wrap}
.qnum{font-family:var(--mono);font-size:.78rem;color:var(--dim)}
.pbar{flex:1;height:5px;background:var(--surf2);border-radius:3px;min-width:80px}
.pfill{height:100%;background:var(--accent);border-radius:3px;transition:width .3s}
.ctag{font-family:var(--mono);font-size:.7rem;padding:.18rem .55rem;
      border:1px solid var(--border);border-radius:12px;color:var(--dim)}
.ttag{font-family:var(--mono);font-size:.7rem;padding:.18rem .55rem;border-radius:12px}
.ttag.mc{background:rgba(96,165,250,.12);color:var(--accent)}
.ttag.wr{background:rgba(251,146,60,.12);color:var(--orange)}

.qtxt{font-size:1.05rem;font-weight:600;color:#fff;margin-bottom:1.1rem;line-height:1.5}
pre.snip{background:var(--code);border:1px solid var(--border);border-radius:6px;
         padding:.9rem 1.1rem;overflow-x:auto;font-family:var(--mono);font-size:.82rem;
         line-height:1.6;margin-bottom:1.1rem;display:none}
.kw{color:#c792ea}.str{color:#c3e88d}.cm{color:#405060;font-style:italic}
.fn{color:#82aaff}.num{color:#f78c6c}.cls{color:#ffcb6b}.at{color:#a5d6ff}

/* mc */
.opts{list-style:none;margin:0;padding:0}
.opts li{background:var(--surf);border:1px solid var(--border);border-radius:6px;
         padding:.55rem 1rem;margin-bottom:.45rem;cursor:pointer;user-select:none;
         transition:border-color .15s,background .15s}
.opts li:hover:not(.lk){border-color:var(--accent);background:rgba(96,165,250,.07)}
.opts li:focus{outline:2px solid var(--accent);outline-offset:2px}
.opts li.ok{border-color:var(--green);background:rgba(52,211,153,.09);color:var(--green)}
.opts li.no{border-color:var(--red);background:rgba(248,113,113,.09);color:var(--red)}
