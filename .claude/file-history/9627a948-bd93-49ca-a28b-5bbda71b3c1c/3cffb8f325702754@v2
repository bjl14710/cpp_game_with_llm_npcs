  {t:'The app raises an ImportError at canvas.py import time and fails to start.',c:false,w:'canvas.py wraps register_custom_blocks() in a try/except that catches all exceptions, preventing any crash.'},
  {t:'Silmulator loads but the entire custom_blocks/ directory is ignored for that session.',c:false,w:'Only the one broken file is skipped. Other valid JSON files in the same directory are still loaded.'},
  {t:'The broken spec is loaded with a placeholder block that shows an error message on the canvas.',c:false,w:'No placeholder is created. The bad file is silently skipped by the continue statement inside the try/except.'},
 ]
},

