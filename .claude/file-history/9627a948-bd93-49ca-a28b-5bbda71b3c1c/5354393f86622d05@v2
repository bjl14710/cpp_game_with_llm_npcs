// ═══════════════════════════════════════════════════════════════════
// ENGINE
// ═══════════════════════════════════════════════════════════════════

const CHANNELS = ['workflow','code-path','sil-hil-cil','real-code','bugs'];
let activeChannels = new Set(CHANNELS);
let questions = [];
let currentIdx = 0;
let savedAnswers = {};   // id → { typed, kwResult, modelShown, selfRate }
let mcResults   = {};   // id → 'correct' | 'wrong'
let writtenRatings = {}; // id → 'knew' | 'review'
let reviewMode = false;
let reviewQueue = [];

// Channel chip wiring
document.querySelectorAll('.chip:not(.all-chip)').forEach(chip => {
  chip.addEventListener('click', () => {
    const ch = chip.dataset.channel;
    if (activeChannels.has(ch)) activeChannels.delete(ch);
    else activeChannels.add(ch);
    chip.classList.toggle('active', activeChannels.has(ch));
    // sync all-chip
    document.querySelector('.all-chip').classList.toggle('active', activeChannels.size === CHANNELS.length);
    updateStartMeta();
  });
});
document.querySelector('.all-chip').addEventListener('click', () => {
  const allOn = activeChannels.size === CHANNELS.length;
  if (allOn) { activeChannels.clear(); } else { CHANNELS.forEach(c => activeChannels.add(c)); }
  document.querySelectorAll('.chip:not(.all-chip)').forEach(c => c.classList.toggle('active', !allOn));
  document.querySelector('.all-chip').classList.toggle('active', !allOn);
  updateStartMeta();
});
function updateStartMeta() {
  const n = BANK.filter(q => activeChannels.has(q.channel)).length;
  document.getElementById('start-meta').textContent = `${n} question${n===1?'':'s'} selected`;
}

function shuffle(a) {
  for (let i = a.length-1; i>0; i--) {
    const j = Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]];
  }
  return a;
}

function startDrill() {
  questions = BANK.filter(q => activeChannels.has(q.channel));
  if (document.getElementById('shuffle-toggle').checked) shuffle(questions);
  if (!questions.length) return;
  currentIdx = 0; savedAnswers = {}; mcResults = {}; writtenRatings = {}; reviewMode = false;
  showScreen('screen-question');
  renderQ();
}

function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

function renderQ() {
  const q = questions[currentIdx];
  const n = questions.length;

  document.getElementById('q-num-badge').textContent = `Q ${currentIdx+1} / ${n}`;
  document.getElementById('q-progress-fill').style.width = ((currentIdx+1)/n*100)+'%';
  document.getElementById('q-cat-tag').textContent = q.channel;
  const typeTag = document.getElementById('q-type-tag');
  typeTag.textContent = q.type === 'mc' ? 'MC' : 'Written';
  typeTag.className = 'q-type-tag ' + (q.type==='mc' ? 'mc' : 'written');
  document.getElementById('q-text').innerHTML = q.text;

  const snippetEl = document.getElementById('q-snippet');
  if (q.snippet) { snippetEl.style.display='block'; snippetEl.innerHTML=q.snippet; }
  else snippetEl.style.display='none';

  document.getElementById('mc-area').style.display     = q.type==='mc' ? 'block' : 'none';
  document.getElementById('written-area').style.display= q.type!=='mc' ? 'block' : 'none';

  if (q.type === 'mc') renderMC(q);
  else renderWritten(q);

  // nav buttons
  document.getElementById('btn-prev').disabled = currentIdx===0;
  const isLast = currentIdx === n-1;
  document.getElementById('btn-next').style.display   = isLast ? 'none' : 'inline-block';
  document.getElementById('btn-finish').style.display = isLast ? 'inline-block' : 'none';
}

function renderMC(q) {
  const list = document.getElementById('mc-options');
  list.innerHTML = '';
  const fb = document.getElementById('mc-feedback');
  fb.style.display='none';

  const opts = [...q.options];
  shuffle(opts);
  const prev = mcResults[q.id]; // 'correct' | 'wrong' | undefined

  opts.forEach(opt => {
    const li = document.createElement('li');
    li.setAttribute('tabindex','0');
    li.setAttribute('data-correct', opt.correct ? 'true' : 'false');
    li.setAttribute('data-why', opt.why);
    li.textContent = opt.text;
    if (prev) {
      li.classList.add('locked');
      if (opt.correct) li.classList.add('correct');
      // If this was the chosen wrong one — we don't know which exactly after a re-render,
      // so just re-lock all and show feedback from stored result.
    }
    li.addEventListener('click', () => {
      if (li.classList.contains('locked')) return;
      list.querySelectorAll('li').forEach(x => x.classList.add('locked'));
      const correct = li.dataset.correct === 'true';
      li.classList.add(correct ? 'correct' : 'wrong');
      if (!correct) list.querySelectorAll('[data-correct="true"]').forEach(x=>x.classList.add('correct'));
      mcResults[q.id] = correct ? 'correct' : 'wrong';
      fb.style.display='block';
      fb.className='mc-feedback '+(correct?'ok':'bad');
      fb.textContent=(correct?'✓ Correct. ':'✗ Not quite. ')+li.dataset.why;
    });
    li.addEventListener('keydown', e => { if (e.key==='Enter'||e.key===' ') li.click(); });
    list.appendChild(li);
  });

  if (prev) {
    fb.style.display='block';
    fb.className='mc-feedback '+(prev==='correct'?'ok':'bad');
    fb.textContent = prev==='correct' ? '✓ You got this one.' : '✗ This one needs review.';
  }
}

function renderWritten(q) {
  const ta = document.getElementById('written-answer');
  const kwResult = document.getElementById('kw-result');
  const modelDiv = document.getElementById('model-answer');
  const selfRate = document.getElementById('selfrate');

  const saved = savedAnswers[q.id] || {};
  ta.value = saved.typed || '';
  kwResult.style.display = saved.kwResult ? 'block' : 'none';
  if (saved.kwResult) { document.getElementById('kw-tally').innerHTML=saved.kwResult.tally; document.getElementById('kw-chips').innerHTML=saved.kwResult.chips; }
  modelDiv.style.display = saved.modelShown ? 'block' : 'none';
  if (saved.modelShown) document.getElementById('model-text').textContent = q.model;
  selfRate.style.display = saved.modelShown ? 'flex' : 'none';
}

function saveWrittenState() {
  const q = questions[currentIdx];
  if (!q || q.type !== 'written') return;
  if (!savedAnswers[q.id]) savedAnswers[q.id] = {};
  savedAnswers[q.id].typed = document.getElementById('written-answer').value;
}

function checkWritten() {
  const q = questions[currentIdx];
  const text = (document.getElementById('written-answer').value || '').toLowerCase();
  const hits = q.concepts.map(c => ({ label:c.label, hit: c.terms.some(t=>text.includes(t.toLowerCase())) }));
  const got = hits.filter(h=>h.hit).length;
  const total = hits.length;
  const tally = `<strong>${got} / ${total} key concepts detected</strong>`;
  const chips = hits.map(h=>`<span class="kw-chip ${h.hit?'hit':'miss'}">${h.hit?'✓':'✗'} ${h.label}</span>`).join('');
  const kwResult = document.getElementById('kw-result');
  document.getElementById('kw-tally').innerHTML = tally;
  document.getElementById('kw-chips').innerHTML = chips;
  kwResult.style.display = 'block';
  if (!savedAnswers[q.id]) savedAnswers[q.id]={};
  savedAnswers[q.id].kwResult = {tally, chips};
  savedAnswers[q.id].typed = document.getElementById('written-answer').value;
}

function showModel() {
  const q = questions[currentIdx];
  const md = document.getElementById('model-answer');
  document.getElementById('model-text').textContent = q.model;
  md.style.display = 'block';
  document.getElementById('selfrate').style.display = 'flex';
  if (!savedAnswers[q.id]) savedAnswers[q.id]={};
  savedAnswers[q.id].modelShown = true;
  savedAnswers[q.id].typed = document.getElementById('written-answer').value;
}

function rateWritten(rating) {
  const q = questions[currentIdx];
  writtenRatings[q.id] = rating;
  if (!savedAnswers[q.id]) savedAnswers[q.id]={};
  savedAnswers[q.id].selfRate = rating;
  // visual feedback
  const sr = document.getElementById('selfrate');
  sr.querySelectorAll('button').forEach(b=>b.style.opacity='0.4');
  const chosen = rating==='knew' ? sr.children[1] : sr.children[2];
  if(chosen) chosen.style.opacity='1';
}

function prevQ() { saveWrittenState(); if (currentIdx>0){ currentIdx--; renderQ(); } }
function nextQ() { saveWrittenState(); if (currentIdx<questions.length-1){ currentIdx++; renderQ(); } }

function showResults() {
  saveWrittenState();
  const mcTotal   = questions.filter(q=>q.type==='mc').length;
  const mcCorrect = Object.values(mcResults).filter(v=>v==='correct').length;
  const mcAnswered= Object.keys(mcResults).length;
  const pct = mcAnswered===0 ? 0 : Math.round(mcCorrect/mcTotal*100);

  document.getElementById('score-big').textContent = `${mcCorrect}/${mcTotal}`;
  const label = pct===100 ? '🎉 Perfect MC score!' : pct>=60 ? `${pct}% — good, review misses below` : `${pct}% — worth re-reading the lesson`;
  document.getElementById('score-label').textContent = label + `  |  Written: see self-ratings below`;

  // MC misses
  const misses = questions.filter(q=>q.type==='mc' && mcResults[q.id]==='wrong');
  const missList = document.getElementById('mc-misses-list');
  if (misses.length===0) { missList.innerHTML='<em style="color:var(--text-dim);font-size:.88rem">None — clean sweep!</em>'; }
  else { missList.innerHTML = misses.map(q=>`<div class="missed-item">${q.text.slice(0,80)}…<br><span class="mc-correct">✓ ${q.options.find(o=>o.correct).text.slice(0,60)}</span></div>`).join(''); }

  // Written needs review
  const revList = document.getElementById('written-review-list');
  const needsReview = questions.filter(q=>q.type==='written' && writtenRatings[q.id]==='review');
  if (needsReview.length===0) { revList.innerHTML='<em style="color:var(--text-dim);font-size:.88rem">None flagged.</em>'; }
  else { revList.innerHTML = needsReview.map(q=>`<div class="missed-item">${q.text.slice(0,80)}…</div>`).join(''); }

  showScreen('screen-results');
}

function reviewMissed() {
  const mcMisses   = questions.filter(q=>q.type==='mc'      && mcResults[q.id]==='wrong');
  const writtenRev = questions.filter(q=>q.type==='written'  && writtenRatings[q.id]==='review');
  reviewQueue = [...mcMisses, ...writtenRev];
  if (!reviewQueue.length) return;
  // Reset their answers so they can try again
  mcMisses.forEach(q=>{ delete mcResults[q.id]; });
  writtenRev.forEach(q=>{ delete writtenRatings[q.id]; delete savedAnswers[q.id]; });
  questions = reviewQueue;
  currentIdx = 0; reviewMode = true;
  showScreen('screen-question');
  renderQ();
}
</script>
