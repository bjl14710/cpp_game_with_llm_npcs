class BenchRow:
    """One recorded benchmark observation (one CSV row)."""

    commit: str
    date_utc: str
    host_id: str
    bench: str
    messages: int
    p50_ns: int
    p99_ns: int
    p999_ns: int
    mean_ns: float
    max_ns: int
    runs_json: str
    flagged: bool


