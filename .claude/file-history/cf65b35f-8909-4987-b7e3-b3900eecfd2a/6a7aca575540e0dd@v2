add_library(itch_lib STATIC
    itch_parser.cpp
    order_book.cpp
    signal.cpp
)
target_include_directories(itch_lib PUBLIC ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_SOURCE_DIR}/cpp/common)
target_compile_options(itch_lib PRIVATE -O2)

add_executable(bench_main bench_main.cpp)
target_link_libraries(bench_main PRIVATE itch_lib)
target_include_directories(bench_main PRIVATE ${CMAKE_SOURCE_DIR}/cpp/common)

add_executable(bench_main_flat bench_main_flat.cpp)
target_link_libraries(bench_main_flat PRIVATE itch_lib)
target_include_directories(bench_main_flat PRIVATE ${CMAKE_SOURCE_DIR}/cpp/common)

# Standalone tool: filter a raw ITCH 5.0 sample file to a single symbol.
add_executable(itch_filter itch_filter_main.cpp)
target_compile_options(itch_filter PRIVATE -O2)
