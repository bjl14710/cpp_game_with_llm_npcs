      if (completed[key]) { delete completed[key]; btn.classList.remove("done"); btn.textContent = "Mark section complete"; }
      else { completed[key] = true; btn.classList.add("done"); btn.textContent = "✓ Completed"; }
      refreshPill();
    });
  });

  // ---- quiz: shuffle options in the DOM, check data-correct (never position) ----
  function shuffle(arr) {
    for (var i = arr.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;
    }
    return arr;
  }

  document.querySelectorAll("[data-question]").forEach(function (q) {
    var list = q.querySelector(".options");
    shuffle(Array.prototype.slice.call(list.children)).forEach(function (li) {
      list.appendChild(li); // reorder in DOM
    });
    var feedback = q.querySelector(".feedback");
    var answered = false;
    list.querySelectorAll("li").forEach(function (li) {
      li.addEventListener("click", function () {
        if (answered) return;          // first click locks the question
        answered = true;
        quizAnswered++;
        var correct = li.dataset.correct === "true";   // attribute, NOT position
        if (correct) quizCorrect++;
        li.classList.add(correct ? "picked-right" : "picked-wrong");
        list.querySelectorAll("li").forEach(function (el) {
          el.classList.add("locked");
          if (el.dataset.correct === "true") el.classList.add("picked-right");
        });
        feedback.hidden = false;
        feedback.textContent = (correct ? "✓ Correct. " : "✗ Not quite. ") + li.dataset.why;
        feedback.style.color = correct ? "var(--ok)" : "var(--bad)";
        refreshPill();
      });
    });
  });

  refreshPill();
})();
</script>
