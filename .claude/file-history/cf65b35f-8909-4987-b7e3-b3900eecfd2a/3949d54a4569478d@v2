-- flat_book.vhd — hardware flat-array order book, SIMULATION ONLY (SCAFFOLD).
-- Plan: .claude/plans/vhdl-flat-book.md.
--
-- Mirrors cpp/itch/order_book_flat.hpp's LEVEL update rule: ADD/REMOVE
-- shares at (side, tick_index), REMOVE clamps at zero (the phantom-depth
-- rule from _remove_level). Best bid/ask come from priority encoders over
-- per-side occupancy bitmasks — constant cycles at any DEPTH, which is the
-- whole comparison against the software O(range) scan.
--
-- Behaviour at op_index >= DEPTH is undefined-by-contract: the golden-vector
-- generator bounds-checks, matching the C++ book's error-count rejection.
--
-- TODO(vhdl-2): level arrays + clamp logic (parity on level totals).
-- TODO(vhdl-3): occupancy bitmask + priority encoders (bid side encodes
--   from the HIGH index, ask from the LOW — same directions as the C++
--   scans); DEPTH generic sweep must show constant cycles-per-op.

library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity flat_book is
  generic (
    DEPTH    : positive := 4096;  -- price levels per side
    SHARES_W : positive := 32     -- shares counter width
  );
  port (
    clk       : in  std_logic;
    rst       : in  std_logic;
    -- one level operation per cycle when op_valid
    op_valid  : in  std_logic;
    op_kind   : in  std_logic;                          -- '0' ADD, '1' REMOVE
    op_side   : in  std_logic;                          -- '0' BID, '1' ASK
    op_index  : in  unsigned(11 downto 0);              -- tick index (DEPTH<=4096)
    op_shares : in  unsigned(SHARES_W - 1 downto 0);
    -- best-of-book outputs (registered)
    best_bid_valid  : out std_logic;
    best_bid_index  : out unsigned(11 downto 0);
    best_bid_shares : out unsigned(SHARES_W - 1 downto 0);
    best_ask_valid  : out std_logic;
    best_ask_index  : out unsigned(11 downto 0);
    best_ask_shares : out unsigned(SHARES_W - 1 downto 0);
    -- pulses when a REMOVE clamped at zero (mirrors error_count semantics)
    err_underflow_clamped : out std_logic
  );
end entity flat_book;

architecture rtl of flat_book is
  -- TODO(vhdl-2): two level arrays (BRAM-style), per-side occupancy
  -- bitmask; TODO(vhdl-3): priority encoders.
begin
  -- TODO(vhdl-2): implement. Scaffold ties outputs inactive so the file
  -- analyzes cleanly under `ghdl -a` before implementation begins.
  best_bid_valid  <= '0';
  best_bid_index  <= (others => '0');
  best_bid_shares <= (others => '0');
  best_ask_valid  <= '0';
  best_ask_index  <= (others => '0');
  best_ask_shares <= (others => '0');
  err_underflow_clamped <= '0';
end architecture rtl;
