def test_engulf_signal_feature_parity_with_detector(make_ohlcv):
    """The vectorized engulf_signal column must agree with the REAL detector
    on every consecutive bar pair — the detector stays the source of truth."""
    import numpy as np
    from paper_trading_sim import build_features
    from strategies.engulfing import EngulfingStrategy

    rng = np.random.RandomState(13)
    closes = list(100 * np.cumprod(1 + rng.normal(0, 0.02, 120)))
    opens = [c * (1 + rng.normal(0, 0.01)) for c in closes]
    df = make_ohlcv(closes, opens=opens)
    feats = build_features(df)

    detector = EngulfingStrategy()
    direction_map = {"BUY": 1, "SELL": -1, "HOLD": 0}
    for ts in feats.index:
        i = df.index.get_loc(ts)
        if i == 0:
            continue
        expected = direction_map[detector.generate_signal(df.iloc[i - 1], df.iloc[i]).direction]
        assert feats.loc[ts, "engulf_signal"] == expected, f"mismatch at {ts}"


