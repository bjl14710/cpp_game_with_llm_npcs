def test_confirmed_direction_mode_matrix():
    """agree -> base signal through; oppose -> HOLD; confirmer-HOLD blocks."""
    from strategies.confirmed import ConfirmedStrategy

    df = pd.DataFrame({"Close": [1, 2, 3]})
    agree = ConfirmedStrategy(_Fixed(1), _Fixed(1), mode="direction").generate_signal(df)
    assert agree.position == 1 and agree.confidence == pytest.approx(0.7)
    assert ConfirmedStrategy(_Fixed(1), _Fixed(-1), mode="direction").generate_signal(df).position == 0
    assert ConfirmedStrategy(_Fixed(1), _Fixed(0), mode="direction").generate_signal(df).position == 0
    # base HOLD passes straight through regardless of confirmer
    assert ConfirmedStrategy(_Fixed(0), _Fixed(1), mode="direction").generate_signal(df).position == 0


