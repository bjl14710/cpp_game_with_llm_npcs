<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent: weekday arena paper-trading tick at 17:30 local (after US
     market close). launchd fires missed jobs on wake, and the arena
     self-backfills, so sleep/shutdown gaps heal themselves.
     Install:  cp scripts/arena.plist ~/Library/LaunchAgents/com.algotrading.arena.plist
               launchctl load ~/Library/LaunchAgents/com.algotrading.arena.plist
     Remove:   launchctl unload ~/Library/LaunchAgents/com.algotrading.arena.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.algotrading.arena</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/brandonlee/development/repos/products/algo_trading/scripts/arena_daily.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/algotrading-arena.launchd.log</string>
  <key>StandardErrorPath</key><string>/tmp/algotrading-arena.launchd.log</string>
</dict>
</plist>
