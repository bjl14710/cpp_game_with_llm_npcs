def main() -> None:
    tok = os.environ.get("GH_TOKEN", "")
    H = {"Authorization": f"Bearer {tok}", "Accept": "application/vnd.github+json"}
    who = requests.get("https://api.github.com/user", headers=H)
    if who.status_code != 200:
        sys.exit("GH_TOKEN invalid")
    print("Authenticated as", who.json()["login"])

    issues = requests.get(f"{API}/issues?state=open&per_page=100", headers=H).json()
    existing = {i["title"].lower() for i in issues if "pull_request" not in i}

    ms = requests.get(f"{API}/milestones?state=open&per_page=100", headers=H).json()
    ms_num = next((m["number"] for m in ms if m["title"] == MILESTONE_TITLE), None)
    if ms_num is None:
        r = requests.post(f"{API}/milestones", headers=H,
                          json={"title": MILESTONE_TITLE, "description": MILESTONE_DESC})
        r.raise_for_status()
        ms_num = r.json()["number"]
        print(f"Created milestone #{ms_num}")
    else:
        print(f"Reusing milestone #{ms_num}")

    for title, slug, plan, stubs, constraints in SPECS:
        if title.lower() in existing:
            print("Skipping (exists):", title)
            continue
        body = BODY.format(plan=plan, stubs=stubs, constraints=constraints, slug=slug)
        r = requests.post(f"{API}/issues", headers=H, json={
            "title": title, "body": body.replace("{number}", "N"),
            "labels": ["ready-for-ai"], "assignees": [USERNAME], "milestone": ms_num})
        r.raise_for_status()
        issue = r.json()
        requests.patch(f"{API}/issues/{issue['number']}", headers=H,
                       json={"body": body.replace("{number}", str(issue["number"]))}).raise_for_status()
        print(f"  Created #{issue['number']}: {title}")

    q = requests.get(f"{API}/issues?state=open&labels=ready-for-ai&per_page=100", headers=H).json()
    print("\nready-for-ai queue:", sum(1 for i in q if "pull_request" not in i), "issues")


if __name__ == "__main__":
    main()
