def _live_args(**overrides):
    """argparse.Namespace matching arena-run live's flags, sensible defaults."""
    base = dict(
        db=None, strategies="always-long", tickers="AAA", tickers_file=None,
        top_n=1, capital=1000.0, trade_cost_bps=0.0, gbm_bundle=None,
        max_pos=0.30, vol_window=20, cost_model="none", commission_bps=0.0,
        half_spread_bps=0.0, impact_coeff_bps=0.0, fallback_adv=1_000_000.0,
        lookback_days=200, breaker_dd=0.20, no_breaker=False,
        divergence_z=2.0, min_live_days=20, no_regime_gate=True,
    )
    base.update(overrides)
    return argparse.Namespace(**base)


def test_cmd_live_trips_breaker_on_real_drawdown_then_skips_and_reports(
    tmp_path, make_ohlcv, monkeypatch
):
    """End-to-end acceptance check: a >20% drawdown through the real
    cmd_live path pauses the strategy, logs a TRIP, a subsequent live run
    skips it, and the report surfaces paused_since."""
    from strategies.registry import STRATEGY_REGISTRY

    monkeypatch.setitem(STRATEGY_REGISTRY, "always-long", AlwaysLong)

    db = str(tmp_path / "arena.db")
    state = ArenaState(db)
    state.record_backtest("always-long", "PASS", {"Sharpe": 1.0, "CAGR": 0.1, "MaxDD": -0.1})

    # Rises then craters >21% from its peak — should trip the -20% breaker.
    closes = [100, 110, 120, 130, 100.0]  # peak 130 -> 100 is a -23.1% drawdown
    monkeypatch.setattr(paper_trading_sim, "fetch_history",
                        lambda tickers, start, end: {"AAA": make_ohlcv(closes)})

    cmd_live(_live_args(db=db))

    assert state.statuses()["always-long"] == "PAUSED"
    trips = state.conn.execute(
        "SELECT event FROM breaker_events WHERE strategy='always-long'"
    ).fetchall()
    assert ("TRIP",) in trips

    table = compare_strategies(state.conn).set_index("strategy")
    assert table.loc["always-long", "status"] == "PAUSED"
    assert table.loc["always-long", "paused_since"] is not None

    # A subsequent live run must skip it — no new rows, no re-evaluation.
    equity_count_before = state.conn.execute(
        "SELECT COUNT(*) FROM equity WHERE strategy='always-long'"
    ).fetchone()[0]
    cmd_live(_live_args(db=db))
    equity_count_after = state.conn.execute(
        "SELECT COUNT(*) FROM equity WHERE strategy='always-long'"
    ).fetchone()[0]
    assert equity_count_after == equity_count_before
    assert state.statuses()["always-long"] == "PAUSED"  # still paused, untouched


def test_legacy_db_upgrades_in_place_for_breaker_columns(tmp_path):
    db_path = str(tmp_path / "legacy_arena.db")
    conn = sqlite3.connect(db_path)
    conn.execute(
        "CREATE TABLE strategies (name TEXT PRIMARY KEY, status TEXT NOT NULL, "
        "backtest_sharpe REAL, backtest_cagr REAL, backtest_maxdd REAL, updated TEXT)"
    )
    conn.execute("INSERT INTO strategies VALUES ('old', 'PASS', 0.5, 0.1, -0.1, '2026-01-01')")
    conn.commit()
    conn.close()

    upgraded = ArenaState(db_path)
    assert upgraded.anchor("old") is None  # column exists, defaults NULL, no crash
    assert upgraded.running_drawdown("old") is None  # no equity rows either, fine
