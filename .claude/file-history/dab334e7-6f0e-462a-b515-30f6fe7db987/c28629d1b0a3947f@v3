"""Low-volatility long-only selection (betting-against-beta proxy) — scaffold.

Spec: .claude/plans/low-volatility.md. Confidence = 1/sigma so the arena's
existing top_n confidence ranking structurally prefers the calmest names.
"""
import pandas as pd

from strategies.daily import HOLD, DailySignal, DailyStrategy


class LowVolatilityStrategy(DailyStrategy):
    """Always-long with confidence inverse to trailing realized volatility.

    NOT yet registered in strategies/registry.py — registration happens in
    the implementing commit.
    """

    name = "lowvol"

    def __init__(self, vol_lookback: int = 252) -> None:
        self.vol_lookback = vol_lookback

    @property
    def warmup_bars(self) -> int:
        return self.vol_lookback + 1

    def generate_signal(self, df: pd.DataFrame) -> DailySignal:
        """Always long; confidence = 1/sigma so the arena's top_n confidence
        ranking structurally prefers the calmest names — the cross-sectional
        selection happens in the loop, keeping the per-ticker contract."""
        if len(df) < self.warmup_bars:
            return HOLD
        returns = df["Close"].astype(float).pct_change().iloc[-self.vol_lookback:]
        sigma = max(float(returns.std()), 1e-4)  # halted ticker can't take infinity
        return DailySignal(position=1, confidence=1.0 / sigma,
                           reason=f"low-vol sigma={sigma:.4f}")


__all__ = ["LowVolatilityStrategy"]
