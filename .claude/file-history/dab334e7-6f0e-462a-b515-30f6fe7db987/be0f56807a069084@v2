        self.title("HFT Practice – GUI")
        self.geometry("1000x700")

        nb = ttk.Notebook(self)
        nb.pack(fill=tk.BOTH, expand=True)

        # Each tab is a ScrollableTab; the builders target the .inner frame,
        # so all existing _build_* code keeps gridding into a plain Frame.
        for attr, label in [("walk_tab", "Walkforward"), ("train_tab", "Train/Backtest"),
                            ("universe_tab", "Universe Builder"), ("news_tab", "News"),
                            ("exec_tab", "Execution"), ("eval_tab", "Analyze Equity"),
