    def _download_history(self):
        # Download yfinance OHLCV for the chosen tickers and dates to CSV files
        threading.Thread(target=self._download_history_impl, daemon=True).start()

    def _download_history_impl(self):
        try:
            self.status_var.set("Downloading...")
            tfile = self.tickers_file_var.get()
            if not os.path.exists(tfile):
                raise RuntimeError("Tickers file not found")
            with open(tfile, "r", encoding="utf-8") as f:
                tickers = [ln.strip() for ln in f if ln.strip() and not ln.startswith("#")]
            from walkforward_sim import parse_tickers as _pf
            tickers = _pf(
                ",".join(tickers),
                None,
            )
            out_dir = self.data_dir_var.get()
            os.makedirs(out_dir, exist_ok=True)
            start = pd.to_datetime(self.start_var.get()).date()
            end = pd.to_datetime(self.end_var.get()).date()
            # yfinance treats 'end' as exclusive; add one day to include the final date
            end_inclusive = (pd.Timestamp(end) + pd.Timedelta(days=1)).date()
            saved = 0
            failures = []

            def alt_symbols(sym: str):
                alts = [sym]
                if "." in sym:
                    alts.append(sym.replace(".", "-"))
                if "-" in sym:
                    alts.append(sym.replace("-", "."))
                # Deduplicate preserving order
                seen = set()
                out = []
                for s in alts:
                    if s not in seen:
                        seen.add(s)
                        out.append(s)
                return out

            # Batch downloads for speed
            BATCH = 50
            for i in range(0, len(tickers), BATCH):
                batch = tickers[i:i+BATCH]
                df = None
                last_err = None
                try:
                    df = yf.download(batch, start=start, end=end_inclusive, interval="1d", group_by="ticker", auto_adjust=True, threads=True, progress=False)
                except Exception as e:
                    last_err = e
                if df is None:
                    # Fall back to per-symbol
                    for t in batch:
                        single = None
                        err = None
                        for sym in alt_symbols(t):
                            try:
                                tmp = yf.download(sym, start=start, end=end_inclusive, interval="1d", auto_adjust=True, progress=False)
                                if isinstance(tmp, pd.DataFrame) and not tmp.empty:
                                    single = tmp
                                    break
                            except Exception as e:
                                err = e
                        if single is not None and not single.empty:
                            single.to_csv(os.path.join(out_dir, f"{t}.csv"))
                            saved += 1
                        else:
                            failures.append((t, str(err) if err else "no data"))
                else:
                    # Split multi-index by ticker
                    if isinstance(df.columns, pd.MultiIndex):
                        for t in batch:
                            if t in df:
                                sub = df[t].dropna()
                                if not sub.empty:
                                    sub.to_csv(os.path.join(out_dir, f"{t}.csv"))
                                    saved += 1
                                else:
                                    failures.append((t, "no data"))
                            else:
                                failures.append((t, "missing from batch"))
                    else:
                        # Batch of 1 returned flat frame
                        t = batch[0]
                        if isinstance(df, pd.DataFrame) and not df.empty:
                            df.to_csv(os.path.join(out_dir, f"{t}.csv"))
                            saved += 1
                        else:
                            failures.append((t, "no data"))

            msg = f"Saved {saved} CSV files to {out_dir}."
            if failures:
                msg += f" Failed: {len(failures)} (see details)."
            self.status_var.set(msg)
            if failures:
                detail = "\n".join([f"{t}: {err}" for t, err in failures[:20]])
                messagebox.showwarning("Download Partial", msg + "\n\n" + detail)
            else:
                messagebox.showinfo("Download Complete", msg)
        except Exception as e:
            self.status_var.set("Error")
            messagebox.showerror("Download Error", str(e))

    def _evaluate_equity(self):
        try:
            path = self.eval_eq_var.get()
            if not os.path.exists(path):
                raise RuntimeError("Equity CSV not found")
            df = pd.read_csv(path, index_col=0, parse_dates=True)
            if "equity" not in df.columns:
                raise RuntimeError("CSV must contain 'equity' column")
            m = compute_metrics(df["equity"])  # dict

            # Plot daily returns
            ret = df["equity"].pct_change().dropna()
            self.eval_ax.clear()
            self.eval_ax.plot(ret.index, ret.values)
            self.eval_ax.set_title("Daily Returns")
            self.eval_ax.set_xlabel("Date")
            self.eval_ax.set_ylabel("Return")
            self.eval_canvas.draw_idle()

            # Popup with metrics
            text = []
            order = [
                "Initial", "Final", "TotalReturn", "Years(approx)",
                "CAGR", "APR_simple", "Vol", "Sharpe", "MaxDD",
            ]
            for k in order:
                v = m.get(k)
                if isinstance(v, float):
                    if k in ("TotalReturn", "CAGR", "APR_simple", "Vol", "MaxDD"):
                        text.append(f"{k}: {v:.2%}")
                    elif k == "Sharpe":
                        text.append(f"{k}: {v:.2f}")
                    else:
                        text.append(f"{k}: {v:.2f}")
                else:
                    text.append(f"{k}: {v}")
            messagebox.showinfo("Equity Metrics", "\n".join(text))
        except Exception as e:
            messagebox.showerror("Evaluate Error", str(e))

    # ------------------------------------------------------------------
