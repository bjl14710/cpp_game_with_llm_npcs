            value="Idle — signals are read-only (execution stays in the Execution tab / rh-exec)")
        ttk.Label(f, textvariable=self.live_status_var).grid(row=row, column=0, columnspan=4, sticky="w", **pad)
        row += 1
        self.live_text = tk.Text(f, height=24, width=110, state=tk.DISABLED)
        self.live_text.grid(row=row, column=0, columnspan=4, sticky="nsew", **pad)
