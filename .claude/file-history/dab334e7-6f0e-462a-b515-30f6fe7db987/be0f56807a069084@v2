    def _run_rh_executor(self):
        threading.Thread(target=self._run_rh_executor_impl, daemon=True).start()

    def _run_rh_executor_impl(self):
        try:
            alloc = self.exec_alloc_var.get()
            if not os.path.exists(alloc):
                raise RuntimeError("Allocation CSV not found")
            side = self.exec_side_var.get()
            min_dollars = float(self.exec_min_var.get())
            dry_run = bool(self.exec_dry_var.get())

            if not dry_run:
                confirm = messagebox.askyesno(
                    "Send live Robinhood orders",
                    "This will submit live market orders via Robinhood using robin_stocks and your RH_* env vars. Continue?",
                )
                if not confirm:
                    self.exec_status_var.set("Cancelled")
                    return

            cmd = [
                sys.executable,
                "-m",
                "scripts.robinhood_executor",
                "--alloc_csv",
                alloc,
                "--side",
                side,
                "--min_dollars",
                str(min_dollars),
            ]
            if dry_run:
                cmd.append("--dry_run")

            self.exec_status_var.set("Running...")
            proc = subprocess.run(cmd, capture_output=True, text=True)
            stdout = proc.stdout.strip()
            stderr = proc.stderr.strip()
            if proc.returncode != 0:
                raise RuntimeError(stderr or stdout or f"Executor failed with code {proc.returncode}")
            msg = stdout or "Done"
            self.exec_status_var.set((msg.splitlines()[0])[:120])
            messagebox.showinfo("Robinhood Executor", msg)
        except Exception as e:
            self.exec_status_var.set("Error")
            messagebox.showerror("Robinhood Executor Error", str(e))

