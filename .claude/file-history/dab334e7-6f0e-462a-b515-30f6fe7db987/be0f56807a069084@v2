        f.grid_columnconfigure(1, weight=1)
        self.live_text.tag_configure("signal", foreground="#0e7a4f", font=("TkDefaultFont", 0, "bold"))
        self._live_stop_event = None

    def _live_append(self, line: str) -> None:
        """Marshal a tape line onto the Tk thread and append it."""
        def _do():
            self.live_text.configure(state=tk.NORMAL)
            tag = ("signal",) if "NEW SIGNAL" in line else ()
            self.live_text.insert(tk.END, line + "\n", *tag)
            self.live_text.see(tk.END)
            self.live_text.configure(state=tk.DISABLED)
        self.after(0, _do)

    def _start_live_watch(self):
        import time as _time
        from intraday_sim import STRATEGIES
        from live_watch import _default_fetch, watch_once

        tickers = [t.strip().upper() for t in self.live_tickers_var.get().split(",") if t.strip()]
        if not tickers:
            messagebox.showerror("Live Signals", "Enter at least one ticker")
            return
        try:
            refresh = max(5, int(self.live_refresh_var.get()))
        except ValueError:
            messagebox.showerror("Live Signals", "Refresh must be a number of seconds")
            return
        strategy = STRATEGIES[self.live_strategy_var.get()]()
        interval = self.live_interval_var.get()
        stop = threading.Event()
        self._live_stop_event = stop
        self.live_start_btn.config(state=tk.DISABLED)
        self.live_stop_btn.config(state=tk.NORMAL)
        self.live_status_var.set(f"Watching {', '.join(tickers)} on {interval} bars "
                                 f"(completed bars only; ~1 min feed delay from yfinance)")

        def loop():
            seen = {}
            while not stop.is_set():
                stamp = dt.datetime.now().strftime("%H:%M:%S")
                for line in watch_once(tickers, strategy, interval, _default_fetch, seen):
                    self._live_append(f"[{stamp}] {line}")
                stop.wait(refresh)
            self.after(0, lambda: self.live_status_var.set("Stopped"))

        threading.Thread(target=loop, daemon=True).start()

    def _stop_live_watch(self):
        if self._live_stop_event is not None:
            self._live_stop_event.set()
        self.live_start_btn.config(state=tk.NORMAL)
        self.live_stop_btn.config(state=tk.DISABLED)


