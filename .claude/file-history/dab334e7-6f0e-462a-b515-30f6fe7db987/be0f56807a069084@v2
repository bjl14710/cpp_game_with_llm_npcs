    def _run_walkforward_impl(self):
        try:
            kwargs = dict(
                bundle_path=self.model_var.get(),
                tickers=["AAPL"],  # ignored; we pass tickers via file in simulate args
                start=self.start_var.get(),
                end=self.end_var.get(),
                top_n=int(self.topn_var.get()),
                optimize=self.opt_var.get(),
                cov_lookback=int(self.covlb_var.get()),
                shrink=float(self.shrink_var.get()),
                max_w=float(self.maxw_var.get()),
                capital=float(self.capital_var.get()),
                trade_cost_bps=float(self.cost_var.get()),
                use_news=bool(self.use_news_var.get()),
                news_features_csv=(self.news_file_var.get() or None),
                rolling_retrain=bool(self.rr_var.get()),
                retrain_freq=self.rr_freq_var.get(),
                train_window_days=int(self.rr_window_var.get()),
                min_train_days=int(self.rr_min_days_var.get()),
                risk_overlay=bool(self.risk_var.get()),
                risk_vol_window=int(self.risk_vol_win_var.get()),
                risk_vol_threshold=float(self.risk_vol_thr_var.get()),
                risk_dd_window=int(self.risk_dd_win_var.get()),
                risk_dd_threshold=float(self.risk_dd_thr_var.get()),
                risk_scale=float(self.risk_scale_var.get()),
                event_calendar_csv=(self.event_csv_var.get() or None),
            )

            # Parse tickers file (one per line)
            tfile = self.tickers_file_var.get()
            if not os.path.exists(tfile):
                raise RuntimeError("Tickers file not found")
            with open(tfile, "r", encoding="utf-8") as f:
                tickers = [ln.strip() for ln in f if ln.strip() and not ln.startswith("#")]
            # Import parse_tickers from walkforward_sim to normalize (BRK.B -> BRK-B)
            from walkforward_sim import parse_tickers as _pf
            tickers = _pf(
                ",".join(tickers),
                None,
            )

            sig = inspect.signature(simulate_walkforward)
            supported = set(sig.parameters.keys())
            if "tickers" not in supported:
                raise RuntimeError("simulate_walkforward() is missing the required 'tickers' parameter. Please update the package.")
            if kwargs["rolling_retrain"] and "rolling_retrain" not in supported:
                raise RuntimeError(
                    "This build of simulate_walkforward() does not support rolling retraining. Update to the latest version to enable it."
                )
            call_kwargs = {k: v for k, v in kwargs.items() if k in supported}
            call_kwargs["tickers"] = tickers

            # Call simulate with the supported arguments only
            equity_df, blotter_df = simulate_walkforward(**call_kwargs)

            # Save outputs
            out_eq = self.out_eq_var.get()
            out_bl = self.out_bl_var.get()
            equity_df.to_csv(out_eq)
            blotter_df.to_csv(out_bl, index=False)

            # Plot equity
            self.ax.clear()
            self.ax.plot(equity_df.index, equity_df["equity"], label="Strategy")
            self.ax.set_title("Equity Curve (Walkforward)")
            self.ax.set_xlabel("Date")
            self.ax.set_ylabel("Equity ($)")
            self.ax.legend()
            self.canvas.draw_idle()

            messagebox.showinfo("Done", f"Saved equity to {out_eq} and blotter to {out_bl}")
        except Exception as e:
            messagebox.showerror("Walkforward Error", str(e))

