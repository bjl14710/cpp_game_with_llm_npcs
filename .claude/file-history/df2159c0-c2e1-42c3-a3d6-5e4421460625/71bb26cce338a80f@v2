#!/usr/bin/env python3
"""
build_index.py — (re)generate docs/learning/index.html

Scans docs/learning/lessons/*.html and docs/learning/drills/*.html, pairs a lesson
with a drill when their slug (the filename with the leading NNNN- stripped) matches,
and writes a single self-contained index.html as the home page.

Layout:
  - "Lessons" section: every lesson in numeric order. If a drill shares its slug, the
    row binds them (lesson link + drill link). If not, the row shows the lesson alone.
  - "Drills" section: only drills with NO matching lesson (lone drills).

Deterministic, no dependencies, safe to re-run. Usage:
    python3 build_index.py [path-to-docs/learning] [--title "My Pack"]
If no path is given it looks for ./docs/learning, then the folder this script sits in.
"""
import os, re, sys, html, glob

def find_root(arg):
    if arg and os.path.isdir(arg):
        return os.path.abspath(arg)
    for c in ("docs/learning", "."):
        if os.path.isdir(os.path.join(c, "lessons")) or os.path.isdir(os.path.join(c, "drills")):
            return os.path.abspath(c)
    here = os.path.dirname(os.path.abspath(__file__))
    # script may live in docs/learning/.tools/
    for up in (here, os.path.dirname(here)):
        if os.path.isdir(os.path.join(up, "lessons")) or os.path.isdir(os.path.join(up, "drills")):
            return up
    return os.path.abspath(arg or "docs/learning")

def parse(path):
    base = os.path.basename(path)
    m = re.match(r'^(\d+)[-_](.+)\.html$', base)
    if m:
        num, slug = int(m.group(1)), m.group(2)
    else:
        num, slug = 10**9, os.path.splitext(base)[0]
    try:
        s = open(path, encoding="utf-8", errors="ignore").read()
    except OSError:
        s = ""
    t = re.search(r'<title[^>]*>(.*?)</title>', s, re.S | re.I)
    title = html.unescape(t.group(1)).strip() if t else ""
    if not title:
        h = re.search(r'<h1[^>]*>(.*?)</h1>', s, re.S | re.I)
        title = html.unescape(re.sub(r'<[^>]+>', '', h.group(1))).strip() if h else ""
    # strip generator prefixes so a lesson and its drill display the same name
    title = re.sub(r'^\s*lesson\s*\d+\s*[·:\-–—]\s*', '', title, flags=re.I)
    title = re.sub(r'^\s*drill\s*\d*\s*[·:\-–—]\s*', '', title, flags=re.I)
    if not title:
        title = slug.replace('-', ' ').replace('_', ' ').title()
    return {"num": num, "slug": slug, "title": title, "file": base}

def collect(root, sub):
    items = [parse(p) for p in glob.glob(os.path.join(root, sub, "*.html"))]
    by = {}
    for it in sorted(items, key=lambda x: (x["num"], x["slug"])):
        by.setdefault(it["slug"], it)  # first file wins per slug
    return by

