def esc(x): return html.escape(x, quote=True)

def render(root, title):
    lessons = collect(root, "lessons")
    drills = collect(root, "drills")
    lesson_list = sorted(lessons.values(), key=lambda x: (x["num"], x["slug"]))
    paired_slugs = set()

    lesson_rows = []
    for L in lesson_list:
        d = drills.get(L["slug"])
        if d:
            paired_slugs.add(L["slug"])
            right = f'<a class="drill" href="drills/{esc(d["file"])}">drill ▸</a>'
        else:
            right = '<span class="none">no drill yet</span>'
        lesson_rows.append(
            f'<div class="row"><span class="num">L{L["num"]:02d}</span>'
            f'<a class="main" href="lessons/{esc(L["file"])}">{esc(L["title"])}</a>{right}</div>')

    lone_drills = [d for s, d in sorted(drills.items(), key=lambda kv: (kv[1]["num"], kv[0]))
                   if s not in paired_slugs]
    drill_rows = [
        f'<div class="row lone"><span class="num">D{d["num"]:02d}</span>'
        f'<a class="main" href="drills/{esc(d["file"])}">{esc(d["title"])}</a>'
        f'<span class="none">drill</span></div>' for d in lone_drills]

    npair = len(paired_slugs)
    parts = [f'<p class="eyebrow"><span class="dot"></span> Home</p>',
             f'<h1>{esc(title)}</h1>',
             '<p class="subtitle">Your lessons and drills in one place. Read a lesson, then run its drill to harden it. Everything is self-contained and runs offline.</p>',
             '<div class="bus"></div>']

    if lesson_rows:
        parts.append(f'<h2>Lessons <span class="count">{len(lesson_rows)} · {npair} with drills</span></h2>')
        parts.extend(lesson_rows)
    if drill_rows:
        parts.append(f'<h2>Drills <span class="count">{len(drill_rows)} without a matching lesson</span></h2>')
        parts.extend(drill_rows)
    if not lesson_rows and not drill_rows:
        parts.append('<p class="empty">No lessons or drills found yet. Create some with /teach and /drill-me, then re-run this.</p>')

    from datetime import date
    parts.append(f'<footer>Generated {date.today().isoformat()} · {len(lessons)} lessons · {len(drills)} drills · re-run to refresh</footer>')

    body = "\n".join(parts)
    return f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{esc(title)}</title><style>{CSS}</style></head>
<body><div class="wrap">{body}</div></body></html>"""

def derive_title(root):
    for name in ("PROGRESS.md", "README.md"):
        p = os.path.join(root, name)
        if os.path.isfile(p):
            for line in open(p, encoding="utf-8", errors="ignore"):
                m = re.match(r'#\s+(.+?)\s*$', line.strip())
                if m:
                    return re.sub(r'\s*[—\-–·].*$', '', m.group(1)).strip() or "Learning Pack"
    return "Learning Pack"

def main(argv):
    path_arg, title = None, None
    i = 0
    while i < len(argv):
        if argv[i] == "--title" and i + 1 < len(argv):
            title = argv[i + 1]; i += 2
        else:
            path_arg = argv[i]; i += 1
    root = find_root(path_arg)
    if title is None:
        title = derive_title(root)
    out = os.path.join(root, "index.html")
    open(out, "w", encoding="utf-8").write(render(root, title))
    nl = len(collect(root, "lessons")); nd = len(collect(root, "drills"))
    print(f"Wrote {out}")
    print(f"  {nl} lessons, {nd} drills  ·  title: {title!r}")
    return out

if __name__ == "__main__":
    main(sys.argv[1:])
