def retry(fn, what):
    for attempt in range(4):
        try:
            return fn()
        except GithubException as e:
            print(f"{what} attempt {attempt+1}: {e.status}")
            time.sleep(5)
    raise SystemExit(f"gave up: {what}")


milestone = None
for m in repo.get_milestones(state="open"):
    if m.title.startswith("World time"):
        milestone = m
        break
if milestone is None:
    milestone = retry(lambda: repo.create_milestone(
        title="World time: shared clock, schedules, day/night",
        description=("One authoritative world clock in a generic shared-fact "
                     "store (the bus gossip/journal will reuse), NPC "
                     "schedules, and a day/night visual cycle. Plan: "
                     ".claude/plans/world-time-and-schedules.md")), "milestone")
print(f"milestone #{milestone.number}: {milestone.title}")

existing = {i.title.lower() for i in repo.get_issues(state="all") if not i.pull_request}
for spec in SPECS:
    if spec["title"].lower() in existing:
        print(f"exists: {spec['title']}")
        continue
    issue = retry(lambda: repo.create_issue(
        title=spec["title"], body=TEMPLATE.format(**spec),
        labels=["ai-in-progress"], assignees=[USERNAME], milestone=milestone),
        spec["title"])
    print(f"created #{issue.number}: {spec['title']}")
