"""Create milestone + 4 issues for the shared-character-library plan."""
import os, subprocess, re, time
from github import Github

token = os.environ.get("GH_TOKEN") or os.environ.get("TOKEN")
full = re.search(r"[:/]([^/]+/[^/]+?)(?:\.git)?$",
                 subprocess.check_output(["git", "remote", "get-url", "origin"], text=True).strip()).group(1)
gh = Github(token)
repo = gh.get_repo(full)
username = gh.get_user().login

def retry(fn, *a, **k):
    for i in range(5):
        try:
            return fn(*a, **k)
        except Exception as e:
            if i == 4: raise
            print(f"  transient ({type(e).__name__}), retry..."); time.sleep(3 + i * 2)

milestone = retry(repo.create_milestone,
    title="Shared character library",
    description=("Unify NPCs and the creator onto the one composite CharacterParts "
                 "pool, then expand hairstyles inside it. Plan: "
                 ".claude/plans/shared-character-library.md. Branch: "
                 "feature/shared-character-library (stacked on feature/aim-styles-preview)."))
print(f"Milestone #{milestone.number}: {milestone.title}")

TEMPLATE = """## What to change
{what}

## Where it is
{where}

## How to verify it's done
{verify}

## Constraints
{constraints}

## Code economy note
{economy}

## Branch name
`feature/shared-character-library` (one atomic commit per issue, stacked on `feature/aim-styles-preview`)

## Concept for learning materials
{concept}
"""

SPECS = [
    dict(
        title="feat(persona): optional authored look with deterministic fallback",
        what=("Add an optional `look = body, head, eyes, hair, palette` header key to the "
              ".persona format: parsed into LoadedPersona, round-tripped by renderPersonaText. "
              "Add `lookForPersona(name, authored)` to CharacterParts: returns the authored look "
              "when valid, otherwise a deterministic randomizeLook(hash(name)) so every persona "
              "(and any future procedural NPC) gets a stable, valid, style-consistent look with "
              "zero manual gaps. An authored look naming an unknown part/palette is rejected with "
              "a reason and falls back — the NPC still spawns."),
        where=("src/core/PersonaLoader.{hpp,cpp} (parse + render), "
               "src/core/CharacterParts.{hpp,cpp} (lookForPersona), "
               "new tests/test_persona_look.cpp"),
        verify=("tests/test_persona_look.cpp: look line parses and round-trips; malformed look "
                "(wrong item count) is a parse error like a bad position; authored-valid wins; "
                "authored-invalid falls back with a reason; no-look personas get deterministic, "
                "valid looks stable across calls. make -C tests test green."),
        constraints=("PersonaLoader stays free of catalog VALIDATION (structural parse only); "
                     "validation lives in lookForPersona so the catalogs stay in CharacterParts. "
                     "Round-trip guarantee of renderPersonaText must hold."),
        economy=("Follow the existing header-key pattern (position/schedule) exactly; one new "
                 "helper in CharacterParts, one new test file, no new abstractions."),
        concept="authored data with a deterministic derived fallback",
    ),
    dict(
        title="feat(npc): render every NPC from the shared composite parts library",
        what=("Every roaming NPC gets a CharacterLook (authored-or-fallback via lookForPersona; "
              "player-created characters keep their stored look) and renders through "
              "drawCompositeCharacter — the rigged drawCharacter path is no longer dispatched "
              "for NPCs (its loading stays dormant; remote players still use it, out of scope). "
              "Extend drawCompositeCharacter so composite NPCs keep mood-face billboards and a "
              "readable death pose."),
        where=("src/app/main.cpp NPC render loop (~970-995) + startup look assignment; "
               "src/app/RaylibRenderer.{hpp,cpp} drawCompositeCharacter signature"),
        verify=("Smoke run + screenshot: all ten townsfolk render as composites (no rigged "
