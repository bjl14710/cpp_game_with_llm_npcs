"""Draft PR for the worldgen milestone; close #125-#129.
Reads the bench table from bench/out/schema_results.json."""
import json, os, pathlib, subprocess, re, time
from github import Github

token = os.environ.get("GH_TOKEN") or os.environ.get("TOKEN")
full = re.search(r"[:/]([^/]+/[^/]+?)(?:\.git)?$",
                 subprocess.check_output(["git", "remote", "get-url", "origin"], text=True).strip()).group(1)
repo = Github(token).get_repo(full)

def retry(fn, *a, **k):
    for i in range(5):
        try:
            return fn(*a, **k)
        except Exception as e:
            if i == 4: raise
            print(f"  transient ({type(e).__name__}), retry..."); time.sleep(3 + i * 2)

results = json.loads(pathlib.Path("bench/out/schema_results.json").read_text())
table = "| model | valid | first-try | mean s |\n|---|---|---|---|\n"
winner, best = None, -1.0
for model, r in sorted(results.items(), key=lambda kv: -kv[1]["validity_rate"]):
    table += (f"| {model} | {r['validity_rate']:.0%} | "
              f"{r['first_attempt_rate']:.0%} | {r['mean_seconds']:.1f} |\n")
    if r["validity_rate"] > best:
        winner, best = model, r["validity_rate"]

BODY = f"""## Summary
