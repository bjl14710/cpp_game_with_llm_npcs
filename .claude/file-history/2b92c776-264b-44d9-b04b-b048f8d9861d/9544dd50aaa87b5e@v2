// Criterion: lookDirection(yaw, 0) reproduces the horizontal forward
// (sin yaw, 0, cos yaw) — i.e. it stays byte-compatible with the movement
// helper flatForward() at zero pitch, so aim and movement never disagree
// horizontally.
TEST_CASE("lookDirection matches the horizontal forward at zero pitch" *
          doctest::skip()) {
    // TODO(aim): for several yaws, assert lookDirection(yaw,0) ==
    // normalize({sin(yaw),0,cos(yaw)}) within a small epsilon.
    CHECK(true);
}

// Criterion: the yaw/pitch convention matches the camera basis in
// RaylibRenderer::beginFrame: yaw 0 -> +Z, yaw 90 -> +X, pitch up -> +Y.
TEST_CASE("lookDirection yaw/pitch convention" * doctest::skip()) {
    // TODO(aim): CHECK lookDirection(0,0) ~ (0,0,1); lookDirection(90,0) ~
    // (1,0,0); lookDirection(0,+45).y > 0; lookDirection(0,-45).y < 0.
    CHECK(true);
}

// Criterion: pitch reaches the projectile. A pitched-down shot spawns a
