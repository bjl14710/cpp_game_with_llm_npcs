#!/usr/bin/env python3
"""Retarget PR #60 to main now that its base branch merged via #58."""
import os
import time

from github import Github, GithubException

gh = Github(os.environ["GH_TOKEN"])
repo = gh.get_repo("bjl14710/cpp_game_with_llm_npcs")

for attempt in range(4):
    try:
        pr = repo.get_pull(60)
        if pr.base.ref != "main":
            pr.edit(base="main")
            print(f"PR #60 base: {pr.base.ref} -> main")
        else:
            print("PR #60 already targets main")
        break
    except GithubException as e:
        print(f"attempt {attempt+1}: {e.status}")
        time.sleep(5)
