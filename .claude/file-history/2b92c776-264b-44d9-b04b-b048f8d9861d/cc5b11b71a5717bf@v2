gh = Github(token)
repo = gh.get_repo(full)
username = gh.get_user().login

def retry(fn, *a, **k):
    for i in range(5):
        try:
            return fn(*a, **k)
        except Exception as e:
            if i == 4: raise
            print(f"  transient ({type(e).__name__}), retry..."); time.sleep(3 + i * 2)

existing_titles = {i.title.lower() for i in retry(repo.get_issues, state="open")}

