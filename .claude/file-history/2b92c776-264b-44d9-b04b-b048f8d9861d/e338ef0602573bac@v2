def retry(fn, what):
    for attempt in range(4):
        try:
            return fn()
        except GithubException as e:
            print(f"{what} attempt {attempt+1}: {e.status}")
            time.sleep(5)
    raise SystemExit(f"gave up: {what}")


milestone = None
for m in repo.get_milestones(state="open"):
    if m.title.startswith("City polish"):
        milestone = m
        break
if milestone is None:
    milestone = retry(lambda: repo.create_milestone(
        title="City polish: aesthetic fixes",
        description=("Deferred visual polish from the raylib migration: a real "
                     "fountain, road tiles with markings, parked cars and props "
                     "with colliders, and a fog/tint atmosphere pass. All items "
                     "follow the size-contract and authored-collider rules.")),
        "milestone")
print(f"milestone #{milestone.number}: {milestone.title}")

existing = {i.title.lower() for i in repo.get_issues(state="all") if not i.pull_request}
created = []
for spec in SPECS:
    if spec["title"].lower() in existing:
        print(f"exists: {spec['title']}")
        continue
    body = TEMPLATE.format(**{k: spec[k] for k in
                              ("what", "where", "verify", "constraints",
                               "economy_note", "slug", "concept")})
    issue = retry(lambda: repo.create_issue(
        title=spec["title"], body=body, labels=["ready-for-ai"],
        assignees=[USERNAME], milestone=milestone), spec["title"])
    retry(lambda: issue.edit(body=body.replace("feature/issue-N-",
                                               f"feature/issue-{issue.number}-")),
          f"edit #{issue.number}")
    created.append((issue.number, spec["title"], spec["concept"], issue.html_url))
    print(f"created #{issue.number}: {spec['title']}")

print("\n=== ready-for-ai queue ===")
