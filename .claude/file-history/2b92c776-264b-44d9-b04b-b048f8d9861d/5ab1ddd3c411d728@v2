def retry(fn, *a, **k):
    """GitHub WAF sometimes throws transient 400s; retry a few times."""
    for attempt in range(5):
        try:
            return fn(*a, **k)
        except Exception as e:
            if attempt == 4:
                raise
            print(f"    transient error ({type(e).__name__}), retrying...")
            time.sleep(3 + attempt * 2)

