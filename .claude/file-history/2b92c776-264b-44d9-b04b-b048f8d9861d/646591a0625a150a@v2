pr = retry(repo.create_pull,
           title="feat: Mii-style visual overhaul — proportions, outlines, mouths, packs seam, player avatar (#101-#107)",
           body=BODY, base="feature/punch-and-jump",
           head="feature/mii-style-visual-overhaul", draft=True)
print(f"DRAFT PR #{pr.number}: {pr.html_url}")

for n in range(101, 108):
    issue = retry(repo.get_issue, n)
    labels = [l.name for l in issue.labels if l.name not in ("ready-for-ai", "ai-in-progress")]
    if "ai-completed" not in labels:
        labels.append("ai-completed")
    retry(issue.edit, labels=labels)
    retry(issue.create_comment,
          f"Implemented on `feature/mii-style-visual-overhaul`. Draft PR #{pr.number} open for review (stacked on feature/punch-and-jump). Not merged.")
