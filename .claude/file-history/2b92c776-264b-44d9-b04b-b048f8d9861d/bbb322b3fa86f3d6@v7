cmake_minimum_required(VERSION 3.20)
project(cpp_game_with_llm_npcs LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

find_package(Threads REQUIRED)
# Game executable needs SFML+OpenGL; QUIET so the dev container can still
# configure CMake and build the core library + tests without them.
find_package(SFML 2.6 COMPONENTS graphics window system QUIET)
find_package(OpenGL QUIET)

# Core: SFML-free game logic shared with the unit tests.
add_library(llm_npc_core STATIC
    src/core/City.cpp
    src/core/Combat.cpp
    src/core/Config.cpp
    src/core/DialogueSession.cpp
    src/core/KeyBindings.cpp
    src/core/LlmBackend.cpp
    src/core/LlmClient.cpp
    src/core/Npc.cpp
    src/core/Offense.cpp
    src/core/OllamaBackend.cpp
    src/core/OpenAiBackend.cpp
    src/core/PersonaFactory.cpp
    src/core/PersonaLoader.cpp
    src/core/PlayerState.cpp
    src/core/Traffic.cpp
    src/core/World.cpp
)
target_include_directories(llm_npc_core PUBLIC
    ${CMAKE_CURRENT_SOURCE_DIR}/src/core
    ${CMAKE_CURRENT_SOURCE_DIR}/external
)
target_link_libraries(llm_npc_core PUBLIC Threads::Threads)
if(WIN32)
    # httplib needs winsock when built with MinGW.
    target_link_libraries(llm_npc_core PUBLIC ws2_32)
endif()

# Optional: OpenSSL lets httplib speak HTTPS, which enables the cloud LLM
# providers (OpenRouter/OpenAI/Gemini). It is never required — without it the
# game builds exactly as before and talks to local Ollama only.
#
# PRIVATE on purpose: httplib is an implementation detail sealed inside the core
# .cpp files, so consumers never need OpenSSL's headers. Keeping the include dir
# private also stops Homebrew's prefix (/opt/homebrew/include, where a parallel
# SFML 3 lives) from shadowing the keg-only sfml@2 headers in the game target.
# A STATIC library still forwards private link deps to the final executable, so
# the SSL symbols still resolve.
find_package(OpenSSL QUIET)
if(OPENSSL_FOUND)
    target_compile_definitions(llm_npc_core PRIVATE CPPHTTPLIB_OPENSSL_SUPPORT)
    target_link_libraries(llm_npc_core PRIVATE OpenSSL::SSL OpenSSL::Crypto)
    message(STATUS "OpenSSL found; cloud LLM providers (HTTPS) enabled")
else()
    message(STATUS "OpenSSL not found; cloud LLM providers disabled (local Ollama only)")
endif()

if(SFML_FOUND AND OPENGL_FOUND)
    add_executable(cpp_game_with_llm_npcs
        src/app/main.cpp
        src/app/DialogUI.cpp
        src/app/InputMap.cpp
        src/app/Menu.cpp
        src/app/Renderer3D.cpp
    )
    target_include_directories(cpp_game_with_llm_npcs PRIVATE
        ${CMAKE_CURRENT_SOURCE_DIR}/src
        ${CMAKE_CURRENT_SOURCE_DIR}/src/app
    )
    target_link_libraries(cpp_game_with_llm_npcs
        PRIVATE
            llm_npc_core
            sfml-graphics
            sfml-window
            sfml-system
            OpenGL::GL
    )
    if(APPLE)
        # Mouse-look uses CoreGraphics cursor warping directly; see main.cpp.
        target_link_libraries(cpp_game_with_llm_npcs PRIVATE
            "-framework ApplicationServices")
    endif()
else()
    message(STATUS "SFML or OpenGL not found; building core library only "
                   "(use tests/Makefile for the test suite)")
endif()
