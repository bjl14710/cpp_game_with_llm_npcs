<script>
// ---- Quiz: shuffle options, score by attribute (never by position) ----
function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
let score = 0;
const answered = new Set();
const scoreEl = document.getElementById('score');
const questions = [...document.querySelectorAll('[data-question]')];
questions.forEach((q, qi) => {
  const list = q.querySelector('.options');
  shuffle([...list.children]).forEach(li => list.appendChild(li));  // randomize DOM order on load
  const fb = q.querySelector('.feedback');
  list.querySelectorAll('li').forEach(li => {
    // pre-build per-option explanation line
    const why = document.createElement('span');
    why.className = 'why2';
    why.textContent = li.dataset.why;
    li.appendChild(why);
    li.addEventListener('click', () => {
      if (answered.has(qi)) return;                 // lock after first answer
      answered.add(qi);
      const correct = li.dataset.correct === 'true';  // <-- correctness is the attribute, not the position
      li.classList.add(correct ? 'pick-ok' : 'pick-no');
      list.querySelectorAll('li').forEach(o => {
        o.querySelector('.why2').style.display = 'block';
        if (o.dataset.correct === 'true') o.classList.add('reveal-ok');
      });
      fb.hidden = false;
      fb.textContent = correct ? '✓ Correct.' : '✗ Not quite — the right answer is highlighted.';
      fb.style.color = correct ? 'var(--good)' : 'var(--bad)';
      if (correct) score++;
      scoreEl.textContent = `Score: ${score} / ${questions.length}`;
      if (answered.size === questions.length) {
        scoreEl.textContent += score === questions.length ? '  — perfect run! ✦' : '  — review the highlighted answers.';
      }
      updateProgress();
    });
  });
});

// ---- Reveal buttons for scenarios ----
document.querySelectorAll('[data-reveal]').forEach(btn => {
  btn.addEventListener('click', () => {
    const ans = btn.nextElementSibling;
    const open = ans.style.display === 'block';
    ans.style.display = open ? 'none' : 'block';
    btn.textContent = open ? 'Show answer' : 'Hide answer';
    updateProgress();
  });
});

// ---- Progress rail: sections marked done + quiz completion ----
const checks = [...document.querySelectorAll('[data-done]')];
const fill = document.getElementById('barFill');
const pct = document.getElementById('barPct');
function updateProgress(){
  const total = checks.length + 1;                 // +1 for finishing the quiz
  let got = checks.filter(c => c.checked).length;
  if (answered.size === questions.length) got += 1;
  const p = Math.round(100 * got / total);
  fill.style.width = p + '%';
  pct.textContent = p + '%';
}
checks.forEach(c => c.addEventListener('change', updateProgress));
updateProgress();
</script>
</body>
