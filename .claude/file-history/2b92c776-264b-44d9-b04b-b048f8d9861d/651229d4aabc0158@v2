  ul.options li .why{display:block;margin-top:7px;font-size:.82rem;color:var(--dim);font-family:var(--sans)}
  textarea{width:100%;min-height:120px;background:#0a0e14;color:var(--ink);border:1px solid var(--line);
    border-radius:8px;padding:12px;font-family:var(--mono);font-size:.86rem;resize:vertical}
  .btn{font-family:var(--mono);font-size:.82rem;border:1px solid var(--line);background:var(--panel2);
    color:var(--ink);padding:8px 14px;border-radius:8px;cursor:pointer;transition:.12s}
  .btn:hover{border-color:var(--accent);color:#fff}
