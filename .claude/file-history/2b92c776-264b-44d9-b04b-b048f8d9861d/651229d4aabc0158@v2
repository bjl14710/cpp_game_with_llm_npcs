  .chips{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0 4px}
  .toggle{display:flex;align-items:center;gap:8px;font-family:var(--mono);font-size:.82rem;color:var(--dim);margin-top:14px;cursor:pointer}
  .note{font-size:.8rem;color:var(--dim);font-style:italic;margin-top:16px}
  .big{font-size:2.2rem;font-family:var(--mono);color:var(--accent2)}
  .stat{font-family:var(--mono);margin:6px 0}
  a{color:var(--accent)}
  .hidden{display:none}
