  .btnrow{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
  .spacer{flex:1}
  .feedback{margin-top:12px;font-family:var(--mono);font-size:.82rem}
  .check{margin-top:14px;border-top:1px dashed var(--line);padding-top:12px}
  .concept{font-family:var(--mono);font-size:.82rem;padding:3px 0}
