def retry(fn, what):
    for attempt in range(4):
        try:
            return fn()
        except GithubException as e:
            print(f"{what} attempt {attempt+1}: {e.status}")
            time.sleep(5)
    raise SystemExit(f"gave up: {what}")


def ensure_milestone(prefix, title, description):
    for m in repo.get_milestones(state="open"):
        if m.title.startswith(prefix):
            return m
    return retry(lambda: repo.create_milestone(title=title, description=description),
                 f"milestone {title}")


existing = {i.title.lower() for i in repo.get_issues(state="all") if not i.pull_request}
for specs, milestone in (
    (GOSSIP, ensure_milestone("Gossip", "Gossip: facts on the world bus",
                              "Plan: .claude/plans/gossip-facts.md")),
    (JOURNAL, ensure_milestone("Journal", "Journal: player-facing fact reader",
                               "Plan: .claude/plans/player-journal.md")),
):
    print(f"milestone #{milestone.number}: {milestone.title}")
    for spec in specs:
        if spec["title"].lower() in existing:
            print(f"exists: {spec['title']}")
