created_all = []
for m in MILESTONES:
    milestone = retry(repo.create_milestone, title=m["title"], description=m["description"])
    print(f"Milestone #{milestone.number}: {m['title']}")
    for spec in m["specs"]:
        if spec["title"].lower() in existing_titles:
            print(f"  Skipping (exists): {spec['title']}")
            continue
        body = TEMPLATE.format(branch=m["branch"], **{k: spec[k] for k in
                               ("what", "where", "verify", "constraints", "economy", "concept")})
        issue = retry(repo.create_issue, title=spec["title"], body=body,
                      labels=["ready-for-ai"], assignees=[username], milestone=milestone)
        created_all.append((issue.number, m["title"], spec["title"], spec["concept"]))
        print(f"  #{issue.number}: {spec['title']}")

print(f"\nTOTAL: {len(created_all)} issues across 4 milestones")
