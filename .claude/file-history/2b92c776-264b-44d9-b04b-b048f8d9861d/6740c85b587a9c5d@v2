#!/usr/bin/env python3
import os
import time

from github import Github, GithubException

gh = Github(os.environ["GH_TOKEN"])
repo = gh.get_repo("bjl14710/cpp_game_with_llm_npcs")

body = (
    "The six procedural mood faces bake into 128px textures at startup (geometry "
    "ported 1:1 from the legacy drawFace, including the commit-6298566 brow-tilt "
    "direction) and float as billboard emotes above characters whose mood isn't "
    "Neutral.\n\n"
    "**Fallback decision (documented in the plan):** the KayKit character glbs use "
    "ONE shared atlas material — per-mood head-texture swaps would repaint the whole "
    "body, so the emote billboard is the v1 mechanism. It also reads better at "
    "street distance.\n\n"
    "**Verified:** screenshot shows emote bubbles with distinct features above three "
    "NPCs; suite green (96 on this branch).\n\n"
    "**Side-by-side note for #42:** compare these six faces against the legacy "
    "renderer before deleting Renderer3D (that PR is gated on this check).\n\n"
    "**Stack position:** bases on #48. Merge in order.\n\n"
    "Closes #39\n\n---\n\U0001F916 Generated with [Claude Code](https://claude.com/claude-code)"
)

for attempt in range(3):
    try:
        pr = repo.create_pull(
            title="feat(render): mood emotes above character heads",
            body=body, head="feature/issue-39-raylib-mood-faces",
            base="feature/issue-38-raylib-characters", draft=True)
        print(f"PR #{pr.number}: {pr.html_url}")
        break
    except GithubException as e:
        print(f"attempt {attempt+1}: {e.status}")
        time.sleep(5)

issue = repo.get_issue(39)
issue.remove_from_labels("ready-for-ai")
issue.add_to_labels("ai-completed")
issue.create_comment(f"Implemented. Draft PR: #{pr.number} — closes on merge.")
print("issue 39 ai-completed")
