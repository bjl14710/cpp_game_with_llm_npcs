created = []
for spec in SPECS:
    if spec["title"].lower() in existing_titles:
        print(f"  Skipping (exists): {spec['title']}")
        continue
    body = TEMPLATE.format(**{k: spec[k] for k in
                              ("what", "where", "verify", "constraints", "economy", "concept")})
    issue = retry(repo.create_issue, title=spec["title"], body=body,
                  labels=["ready-for-ai"], assignees=[username], milestone=milestone)
    created.append(issue.number)
    print(f"  #{issue.number}: {spec['title']}")
print("ISSUES:", created)
