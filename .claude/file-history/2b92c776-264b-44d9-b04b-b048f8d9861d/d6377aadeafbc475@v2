"""Milestone + 7 issues for stylized-character-assets."""
import os, subprocess, re, time
from github import Github

token = os.environ.get("GH_TOKEN") or os.environ.get("TOKEN")
full = re.search(r"[:/]([^/]+/[^/]+?)(?:\.git)?$",
                 subprocess.check_output(["git", "remote", "get-url", "origin"], text=True).strip()).group(1)
gh = Github(token)
repo = gh.get_repo(full)
username = gh.get_user().login

def retry(fn, *a, **k):
    for i in range(5):
        try:
            return fn(*a, **k)
        except Exception as e:
            if i == 4: raise
            print(f"  transient ({type(e).__name__}), retry..."); time.sleep(3 + i * 2)

existing_titles = {i.title.lower() for i in retry(repo.get_issues, state="open")}

milestone = retry(repo.create_milestone,
    title="Stylized character assets — one committed cartoon style",
    description=("Quaternius CC0 modular character meshes through the existing socket/"
                 "size/pack systems, banded cel shader + mesh outlines, flat texture "
                 "faces, unified rollout across NPCs/creator/avatar. PREMISE NOTE: the "
                 "engine is RAYLIB (not Godot as the originating brief assumed) — see "
                 ".claude/plans/stylized-character-assets.md and .claude/skills/"
                 "stylized-characters/SKILL.md (READ FIRST). Branch "
                 "feature/stylized-characters (scaffolded, off dev)."))
print(f"Milestone #{milestone.number}")

SHARED = ("READ .claude/skills/stylized-characters/SKILL.md FIRST — engine correction "
          "(raylib, NOT Godot), Tier A/B animation policy, socket/contract rules, "
          "provenance rules. Un-skip the matching stub in tests/test_stylized_parts.cpp "
          "in the same commit. Style commitment beats fidelity, always.")

