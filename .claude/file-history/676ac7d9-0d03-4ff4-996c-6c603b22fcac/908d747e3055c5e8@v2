def sh(*args: str) -> str:
    """Run a command in the repo root and return stdout, failing loudly."""
    r = subprocess.run(args, cwd=REPO, capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"FAILED: {' '.join(args)}\n{r.stderr}")
    return r.stdout.strip()


def lesson_title(path: str) -> str:
    """Extract the <title> text from a lesson HTML file."""
    with open(path) as f:
        m = re.search(r"<title>(.*?)</title>", f.read(), re.S)
    return m.group(1).strip() if m else path.rsplit("/", 1)[-1]


