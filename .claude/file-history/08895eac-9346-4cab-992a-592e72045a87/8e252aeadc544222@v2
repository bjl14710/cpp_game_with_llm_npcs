<script>
  // ---- shuffled, position-independent quiz ----
  function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
  const answeredSet = new Set();
  let correctCount = 0;
  const scoreEl = document.getElementById('score');
  const answeredEl = document.getElementById('answered');
  document.getElementById('qtotal').textContent = document.querySelectorAll('[data-question]').length;

  document.querySelectorAll('[data-question]').forEach((q, qi) => {
    const list = q.querySelector('.options');
    shuffle([...list.children]).forEach(li => list.appendChild(li));  // randomize DOM order on load
    const fb = q.querySelector('.feedback');
    list.querySelectorAll('li').forEach(li => {
      li.addEventListener('click', () => {
        const correct = li.dataset.correct === 'true';                // attribute, never position
        list.querySelectorAll('li').forEach(o => o.classList.remove('picked','correct','wrong'));
        li.classList.add('picked', correct ? 'correct' : 'wrong');
        if (correct) list.querySelectorAll('li').forEach(o => { if(o.dataset.correct==='true') o.classList.add('correct'); });
        fb.hidden = false;
        fb.innerHTML = (correct ? '✓ Correct. ' : '✗ Not quite. ') + li.dataset.why;
        fb.style.color = correct ? 'var(--green)' : 'var(--red)';
        // score each question once, by its first attempt
        if (!answeredSet.has(qi)) {
          answeredSet.add(qi);
          if (correct) correctCount++;
          scoreEl.textContent = correctCount;
          answeredEl.textContent = answeredSet.size + ' attempted';
        }
      });
    });
  });

  // ---- lightweight per-section "mark read" ----
  document.querySelectorAll('[data-mark]').forEach(btn => {
    btn.addEventListener('click', () => {
      const done = btn.classList.toggle('done');
      btn.textContent = (done ? '✓ read' : '◻ mark section read');
    });
  });
</script>
