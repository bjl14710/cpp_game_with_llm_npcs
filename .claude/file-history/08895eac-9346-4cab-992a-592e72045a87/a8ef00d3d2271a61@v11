// ReplayClock tests. One case per acceptance criterion in
// .claude/plans/itch-replay-clock.md.

#include <gtest/gtest.h>
#include "../itch/replay_clock.hpp"

#include <chrono>
#include <cstdint>
#include <vector>

namespace {

void put_be16(std::vector<uint8_t>& b, uint16_t v) {
    b.push_back(static_cast<uint8_t>(v >> 8));
    b.push_back(static_cast<uint8_t>(v & 0xFF));
}

// Append a framed ITCH-shaped message: 2-byte BE length + a body of body_len
// bytes carrying `ts` as 6 big-endian bytes at offset 5 (the real layout).
// The remaining bytes are a deterministic pattern so byte-identity is
// meaningful. body_len must be >= 11 to hold a timestamp.
void append_msg(std::vector<uint8_t>& buf, uint16_t body_len, uint64_t ts,
                uint8_t type = 'A') {
    put_be16(buf, body_len);
    const std::size_t start = buf.size();
    buf.resize(start + body_len, 0);
    buf[start] = type;
    for (int i = 0; i < 6; ++i)
        buf[start + 5 + i] = static_cast<uint8_t>((ts >> (8 * (5 - i))) & 0xFF);
    for (uint16_t i = 11; i < body_len; ++i)
        buf[start + i] = static_cast<uint8_t>(i);
}

// A sink that records each delivery as len(2) + ts(8) + bytes, so two runs
// are byte-identical iff they delivered the same sequence.
itch::MessageSink recorder(std::vector<uint8_t>& out) {
    return [&out](const uint8_t* msg, uint16_t len, uint64_t ts) {
        out.push_back(static_cast<uint8_t>(len >> 8));
        out.push_back(static_cast<uint8_t>(len & 0xFF));
        for (int i = 7; i >= 0; --i)
            out.push_back(static_cast<uint8_t>((ts >> (8 * i)) & 0xFF));
        out.insert(out.end(), msg, msg + len);
    };
}

std::vector<uint8_t> four_message_buffer() {
    std::vector<uint8_t> buf;
    append_msg(buf, 12, 0);
    append_msg(buf, 20, 1000, 'E');
    append_msg(buf, 12, 2000);
    append_msg(buf, 36, 3000, 'U');
    return buf;
}

}  // namespace

TEST(ReplayClock, AllModesDeliverByteIdenticalSequences) {
    const std::vector<uint8_t> buf = four_message_buffer();

    std::vector<uint8_t> r_max, r_wall, r_step;
    itch::ReplayClock c_max(buf);
    c_max.run(recorder(r_max), itch::ReplayMode::MaxSpeed);
    itch::ReplayClock c_wall(buf);
    c_wall.run(recorder(r_wall), itch::ReplayMode::WallClock, 1e6);  // fast
    itch::ReplayClock c_step(buf);
    {
        itch::MessageSink s = recorder(r_step);
        while (c_step.step(s)) { /* one per call */ }
    }

    EXPECT_EQ(r_max, r_wall);
    EXPECT_EQ(r_max, r_step);

    // ReplayStats counts identical across modes.
    EXPECT_EQ(c_max.stats().messages_delivered, 4u);
    EXPECT_EQ(c_max.stats().messages_delivered, c_wall.stats().messages_delivered);
    EXPECT_EQ(c_max.stats().messages_delivered, c_step.stats().messages_delivered);
    EXPECT_EQ(c_max.stats().bytes_delivered, c_wall.stats().bytes_delivered);
    EXPECT_EQ(c_max.stats().first_timestamp_ns, 0u);
    EXPECT_EQ(c_max.stats().last_timestamp_ns, 3000u);
}

TEST(ReplayClock, SingleStepDeliversExactlyOneMessagePerStep) {
    const std::vector<uint8_t> buf = four_message_buffer();
    itch::ReplayClock clock(buf);

    int delivered = 0;
    itch::MessageSink sink = [&delivered](const uint8_t*, uint16_t, uint64_t) {
        ++delivered;
    };
    for (int i = 0; i < 4; ++i) {
        EXPECT_TRUE(clock.step(sink));
        EXPECT_EQ(delivered, i + 1);  // exactly one more per step
    }
    EXPECT_FALSE(clock.step(sink));   // exhausted
    EXPECT_EQ(delivered, 4);
}

TEST(ReplayClock, WallClockPacingRespectsScaledSpanLooseBounds) {
    // 10 messages spaced 10 ms apart in ITCH time.
    std::vector<uint8_t> buf;
    for (uint64_t i = 0; i < 10; ++i)
        append_msg(buf, 12, i * 10'000'000ULL);  // 10 ms steps, ns

    itch::MessageSink noop = [](const uint8_t*, uint16_t, uint64_t) {};

    auto elapsed_ms = [](auto fn) {
        const auto t0 = std::chrono::steady_clock::now();
        fn();
        return std::chrono::duration<double, std::milli>(
                   std::chrono::steady_clock::now() - t0)
            .count();
    };

    itch::ReplayClock wall(buf);
    const double wall_ms = elapsed_ms(
        [&] { wall.run(noop, itch::ReplayMode::WallClock, 1.0); });
    itch::ReplayClock fast(buf);
    const double max_ms = elapsed_ms(
        [&] { fast.run(noop, itch::ReplayMode::MaxSpeed); });

    // Span is 90 ms at 1x; loose lower bound so CI never flakes.
    EXPECT_GE(wall_ms, 80.0);
    EXPECT_LT(max_ms, 20.0);
}

TEST(ReplayClock, PaddingSkippedTruncationStopsCleanly) {
    std::vector<uint8_t> buf;
    append_msg(buf, 12, 100);         // real message #1
    put_be16(buf, 0);                 // zero-length padding frame
    append_msg(buf, 12, 200);         // real message #2
    put_be16(buf, 50);                // declares 50 bytes...
    buf.resize(buf.size() + 10, 0xAB);  // ...but only 10 present (truncated)

    itch::ReplayClock clock(buf);
    int delivered = 0;
    itch::MessageSink sink = [&delivered](const uint8_t*, uint16_t, uint64_t) {
        ++delivered;
    };
    clock.run(sink, itch::ReplayMode::MaxSpeed);

    EXPECT_EQ(delivered, 2);
    EXPECT_EQ(clock.stats().messages_delivered, 2u);
    EXPECT_EQ(clock.stats().zero_len_frames_skipped, 1u);
    EXPECT_EQ(clock.stats().last_timestamp_ns, 200u);  // truncated frame not delivered
}

TEST(ReplayClock, EmptyBufferDeliversNothing) {
    itch::ReplayClock clock(std::vector<uint8_t>{});
    int delivered = 0;
    clock.run([&](const uint8_t*, uint16_t, uint64_t) { ++delivered; },
              itch::ReplayMode::MaxSpeed);
    EXPECT_EQ(delivered, 0);
    EXPECT_EQ(clock.stats().messages_delivered, 0u);
}

TEST(ReplayClock, ShortMessageDeliveredWithZeroTimestamp) {
    // A body shorter than 11 bytes cannot carry a timestamp; it is delivered
    // with ts 0 and the clock never over-reads to find one.
    std::vector<uint8_t> buf;
    put_be16(buf, 6);                  // 6-byte body, no room for a timestamp
    for (int i = 0; i < 6; ++i) buf.push_back(static_cast<uint8_t>('D'));

    itch::ReplayClock clock(buf);
    uint64_t seen_ts = 999;
    uint16_t seen_len = 0;
    clock.run(
        [&](const uint8_t*, uint16_t len, uint64_t ts) { seen_ts = ts; seen_len = len; },
        itch::ReplayMode::MaxSpeed);
    EXPECT_EQ(seen_len, 6u);
    EXPECT_EQ(seen_ts, 0u);
}

TEST(ReplayClock, NonPositiveSpeedThrows) {
    itch::ReplayClock clock(std::vector<uint8_t>{});
    EXPECT_THROW(clock.run([](const uint8_t*, uint16_t, uint64_t) {},
                           itch::ReplayMode::WallClock, 0.0),
                 std::invalid_argument);
}
