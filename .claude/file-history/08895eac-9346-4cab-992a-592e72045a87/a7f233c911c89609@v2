def main() -> None:
    login = gh("api", "user", "--jq", ".login")
    print(f"Authenticated as: {login}")

    existing_titles = {
        t.lower()
        for t in json.loads(gh("issue", "list", "-R", REPO, "--state", "open",
                               "--limit", "100", "--json", "title") or "[]" )
        and [i["title"] for i in json.loads(gh("issue", "list", "-R", REPO,
             "--state", "open", "--limit", "100", "--json", "title"))]
    } if False else {
        i["title"].lower()
        for i in json.loads(gh("issue", "list", "-R", REPO, "--state", "open",
                               "--limit", "100", "--json", "title"))
    }
    print(f"Existing open issues: {len(existing_titles)}")

    # label (ignore exists-error)
    subprocess.run(["gh", "label", "create", "ready-for-ai", "-R", REPO,
                    "--color", "0e8a16",
                    "--description", "Queued for the overnight autonomous session"],
                   capture_output=True, text=True, env=ENV)

    existing_ms = {m["title"]: m["number"] for m in json.loads(
        gh("api", f"repos/{REPO}/milestones?state=open&per_page=100"))}

    created = []
    for ms in MILESTONES:
        if ms["title"] in existing_ms:
            ms_number = existing_ms[ms["title"]]
            print(f"Milestone exists: {ms['title']} (#{ms_number})")
        else:
            out = json.loads(gh("api", f"repos/{REPO}/milestones",
                                "-f", f"title={ms['title']}",
                                "-f", f"description={ms['description']}"))
            ms_number = out["number"]
            print(f"Created milestone #{ms_number}: {ms['title']}")

        for spec in ms["issues"]:
            if spec["title"].lower() in existing_titles:
                print(f"  Skipping (exists): {spec['title']}")
                continue
            body = ISSUE_TEMPLATE.format(**spec)
            url = gh("issue", "create", "-R", REPO,
                     "--title", spec["title"], "--body", body,
                     "--label", "ready-for-ai", "--assignee", OWNER,
                     "--milestone", ms["title"])
            number = url.rstrip("/").rsplit("/", 1)[-1]
            gh("issue", "edit", number, "-R", REPO, "--body",
               body.replace("feature/issue-NUM-", f"feature/issue-{number}-"))
            print(f"  Created #{number}: {spec['title']}")
            created.append({"number": number, "title": spec["title"],
                            "concept": spec["concept"], "url": url})

    print("\n=== ready-for-ai queue ===")
    queue = json.loads(gh("issue", "list", "-R", REPO, "--label", "ready-for-ai",
                          "--state", "open", "--limit", "100",
                          "--json", "number,title"))
    for i in queue:
        print(f"  #{i['number']:>3} {i['title']}")
    print(f"\nTotal: {len(queue)} issues queued")

    summary = (f"# Issue Planning Summary\nDate: {datetime.now():%Y-%m-%d %H:%M}\n"
               f"Repo: {REPO}\nFocus: \"July 6th 2026 ideas\"\n\n## Issues Created\n")
    for i in created:
        summary += (f"- #{i['number']}: {i['title']}\n  Concept: {i['concept']}\n"
                    f"  URL: {i['url']}\n\n")
    summary += (
        "\n## What Was NOT Planned\n"
        "- Hayashi-Yoshida intraday lead-lag: already implemented on\n"
        "  feature/hy-intraday-leadlag (48 tests green) — needs a PR, not an issue.\n"
        "- Incremental best-index book optimization (perf/03): deliberately\n"
        "  deferred until the perf/02 follow-up is scheduled; measured-change\n"
        "  discipline says it lands alone.\n"
        "- Eight pushed branches awaiting manual PR creation (see\n"
        "  OVERNIGHT_REPORT.md on chore/overnight-report-2026-07-06).\n")
    Path(".claude/memory").mkdir(parents=True, exist_ok=True)
    Path(".claude/memory/planning-session.md").write_text(summary)
    print("\nPlan summary saved to .claude/memory/planning-session.md")


if __name__ == "__main__":
    main()
