include(FetchContent)

FetchContent_Declare(
    googletest
    GIT_REPOSITORY https://github.com/google/googletest.git
    GIT_TAG        v1.15.2
)
# Prevent GoogleTest from installing system-wide (we only want it here).
set(INSTALL_GTEST OFF CACHE BOOL "" FORCE)
FetchContent_MakeAvailable(googletest)

add_executable(test_itch test_itch.cpp)
target_link_libraries(test_itch PRIVATE itch_lib GTest::gtest_main)

add_executable(test_microstructure test_microstructure.cpp)
target_link_libraries(test_microstructure PRIVATE itch_lib GTest::gtest_main)

# Scaffolded suites (skip-only until their plans are implemented).
add_executable(test_replay_clock test_replay_clock.cpp)
target_link_libraries(test_replay_clock PRIVATE itch_lib GTest::gtest_main)

add_executable(test_mm_sim test_mm_sim.cpp)
target_link_libraries(test_mm_sim PRIVATE itch_lib GTest::gtest_main)

include(GoogleTest)
gtest_discover_tests(test_itch)
gtest_discover_tests(test_microstructure)
gtest_discover_tests(test_replay_clock)
gtest_discover_tests(test_mm_sim)
