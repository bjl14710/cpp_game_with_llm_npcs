                     unsigned int texture, const sf::Color& tint, float tileScale);

// A single axis-aligned wall box in the level.
struct MapWall {
    Vec3   center;
    float  hx = 0.0f;   // half-extent in X
    float  hy = 0.0f;   // half-extent in Y
    float  hz = 0.0f;   // half-extent in Z
    unsigned int tex = 0;
    sf::Color    tint = sf::Color::White;
    float  tileScale  = 3.0f;
};

// Rectangular region on the XZ plane used for enemy and player spawning.
struct SpawnZone {
    float minX = 0.0f;
    float maxX = 0.0f;
    float minZ = 0.0f;
    float maxZ = 0.0f;
};

