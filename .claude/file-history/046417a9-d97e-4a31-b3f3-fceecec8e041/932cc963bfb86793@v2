#pragma once

// map.hpp — Static level geometry for the "Dust" CSGO-inspired map.
//
// The map is represented as a flat list of axis-aligned box walls.
// No BSP or portal required at this scale. drawMap() iterates the list
// and calls drawTexturedBox() for each wall (defined in main.cpp).
//
// Coordinate system matches main.cpp (kArenaHalfSize = 80):
//   X = east/west, Z = north/south, Y = up
//
// Layout (bird's-eye, not to scale):
//
//   +--T-Spawn--+---Mid---+--A-Site--+
//   |           |         |          |
//   |  T-start  | central |  A bomb  |
//   |           |  open   |          |
//   +-----------+----+----+----------+
//                    |   B corridor
//               +----+----+
//               |  B-Site  |
//               +----------+

#include <SFML/Graphics.hpp>
