"""Grading wrapper — Exercise 07: Binary Feed Handler.

Compiles and runs tests/exercises/cpp/test_07_feed_handler.cpp via run_cpp.sh.

Run:  uv run pytest tests/exercises/test_07_feed_handler.py -v
"""
import shutil
import subprocess
from pathlib import Path

import pytest

CPP_DIR = Path(__file__).resolve().parent / "cpp"


def _run_cpp_test(name: str) -> None:
    if shutil.which("g++") is None:
        pytest.skip("g++ not installed")
    proc = subprocess.run(
        ["bash", str(CPP_DIR / "run_cpp.sh"), name],
        capture_output=True,
        text=True,
    )
    if proc.returncode == 42:
        pytest.skip("Exercise not implemented yet — fill in the TODOs")
    assert proc.returncode == 0, f"\n{proc.stdout}\n{proc.stderr}"


def test_feed_handler():
    _run_cpp_test("test_07_feed_handler")
