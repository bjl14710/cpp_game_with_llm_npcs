// ---------------------------------------------------------------------------
// Packed message structs — do not modify sizes or field order.
// ---------------------------------------------------------------------------
#pragma pack(push, 1)
struct MsgAdd {
    char     type;         // 'A'
    uint64_t oid;
    char     side;         // 'B' or 'A'
    int64_t  price_ticks;
    int32_t  qty;
};  // 22 bytes

struct MsgCancel {
    char     type;         // 'X'
    uint64_t oid;
};  // 9 bytes

struct MsgExec {
    char     type;         // 'E'
    uint64_t oid;
    int32_t  qty;
};  // 13 bytes

struct MsgTrade {
    char    type;          // 'P'
    int64_t price_ticks;
    int32_t qty;
};  // 13 bytes
#pragma pack(pop)

// ---------------------------------------------------------------------------
// BookEvent — unified output for all book-relevant messages.
// ---------------------------------------------------------------------------
struct BookEvent {
    char     type;         // 'A', 'X', or 'E'
