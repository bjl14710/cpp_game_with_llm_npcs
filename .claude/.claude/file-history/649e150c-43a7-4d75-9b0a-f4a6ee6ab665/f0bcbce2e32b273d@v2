<script>
  function shuffle(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }
  const answered = new Set();
  let correctCount = 0;
  const totalQuestions = document.querySelectorAll('[data-question]').length;
  const scoreEl = document.getElementById('quizScore');
  function refreshScore() {
    scoreEl.textContent = correctCount + ' / ' + totalQuestions;
  }
  document.querySelectorAll('[data-question]').forEach((q, idx) => {
    const list = q.querySelector('.options');
    shuffle([...list.children]).forEach(li => list.appendChild(li));
    const feedback = q.querySelector('.feedback');
    list.querySelectorAll('li').forEach(li => {
      li.addEventListener('click', () => {
        const isCorrect = li.dataset.correct === 'true';
        list.querySelectorAll('li').forEach(o => o.classList.remove('picked-good','picked-bad'));
        li.classList.add(isCorrect ? 'picked-good' : 'picked-bad');
        feedback.hidden = false;
        feedback.innerHTML = (isCorrect ? '✓ Correct. ' : '✗ Not quite. ') + li.dataset.why;
        feedback.style.color = isCorrect ? 'var(--good)' : 'var(--bad)';
        if (!answered.has(idx)) {
          answered.add(idx);
          if (isCorrect) correctCount++;
          refreshScore();
        }
      });
    });
  });
  refreshScore();
</script>
