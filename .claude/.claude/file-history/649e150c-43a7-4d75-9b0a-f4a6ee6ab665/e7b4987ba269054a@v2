<script>
/* ── progress tracking ─────────────────────────── */
const checks = document.querySelectorAll('.section-check input');
const TOTAL  = checks.length;

function updateBar(){
  const done = [...checks].filter(c=>c.checked).length;
  document.getElementById('pbar').style.width = (done/TOTAL*100)+'%';
  document.getElementById('plabel').textContent = `${done} / ${TOTAL} sections`;
  checks.forEach(c=>{
    const lbl = c.closest('.section-check');
    if(c.checked) lbl.classList.add('done'); else lbl.classList.remove('done');
  });
}
checks.forEach(c=>c.addEventListener('change',updateBar));
updateBar();

/* ── quiz ──────────────────────────────────────── */
function shuffle(arr){
  for(let i=arr.length-1;i>0;i--){
    const j=Math.floor(Math.random()*(i+1));
    [arr[i],arr[j]]=[arr[j],arr[i]];
  }
  return arr;
}

let quizScore = 0, quizAnswered = 0;
const TOTAL_Q = document.querySelectorAll('[data-question]').length;

document.querySelectorAll('[data-question]').forEach(q=>{
  const list = q.querySelector('.options');
  const fb   = q.querySelector('.feedback');
  let answered = false;

  // Shuffle options
  shuffle([...list.children]).forEach(li=>list.appendChild(li));

  list.querySelectorAll('li').forEach(li=>{
    li.addEventListener('click', ()=>{
      if(answered) return;
      answered = true;
      const correct = li.dataset.correct==='true';

      // Mark chosen
      li.classList.add(correct ? 'correct-ans' : 'wrong-ans');
      // Reveal correct if wrong
      if(!correct){
        list.querySelectorAll('li[data-correct="true"]').forEach(el=>el.classList.add('reveal-correct'));
      }
      // Lock all
      list.querySelectorAll('li').forEach(el=>{
        el.classList.add('locked');
        el.style.cursor='default';
      });

      // Show feedback
      fb.style.display = 'block';
      fb.className = 'feedback ' + (correct ? 'correct' : 'wrong');
      fb.textContent = (correct ? '✓ Correct. ' : '✗ Not quite. ') + li.dataset.why;

      // Track score
      if(correct) quizScore++;
      quizAnswered++;
      if(quizAnswered === TOTAL_Q){
        const sb = document.getElementById('score-bar');
        sb.style.display = 'block';
        const pct = Math.round(quizScore/TOTAL_Q*100);
        document.getElementById('score-text').textContent =
          `${quizScore} / ${TOTAL_Q} (${pct}%) — ${pct>=80?'Excellent!':pct>=60?'Good, review missed.':'Review sections 1–3.'}`;
      }
    });
  });
});
</script>
