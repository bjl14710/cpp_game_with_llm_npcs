    if(ch==='all'){
      const allOn = activeCh.size===6;
      if(allOn){activeCh.clear();chips.forEach(c=>c.classList.remove('active'));chip.classList.add('active');}
      else{activeCh=new Set(['gbm','ols','logistic','wf','features','capm']);chips.forEach(c=>c.classList.add('active'));}
    } else {
      if(activeCh.has(ch)){activeCh.delete(ch);chip.classList.remove('active');}
      else{activeCh.add(ch);chip.classList.add('active');}
    }
  });
});

/* ─── Shuffle toggle ────────────────────────── */
let shuffleOn = true;
const shufTog = document.getElementById('shuf-tog');
shufTog.addEventListener('click',()=>{shuffleOn=!shuffleOn;shufTog.classList.toggle('on',shuffleOn);});

function shuffle(arr){for(let i=arr.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]];}return arr;}

/* ─── Start ─────────────────────────────────── */
document.getElementById('start-btn').addEventListener('click',startDrill);
function startDrill(){
  questions=ALL_Q.filter(q=>activeCh.has(q.channel));
  if(shuffleOn)shuffle(questions);
  current=0;
  document.getElementById('start-screen').style.display='none';
  document.getElementById('question-screen').style.display='block';
  render();
}

/* ─── Render ────────────────────────────────── */
function render(){
  const q=questions[current], qs=gs(q.id);
  const pct=(current/questions.length)*100;
  document.getElementById('prog-fill').style.width=pct+'%';
  document.getElementById('q-ctr').textContent=`Q ${current+1} / ${questions.length}`;
  document.getElementById('q-ch-tag').textContent=q.ch_label;
  const tt=document.getElementById('q-type-tag');
  tt.textContent=q.type==='mc'?'Multiple Choice':'Written Recall';
  tt.className='tag '+(q.type==='mc'?'tag-mc':'tag-wr');
  document.getElementById('q-text').innerHTML=q.text;
  const body=document.getElementById('q-body');
  body.innerHTML=q.type==='mc'?buildMC(q,qs):buildWR(q,qs);
  if(q.type==='mc')attachMC(q,qs); else attachWR(q,qs);
  document.getElementById('btn-prev').disabled=current===0;
  const isLast=current===questions.length-1;
  document.getElementById('btn-next').style.display=isLast?'none':'inline-block';
  document.getElementById('btn-finish').style.display=isLast?'block':'none';
  const ind=document.getElementById('ans-ind');
  if(qs.answered){
    if(q.type==='mc') ind.textContent=qs.correct?'✓ correct':'✗ incorrect';
    else ind.textContent=qs.selfRated==='knew'?'✓ knew it':qs.selfRated==='review'?'⚑ needs review':qs.revealed?'⚑ revealed':'';
  } else ind.textContent='';
}

/* ─── MC ─────────────────────────────────────── */
function buildMC(q,qs){
  let h='<ul class="opt-list" id="mc-list">';
  q.opts.forEach((o,i)=>{ let c=''; if(qs.answered){c=o.c?'show-c':'';}
    h+=`<li data-idx="${i}" data-correct="${o.c}" class="${c}">${o.t}<div class="opt-why">${o.w}</div></li>`;});
  h+='</ul>';
  if(qs.answered){
    h+=`<div class="mc-fb ${qs.correct?'ok':'bad'}" style="display:block">${qs.correct?'✓ Correct.':'✗ Incorrect.'}</div>`;
  } else h+='<div class="mc-fb" id="mc-fb"></div>';
  return h;
}
function attachMC(q,qs){
  const list=document.getElementById('mc-list');
  if(!list)return;
  if(!qs.answered){shuffle([...list.children]).forEach(li=>list.appendChild(li));}
  if(qs.answered && qs.chosenIdx!==undefined){
    list.querySelectorAll('li').forEach(li=>{
      const idx=parseInt(li.dataset.idx), cor=li.dataset.correct==='true';
      if(idx===qs.chosenIdx) li.classList.add(cor?'correct-c':'wrong-c');
      else if(cor) li.classList.add('show-c');
    });
  }
  if(qs.answered)return;
  list.querySelectorAll('li').forEach(li=>{
    li.addEventListener('click',()=>{
      if(qs.answered)return;
      const cor=li.dataset.correct==='true';
      qs.answered=true;qs.correct=cor;qs.chosenIdx=parseInt(li.dataset.idx);
      list.querySelectorAll('li').forEach(item=>{
        const ic=item.dataset.correct==='true';
        if(item===li)item.classList.add(cor?'correct-c':'wrong-c'); else if(ic)item.classList.add('show-c');
        item.classList.add('locked');item.style.cursor='default';
      });
      const fb=document.getElementById('mc-fb');
      if(fb){fb.className='mc-fb '+(cor?'ok':'bad');fb.textContent=cor?'✓ Correct.':'✗ Incorrect.';fb.style.display='block';}
      document.getElementById('ans-ind').textContent=cor?'✓ correct':'✗ incorrect';
    });
  });
}

/* ─── WR ─────────────────────────────────────── */
function buildWR(q,qs){
  return `<textarea class="wr-ta" id="wr-ta" placeholder="Type your answer here...">${qs.typed||''}</textarea>
  <div class="wr-btns">
    <button class="btn btn-chk" id="wr-chk">Check keywords</button>
    <button class="btn btn-rev" id="wr-reveal">Show model answer</button>
  </div>
  <div class="kw-box" id="kw-box"></div>
  <div class="model-ans" id="model-ans"></div>
  <div class="self-rate" id="self-rate" style="display:none">
    <button class="btn btn-knew" id="rate-knew">✓ Knew it</button>
    <button class="btn btn-review" id="rate-review">⚑ Needs review</button>
  </div>`;
}
function attachWR(q,qs){
  const ta=document.getElementById('wr-ta');
  if(!ta)return;
  ta.addEventListener('input',()=>{qs.typed=ta.value;});
  const kwBox=document.getElementById('kw-box');
  const modelAns=document.getElementById('model-ans');
  const selfRate=document.getElementById('self-rate');
  if(qs.revealed){
    modelAns.innerHTML=q.answer;modelAns.style.display='block';selfRate.style.display='flex';
    showKw(q,qs,kwBox);
  }
  document.getElementById('wr-chk').addEventListener('click',()=>{qs.typed=ta.value;showKw(q,qs,kwBox);});
  document.getElementById('wr-reveal').addEventListener('click',()=>{
    qs.revealed=true;qs.answered=true;
    modelAns.innerHTML=q.answer;modelAns.style.display='block';selfRate.style.display='flex';
    showKw(q,qs,kwBox);
    document.getElementById('ans-ind').textContent='⚑ revealed';
  });
  document.getElementById('rate-knew').addEventListener('click',()=>{
    qs.selfRated='knew';qs.answered=true;
    document.getElementById('ans-ind').textContent='✓ knew it';
  });
  document.getElementById('rate-review').addEventListener('click',()=>{
    qs.selfRated='review';qs.answered=true;
    document.getElementById('ans-ind').textContent='⚑ needs review';
  });
}
function showKw(q,qs,box){
  const txt=(qs.typed||'').toLowerCase();
  const hits=q.concepts.map(c=>({label:c.label,hit:c.terms.some(t=>txt.includes(t.toLowerCase()))}));
  const got=hits.filter(h=>h.hit).length, tot=hits.length;
  const col=got===tot?'#4ade80':got>=tot*.6?'#facc15':'#f87171';
  box.style.display='block';
  box.innerHTML=`<div class="tally" style="color:${col}">${got} / ${tot} key concepts detected</div>`+
    hits.map(h=>`<div class="${h.hit?'kw-hit':'kw-miss'}">${h.hit?'✓':'✗'} ${h.label}</div>`).join('')+
    `<div class="kw-note">Keyword scan is rough — self-judge against the model answer.</div>`;
}

/* ─── Navigation ─────────────────────────────── */
document.getElementById('btn-prev').addEventListener('click',()=>{if(current>0){current--;render();}});
document.getElementById('btn-next').addEventListener('click',()=>{if(current<questions.length-1){current++;render();}});
document.getElementById('btn-finish').addEventListener('click',showResults);

/* ─── Results ────────────────────────────────── */
function showResults(){
  document.getElementById('question-screen').style.display='none';
  document.getElementById('results-screen').style.display='block';
  const mcQs=questions.filter(q=>q.type==='mc');
  const mcC=mcQs.filter(q=>gs(q.id).correct===true).length;
  const mcA=mcQs.filter(q=>gs(q.id).answered).length;
  const wrQs=questions.filter(q=>q.type==='wr');
  const wrK=wrQs.filter(q=>gs(q.id).selfRated==='knew').length;
  const wrR=wrQs.filter(q=>gs(q.id).selfRated==='review').length;
  document.getElementById('res-big').textContent=mcA?`MC: ${mcC}/${mcA}`:'MC: —';
  document.getElementById('res-sub').textContent=`Written recall: ${wrK} knew · ${wrR} needs review · ${wrQs.length-wrK-wrR} unrated`;
  const chs=[...new Set(questions.map(q=>q.channel))];
  document.getElementById('ch-breakdown').innerHTML=chs.map(ch=>{
    const cq=questions.filter(q=>q.channel===ch);
    const mc=cq.filter(q=>q.type==='mc');const wr=cq.filter(q=>q.type==='wr');
    const mcScore=mc.filter(q=>gs(q.id).correct).length;
    const wrKnew=wr.filter(q=>gs(q.id).selfRated==='knew').length;
    return `<div class="ch-stat"><div class="ch-nm">${cq[0].ch_label}</div><div class="ch-sc">${mc.length?`MC ${mcScore}/${mc.length}`:''}${mc.length&&wr.length?' · ':''}${wr.length?`WR ${wrKnew}/${wr.length} knew`:''}</div></div>`;
  }).join('');
}
document.getElementById('btn-retry').addEventListener('click',()=>{
  Object.keys(state).forEach(k=>delete state[k]);
  document.getElementById('results-screen').style.display='none';
  document.getElementById('start-screen').style.display='block';
});
document.getElementById('btn-miss').addEventListener('click',()=>{
  const missed=questions.filter(q=>{const qs=gs(q.id);if(q.type==='mc')return qs.answered&&!qs.correct;return qs.selfRated==='review'||(qs.answered&&!qs.selfRated);});
  if(!missed.length){alert('No missed questions!');return;}
  questions=missed;current=0;
  document.getElementById('results-screen').style.display='none';
  document.getElementById('question-screen').style.display='block';
  render();
});
</script>
