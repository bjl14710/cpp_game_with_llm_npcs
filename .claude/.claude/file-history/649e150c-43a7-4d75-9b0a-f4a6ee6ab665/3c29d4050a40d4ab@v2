#define ASSERT(cond, msg)                                              \
    do {                                                               \
        if (!(cond)) {                                                 \
            std::cerr << "FAIL: " << msg << "\n";                     \
            return 1;                                                  \
        }                                                              \
    } while (0)

// ---------------------------------------------------------------------------
// BBO tests
// ---------------------------------------------------------------------------
int test_empty_book_bbo() {
    OrderBook book;
    ASSERT(book.best_bid() == INT64_MIN, "empty book best_bid should be INT64_MIN");
    ASSERT(book.best_ask() == INT64_MAX, "empty book best_ask should be INT64_MAX");
    return 0;
}

int test_bbo_after_adds() {
    OrderBook book;
    book.add_limit(1, 'B', 1'000'000, 10);  // bid $100.00
    book.add_limit(2, 'A', 1'010'000, 10);  // ask $101.00
    ASSERT(book.best_bid() == 1'000'000, "best bid should be 1000000");
    ASSERT(book.best_ask() == 1'010'000, "best ask should be 1010000");
    return 0;
}

int test_price_priority() {
    OrderBook book;
    book.add_limit(1, 'B', 1'000'000, 10);  // $100.00
    book.add_limit(2, 'B', 1'005'000, 10);  // $100.50 — better bid
    book.add_limit(3, 'A', 1'010'000, 10);  // $101.00
    book.add_limit(4, 'A', 1'015'000, 10);  // $101.50 — worse ask
    ASSERT(book.best_bid() == 1'005'000,
           "best bid should be highest: 1005000 got " + std::to_string(book.best_bid()));
    ASSERT(book.best_ask() == 1'010'000,
           "best ask should be lowest: 1010000 got " + std::to_string(book.best_ask()));
    return 0;
}

// ---------------------------------------------------------------------------
// Add and cancel tests
// ---------------------------------------------------------------------------
int test_cancel_updates_bbo() {
    OrderBook book;
    book.add_limit(1, 'B', 1'005'000, 10);
    book.add_limit(2, 'B', 1'000'000, 10);
    ASSERT(book.best_bid() == 1'005'000, "best bid before cancel");
    book.cancel(1);
    ASSERT(book.best_bid() == 1'000'000,
           "best bid after cancel should fall to 1000000");
    return 0;
}

int test_cancel_unknown_raises() {
    OrderBook book;
    bool threw = false;
    try {
        book.cancel(999);
    } catch (const std::out_of_range&) {
        threw = true;
    }
    ASSERT(threw, "cancel of unknown order_id should throw std::out_of_range");
    return 0;
}

