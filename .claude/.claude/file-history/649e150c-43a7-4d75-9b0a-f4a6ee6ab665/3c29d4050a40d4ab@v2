// ---------------------------------------------------------------------------
// Market execution tests
// ---------------------------------------------------------------------------
int test_fifo_at_same_price() {
    OrderBook book;
    // Two bids at same price; first added should fill first.
    book.add_limit(10, 'A', 1'000'000, 5);  // first at this ask price
    book.add_limit(11, 'A', 1'000'000, 5);  // second
    auto fills = book.execute_market('B', 5);
    ASSERT(fills.size() == 1, "expected 1 fill");
    ASSERT(fills[0].order_id == 10, "first ask at level should fill first (FIFO)");
    ASSERT(fills[0].qty == 5, "fill qty should be 5");
    // order 11 should still rest
    ASSERT(book.best_ask() == 1'000'000, "level should still exist with order 11");
    return 0;
}

int test_partial_fill_stays_at_front() {
    OrderBook book;
    book.add_limit(1, 'A', 1'000'000, 10);
    book.add_limit(2, 'A', 1'000'000,  5);
    auto fills = book.execute_market('B', 4);
    ASSERT(fills.size() == 1, "expected 1 partial fill");
    ASSERT(fills[0].order_id == 1 && fills[0].qty == 4, "partial fill on order 1");
    // order 1 has 6 remaining — it must remain at the FRONT of the level
    auto fills2 = book.execute_market('B', 3);
    ASSERT(fills2.size() == 1 && fills2[0].order_id == 1 && fills2[0].qty == 3,
           "next fill should continue consuming order 1 (FIFO)");
    return 0;
}

int test_market_walks_levels() {
    OrderBook book;
    book.add_limit(1, 'A', 1'000'000, 5);  // $100.00
    book.add_limit(2, 'A', 1'010'000, 5);  // $101.00
    book.add_limit(3, 'A', 1'020'000, 5);  // $102.00
    auto fills = book.execute_market('B', 12);
    ASSERT(fills.size() == 3, "should cross 3 levels");
    ASSERT(fills[0].price_ticks == 1'000'000, "first fill at lowest ask");
    ASSERT(fills[1].price_ticks == 1'010'000, "second fill at next level");
    ASSERT(fills[2].price_ticks == 1'020'000 && fills[2].qty == 2,
           "third level partially filled (qty 2)");
    return 0;
}

int test_sell_hits_best_bid_first() {
    OrderBook book;
    book.add_limit(1, 'B', 1'010'000, 5);  // better bid $101.00
    book.add_limit(2, 'B', 1'000'000, 5);  // worse bid  $100.00
    auto fills = book.execute_market('A', 5);
    ASSERT(fills.size() == 1, "expected 1 fill");
    ASSERT(fills[0].price_ticks == 1'010'000, "sell should hit highest bid first");
    return 0;
}

int test_insufficient_liquidity() {
    OrderBook book;
    book.add_limit(1, 'A', 1'000'000, 3);
    auto fills = book.execute_market('B', 10);
    ASSERT(fills.size() == 1 && fills[0].qty == 3,
           "insufficient liquidity: partial fill expected");
    ASSERT(book.best_ask() == INT64_MAX, "book should be empty after fill");
    return 0;
}

// ---------------------------------------------------------------------------
// Imbalance tests
// ---------------------------------------------------------------------------
int test_empty_imbalance_zero() {
    OrderBook book;
    ASSERT(book.imbalance(1) == 0.0, "empty book imbalance should be 0.0");
    return 0;
}

int test_imbalance_hand_computed() {
    OrderBook book;
    // Same numbers as Python test:
    //   bid $100.00 qty 30, bid $99.00 qty 20, ask $101.00 qty 10
    //   imbalance(1) = (30 - 10) / (30 + 10) = 0.5
    book.add_limit(1, 'B', 1'000'000, 30);
    book.add_limit(2, 'B',   990'000, 20);
    book.add_limit(3, 'A', 1'010'000, 10);
    double im = book.imbalance(1);
    ASSERT(std::abs(im - 0.5) < 1e-9,
           "imbalance(1) expected 0.5 but got " + std::to_string(im));
    return 0;
}

int test_imbalance_multi_level() {
    OrderBook book;
    book.add_limit(1, 'B', 1'000'000, 30);
    book.add_limit(2, 'B',   990'000, 20);
    book.add_limit(3, 'A', 1'010'000, 10);
    book.add_limit(4, 'A', 1'020'000, 15);
    // levels=2: bid_qty=50, ask_qty=25 → (50-25)/(50+25) = 1/3
    double im2 = book.imbalance(2);
    ASSERT(std::abs(im2 - 1.0/3.0) < 1e-9,
           "imbalance(2) expected 1/3 but got " + std::to_string(im2));
    return 0;
}

int test_one_sided_saturates() {
    OrderBook book;
    book.add_limit(1, 'B', 1'000'000, 100);
    double im = book.imbalance(1);
    ASSERT(std::abs(im - 1.0) < 1e-9,
           "one-sided (all bids) imbalance should be +1.0");
    return 0;
}

// ---------------------------------------------------------------------------
// Throughput smoke test — catches O(n²) bugs
// ---------------------------------------------------------------------------
int test_throughput_1m() {
    OrderBook book;
    auto t0 = std::chrono::steady_clock::now();
    for (int64_t i = 1; i <= 1'000'000; ++i) {
        // spread across 100 price levels to exercise the map
        book.add_limit(i, 'B', 1'000'000 + (i % 100) * 1000, 10);
        book.cancel(i);
    }
    auto t1 = std::chrono::steady_clock::now();
    auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(t1 - t0).count();
    ASSERT(ms < 2000,
           "1M add+cancel cycles took " + std::to_string(ms) + "ms (limit 2000ms)");
    return 0;
}

