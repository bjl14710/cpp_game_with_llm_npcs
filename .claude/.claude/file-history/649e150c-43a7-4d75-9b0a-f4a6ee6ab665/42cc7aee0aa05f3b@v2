    position:relative}
  .options-list li:hover:not(.answered){border-color:var(--accent);background:var(--surface2)}
  .options-list li.correct-choice{border-color:var(--green)!important;background:#052e16!important}
  .options-list li.wrong-choice{border-color:var(--red)!important;background:#2d0c0c!important}
  .options-list li.show-correct{border-color:var(--green)!important;background:#052e16!important;opacity:.7}
  .option-why{display:none;font-size:.82rem;color:var(--muted);margin-top:.4rem;font-style:italic}
