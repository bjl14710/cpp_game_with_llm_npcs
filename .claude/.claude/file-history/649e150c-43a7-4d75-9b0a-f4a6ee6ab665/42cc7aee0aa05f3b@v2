  .btn-finish{padding:.5rem 1.5rem;background:var(--green);border:none;
    border-radius:.4rem;color:#052e16;font-weight:600;font-family:var(--sans);font-size:.9rem;cursor:pointer}

  /* Results screen */
  #results-screen{display:none;width:100%;max-width:800px}
  .result-card{background:var(--surface);border:1px solid var(--border);border-radius:1rem;
    padding:1.5rem;margin-bottom:1rem}
  .score-big{font-family:var(--mono);font-size:2.5rem;font-weight:600;color:var(--accent);
    margin-bottom:.3rem}
  .score-sub{color:var(--muted);font-size:.9rem;margin-bottom:1.2rem}
  .channel-breakdown{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:.75rem}
  .channel-stat{background:var(--surface2);border:1px solid var(--border);border-radius:.5rem;padding:.75rem}
  .channel-stat .ch-name{font-size:.8rem;color:var(--muted);margin-bottom:.25rem}
  .channel-stat .ch-score{font-family:var(--mono);font-weight:600}
  .result-btn{padding:.6rem 1.5rem;border:none;border-radius:.5rem;font-family:var(--sans);
