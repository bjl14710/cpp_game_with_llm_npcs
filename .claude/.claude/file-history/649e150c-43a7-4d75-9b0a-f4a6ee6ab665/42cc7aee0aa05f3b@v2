<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Drill 0001 — Statistics in Trading</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Inter:wght@400;500;600&display=swap');
  *{box-sizing:border-box;margin:0;padding:0}
  :root{
    --bg:#0a0e17;--surface:#111827;--surface2:#1c2333;--surface3:#232d42;
    --border:#2a3550;--text:#e2e8f0;--muted:#7c8ba1;--accent:#3b82f6;
    --green:#22c55e;--red:#ef4444;--yellow:#f59e0b;--purple:#a78bfa;
    --mono:'JetBrains Mono',monospace;--sans:'Inter',system-ui,sans-serif;
  }
  body{background:var(--bg);color:var(--text);font-family:var(--sans);min-height:100vh;
    display:flex;flex-direction:column;align-items:center;padding:1rem}
  @media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}

  /* ── Header ─────────────────────────────────────────────── */
  .drill-header{width:100%;max-width:800px;margin-bottom:2rem;text-align:center}
  .drill-header h1{font-family:var(--mono);font-size:1.1rem;color:var(--accent);letter-spacing:.08em;margin-bottom:.4rem}
  .drill-header h2{font-size:1.7rem;font-weight:600;margin-bottom:.3rem}
  .drill-header p{color:var(--muted);font-size:.9rem}

  /* ── Start screen ─────────────────────────────────────────  */
  #start-screen{width:100%;max-width:800px}
  .section-label{font-family:var(--mono);font-size:.72rem;color:var(--accent);
    letter-spacing:.12em;text-transform:uppercase;margin-bottom:.75rem}
  .channel-grid{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1.5rem}
  .chip{padding:.35rem .85rem;border-radius:9999px;border:1px solid var(--border);
    background:var(--surface2);color:var(--text);font-size:.82rem;cursor:pointer;
    transition:border-color .15s,background .15s;user-select:none}
  .chip.active{border-color:var(--accent);background:#1e3a5f;color:#93c5fd}
  .chip:hover{border-color:var(--accent)}
  .start-options{display:flex;gap:1rem;align-items:center;margin-bottom:1.5rem}
  .toggle-row{display:flex;align-items:center;gap:.5rem;font-size:.85rem;color:var(--muted)}
  .toggle{width:38px;height:20px;background:var(--border);border-radius:10px;
    cursor:pointer;position:relative;transition:background .15s}
  .toggle.on{background:var(--accent)}
  .toggle::after{content:'';position:absolute;top:2px;left:2px;width:16px;height:16px;
    background:#fff;border-radius:50%;transition:transform .15s}
  .toggle.on::after{transform:translateX(18px)}
  .start-btn{padding:.7rem 2rem;background:var(--accent);border:none;border-radius:.5rem;
    color:#fff;font-family:var(--sans);font-size:1rem;font-weight:600;cursor:pointer;
    transition:opacity .15s}
  .start-btn:hover{opacity:.85}
  .info-box{background:var(--surface);border:1px solid var(--border);border-radius:.75rem;
    padding:1rem 1.25rem;font-size:.85rem;color:var(--muted);line-height:1.6;margin-bottom:1.5rem}
  .info-box strong{color:var(--text)}

  /* ── Question screen ──────────────────────────────────────── */
  #question-screen{display:none;width:100%;max-width:800px}
  .progress-bar-wrap{background:var(--surface2);border-radius:9999px;height:5px;margin-bottom:.6rem}
  .progress-bar-fill{height:5px;background:var(--accent);border-radius:9999px;transition:width .3s}
  .progress-meta{display:flex;justify-content:space-between;align-items:center;
    font-size:.8rem;color:var(--muted);margin-bottom:1.2rem}
  .q-tags{display:flex;gap:.5rem}
  .tag{padding:.15rem .6rem;border-radius:.25rem;font-family:var(--mono);font-size:.7rem;
    font-weight:600;text-transform:uppercase;letter-spacing:.07em}
  .tag-mc{background:#1e3a5f;color:#93c5fd}
  .tag-wr{background:#2d1f4e;color:#c4b5fd}
  .tag-channel{background:var(--surface3);color:var(--muted)}

  .q-card{background:var(--surface);border:1px solid var(--border);border-radius:1rem;
    padding:1.5rem;margin-bottom:1rem}
  .q-text{font-size:1.05rem;line-height:1.7;margin-bottom:1.2rem}
  .q-text code{font-family:var(--mono);font-size:.9em;background:var(--surface3);
    padding:.1em .35em;border-radius:.25rem;color:#93c5fd}
  pre.snippet{background:var(--surface3);border:1px solid var(--border);border-radius:.5rem;
    padding:1rem;margin:1rem 0;overflow-x:auto;font-family:var(--mono);font-size:.82rem;
    line-height:1.7;color:#e2e8f0}
  pre.snippet .kw{color:#c792ea}
  pre.snippet .fn{color:#82aaff}
