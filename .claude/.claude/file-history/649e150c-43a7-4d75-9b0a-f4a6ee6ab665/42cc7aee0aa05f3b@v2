/* ============================================================
   STATE
============================================================ */
let questions = [];
let current = 0;
let shuffleOn = true;
let reviewMissedMode = false;

// Per-question state (keyed by q.id)
const state = {};
function getState(id) {
  if (!state[id]) state[id] = { answered: false, correct: null, typed: '', selfRated: null, revealed: false };
  return state[id];
}

/* ============================================================
   CHANNEL FILTERING
============================================================ */
const chips = document.querySelectorAll('#channel-chips .chip');
let activeChannels = new Set(['returns','risk','cagr','cov','cusum','capm']);

chips.forEach(chip => {
  chip.addEventListener('click', () => {
    const ch = chip.dataset.ch;
    if (ch === 'all') {
      const allActive = activeChannels.size === 6;
      if (allActive) { activeChannels.clear(); chips.forEach(c => c.classList.remove('active')); chip.classList.add('active'); }
      else { activeChannels = new Set(['returns','risk','cagr','cov','cusum','capm']); chips.forEach(c => c.classList.add('active')); }
    } else {
      if (activeChannels.has(ch)) { activeChannels.delete(ch); chip.classList.remove('active'); }
      else { activeChannels.add(ch); chip.classList.add('active'); }
    }
  });
});

/* shuffle toggle */
const toggleEl = document.getElementById('shuffle-toggle');
toggleEl.addEventListener('click', () => { shuffleOn = !shuffleOn; toggleEl.classList.toggle('on', shuffleOn); });

/* ============================================================
   FISHER-YATES SHUFFLE
============================================================ */
function shuffle(arr) {
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

/* ============================================================
   START
============================================================ */
document.getElementById('start-btn').addEventListener('click', startDrill);

function startDrill() {
  reviewMissedMode = false;
  questions = ALL_QUESTIONS.filter(q => activeChannels.has(q.channel));
  if (shuffleOn) shuffle(questions);
  current = 0;
  document.getElementById('start-screen').style.display = 'none';
  document.getElementById('question-screen').style.display = 'block';
  renderQuestion();
}

/* ============================================================
   RENDER
============================================================ */
function renderQuestion() {
  const q = questions[current];
  const qs = getState(q.id);

  // Progress
  const pct = ((current) / questions.length) * 100;
  document.getElementById('progress-fill').style.width = pct + '%';
  document.getElementById('q-counter').textContent = `Q ${current + 1} / ${questions.length}`;
  document.getElementById('q-channel-tag').textContent = q.channel_label;
  const typeTag = document.getElementById('q-type-tag');
  typeTag.textContent = q.type === 'mc' ? 'Multiple Choice' : 'Written Recall';
  typeTag.className = 'tag ' + (q.type === 'mc' ? 'tag-mc' : 'tag-wr');

  // Question text
  document.getElementById('q-text').innerHTML = q.text;

  // Body
  const body = document.getElementById('q-body');
  if (q.type === 'mc') body.innerHTML = renderMC(q, qs);
  else body.innerHTML = renderWR(q, qs);

  // Re-attach events
  if (q.type === 'mc') attachMCEvents(q, qs);
  else attachWREvents(q, qs);

  // Navigation
  document.getElementById('btn-prev').disabled = current === 0;
  const isLast = current === questions.length - 1;
  document.getElementById('btn-next').style.display = isLast ? 'none' : 'inline-block';
  document.getElementById('btn-finish').style.display = isLast ? 'block' : 'none';

  // Answered indicator
  const ind = document.getElementById('answered-indicator');
  if (qs.answered) {
    if (q.type === 'mc') ind.textContent = qs.correct ? '✓ answered correctly' : '✗ answered incorrectly';
    else ind.textContent = qs.selfRated === 'knew' ? '✓ self-rated: knew it' : qs.selfRated === 'review' ? '⚑ self-rated: needs review' : qs.revealed ? '⚑ revealed' : '';
  } else ind.textContent = '';
}

/* ── MC ─────────────────────────────────────────────────────── */
function renderMC(q, qs) {
  let html = '<ul class="options-list" id="mc-opts">';
  // Shuffle options order (done in DOM after render using Fisher-Yates)
  q.options.forEach((opt, idx) => {
    let cls = '';
    if (qs.answered) {
      if (opt.correct) cls = 'show-correct';
      // will be overridden for chosen below
    }
    html += `<li data-idx="${idx}" data-correct="${opt.correct}" class="${cls}">
      ${opt.text}
      <div class="option-why">${opt.why}</div>
    </li>`;
  });
  html += '</ul>';
  if (qs.answered) {
    const cls = qs.correct ? 'mc-feedback correct' : 'mc-feedback wrong';
    html += `<div class="${cls}" style="display:block">${qs.correct ? '✓ Correct.' : '✗ Incorrect.'}</div>`;
  } else {
    html += '<div class="mc-feedback" id="mc-fb"></div>';
  }
  return html;
}

function attachMCEvents(q, qs) {
  const list = document.getElementById('mc-opts');
  if (!list) return;

  // Shuffle in DOM (Fisher-Yates on children)
  if (!qs.answered) {
    const items = [...list.children];
    shuffle(items);
    items.forEach(li => list.appendChild(li));
  }

  // Mark chosen option if already answered
  if (qs.answered && qs.chosenIdx !== undefined) {
    list.querySelectorAll('li').forEach(li => {
      const idx = parseInt(li.dataset.idx);
      const correct = li.dataset.correct === 'true';
      if (idx === qs.chosenIdx) li.classList.add(correct ? 'correct-choice' : 'wrong-choice');
      else if (correct) li.classList.add('show-correct');
    });
  }

  if (qs.answered) return;

  list.querySelectorAll('li').forEach(li => {
    li.addEventListener('click', () => {
      if (qs.answered) return;
      const correct = li.dataset.correct === 'true';
      qs.answered = true;
      qs.correct = correct;
      qs.chosenIdx = parseInt(li.dataset.idx);

      list.querySelectorAll('li').forEach(item => {
        const itemCorrect = item.dataset.correct === 'true';
        if (item === li) item.classList.add(correct ? 'correct-choice' : 'wrong-choice');
        else if (itemCorrect) item.classList.add('show-correct');
        item.classList.add('answered');
      });

      const fb = document.getElementById('mc-fb');
      if (fb) {
        fb.className = 'mc-feedback ' + (correct ? 'correct' : 'wrong');
        fb.textContent = correct ? '✓ Correct.' : '✗ Incorrect.';
        fb.style.display = 'block';
      }
      document.getElementById('answered-indicator').textContent = correct ? '✓ answered correctly' : '✗ answered incorrectly';
    });
  });
}

/* ── Written Recall ──────────────────────────────────────────── */
function renderWR(q, qs) {
  return `
    <textarea class="wr-textarea" id="wr-input" placeholder="Type your answer here...">${qs.typed || ''}</textarea>
    <div class="wr-btns">
      <button class="btn btn-check" id="wr-check">Check keywords</button>
      <button class="btn btn-reveal" id="wr-reveal">Show model answer</button>
    </div>
    <div class="keyword-result" id="kw-result"></div>
    <div class="model-answer" id="model-ans"></div>
    <div class="self-rate" id="self-rate" style="display:none">
      <button class="btn btn-knew" id="rate-knew">✓ Knew it</button>
      <button class="btn btn-review" id="rate-review">⚑ Needs review</button>
    </div>`;
}

function attachWREvents(q, qs) {
  const ta = document.getElementById('wr-input');
  if (!ta) return;

  ta.addEventListener('input', () => { qs.typed = ta.value; });

  // Restore state
  const kwResult = document.getElementById('kw-result');
  const modelAns = document.getElementById('model-ans');
  const selfRate = document.getElementById('self-rate');

  if (qs.revealed) {
    modelAns.innerHTML = q.answer;
    modelAns.style.display = 'block';
    selfRate.style.display = 'flex';
    showKeywords(q, qs, kwResult);
  }
  if (qs.selfRated) {
    selfRate.style.display = 'flex';
  }

  document.getElementById('wr-check').addEventListener('click', () => {
    qs.typed = ta.value;
    showKeywords(q, qs, kwResult);
  });

  document.getElementById('wr-reveal').addEventListener('click', () => {
    qs.revealed = true;
    qs.answered = true;
    modelAns.innerHTML = q.answer;
    modelAns.style.display = 'block';
    selfRate.style.display = 'flex';
    showKeywords(q, qs, kwResult);
    document.getElementById('answered-indicator').textContent = '⚑ revealed';
  });

  document.getElementById('rate-knew').addEventListener('click', () => {
    qs.selfRated = 'knew';
    qs.answered = true;
    document.getElementById('answered-indicator').textContent = '✓ self-rated: knew it';
  });
  document.getElementById('rate-review').addEventListener('click', () => {
    qs.selfRated = 'review';
    qs.answered = true;
    document.getElementById('answered-indicator').textContent = '⚑ self-rated: needs review';
  });
}

function showKeywords(q, qs, container) {
  const text = (qs.typed || '').toLowerCase();
  const hits = q.concepts.map(c => ({
    label: c.label,
    hit: c.terms.some(t => text.includes(t.toLowerCase()))
  }));
  const got = hits.filter(h => h.hit).length;
  const total = hits.length;
  container.style.display = 'block';
  const color = got === total ? '#22c55e' : got >= total * 0.6 ? '#f59e0b' : '#ef4444';
  container.innerHTML = `<div class="tally" style="color:${color}">${got} / ${total} key concepts detected</div>` +
    hits.map(h => `<div class="${h.hit ? 'kw-hit' : 'kw-miss'}">${h.hit ? '✓' : '✗'} ${h.label}</div>`).join('') +
    `<div class="kw-note">Keyword scan is approximate — self-judge against the model answer.</div>`;
}

/* ============================================================
   NAVIGATION
============================================================ */
document.getElementById('btn-prev').addEventListener('click', () => {
  if (current > 0) { current--; renderQuestion(); }
});
document.getElementById('btn-next').addEventListener('click', () => {
  if (current < questions.length - 1) { current++; renderQuestion(); }
});
document.getElementById('btn-finish').addEventListener('click', showResults);

/* ============================================================
   RESULTS
============================================================ */
function showResults() {
  document.getElementById('question-screen').style.display = 'none';
  document.getElementById('results-screen').style.display = 'block';

  const mcQs = questions.filter(q => q.type === 'mc');
  const mcCorrect = mcQs.filter(q => getState(q.id).correct === true).length;
  const mcAnswered = mcQs.filter(q => getState(q.id).answered).length;

  const wrQs = questions.filter(q => q.type === 'wr');
  const wrKnew = wrQs.filter(q => getState(q.id).selfRated === 'knew').length;
  const wrReview = wrQs.filter(q => getState(q.id).selfRated === 'review').length;
  const wrAnswered = wrQs.filter(q => getState(q.id).answered).length;

  document.getElementById('res-score').textContent = mcAnswered > 0 ? `MC: ${mcCorrect}/${mcAnswered}` : 'MC: —';
  document.getElementById('res-sub').textContent =
    `Written recall: ${wrKnew} knew · ${wrReview} needs review · ${wrQs.length - wrAnswered} unanswered`;

  // Channel breakdown
  const channels = [...new Set(questions.map(q => q.channel))];
  const bd = document.getElementById('ch-breakdown');
  bd.innerHTML = channels.map(ch => {
    const chQs = questions.filter(q => q.channel === ch);
    const mcC = chQs.filter(q => q.type === 'mc' && getState(q.id).correct).length;
    const mcT = chQs.filter(q => q.type === 'mc').length;
    const wrK = chQs.filter(q => q.type === 'wr' && getState(q.id).selfRated === 'knew').length;
    const wrT = chQs.filter(q => q.type === 'wr').length;
    const label = chQs[0].channel_label;
    return `<div class="channel-stat">
      <div class="ch-name">${label}</div>
      <div class="ch-score">${mcT ? `MC ${mcC}/${mcT}` : ''}${mcT && wrT ? ' · ' : ''}${wrT ? `WR ${wrK}/${wrT} knew` : ''}</div>
    </div>`;
  }).join('');
}

document.getElementById('btn-retry').addEventListener('click', () => {
  Object.keys(state).forEach(k => delete state[k]);
  document.getElementById('results-screen').style.display = 'none';
  document.getElementById('start-screen').style.display = 'block';
});

document.getElementById('btn-review-missed').addEventListener('click', () => {
  const missed = questions.filter(q => {
    const qs = getState(q.id);
    if (q.type === 'mc') return qs.answered && !qs.correct;
    return qs.selfRated === 'review' || (qs.answered && !qs.selfRated);
  });
  if (missed.length === 0) { alert('No missed questions to review!'); return; }
  questions = missed;
  current = 0;
  document.getElementById('results-screen').style.display = 'none';
  document.getElementById('question-screen').style.display = 'block';
  renderQuestion();
});

/* initial render */
document.getElementById('start-screen').style.display = 'block';
</script>
