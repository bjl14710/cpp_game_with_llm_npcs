  .wr-textarea:focus{outline:none;border-color:var(--accent)}
  .wr-btns{display:flex;gap:.75rem;margin-top:.75rem;flex-wrap:wrap}
  .btn{padding:.5rem 1.1rem;border-radius:.4rem;border:none;font-family:var(--sans);
    font-size:.85rem;font-weight:500;cursor:pointer;transition:opacity .15s}
  .btn:hover{opacity:.85}
  .btn-check{background:var(--accent);color:#fff}
  .btn-reveal{background:var(--surface3);border:1px solid var(--border);color:var(--text)}
  .btn-knew{background:#052e16;border:1px solid var(--green);color:#86efac}
  .btn-review{background:#2d0c0c;border:1px solid var(--red);color:#fca5a5}
  .keyword-result{margin-top:.85rem;background:var(--surface2);border:1px solid var(--border);
    border-radius:.5rem;padding:.75rem 1rem;font-size:.85rem;display:none}
  .keyword-result .tally{font-family:var(--mono);font-size:1rem;margin-bottom:.5rem;font-weight:600}
  .keyword-result .kw-hit{color:var(--green)}
