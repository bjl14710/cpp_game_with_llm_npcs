architecture sim of tb_linear_regression_predictor is

    constant CLK_PERIOD : time := 10 ns;

    signal clk            : std_logic := '0';
    signal rst_n          : std_logic := '0';
    signal feature_0      : signed(31 downto 0) := (others => '0');
    signal feature_1      : signed(31 downto 0) := (others => '0');
    signal feature_2      : signed(31 downto 0) := (others => '0');
    signal valid_in       : std_logic := '0';
    signal prediction_out : signed(63 downto 0);
    signal valid_out      : std_logic;
    signal signal_out     : std_logic_vector(1 downto 0);

    signal done : boolean := false;

begin

    dut : entity work.linear_regression_predictor
        port map (
            clk            => clk,
            rst_n          => rst_n,
            feature_0      => feature_0,
            feature_1      => feature_1,
            feature_2      => feature_2,
            valid_in       => valid_in,
            prediction_out => prediction_out,
            valid_out      => valid_out,
            signal_out     => signal_out
        );

    clk_gen : process
    begin
        while not done loop
            clk <= '0';
            wait for CLK_PERIOD / 2;
            clk <= '1';
            wait for CLK_PERIOD / 2;
        end loop;
        wait;
    end process clk_gen;

    stimulus : process
    begin
        rst_n <= '0';
        wait until rising_edge(clk);
        wait until rising_edge(clk);
        rst_n <= '1';
        wait until rising_edge(clk);

