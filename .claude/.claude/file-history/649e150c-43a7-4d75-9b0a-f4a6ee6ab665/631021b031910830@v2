        port map (
            clk         => clk,
            rst_n       => rst_n,
            price_in    => price_in,
            valid_in    => valid_in,
            buy_signal  => buy_signal,
            sell_signal => sell_signal,
            valid_out   => valid_out
        );

    clk_gen : process
    begin
        while not done loop
            clk <= '0';
            wait for CLK_PERIOD / 2;
            clk <= '1';
            wait for CLK_PERIOD / 2;
        end loop;
        wait;
    end process clk_gen;

    stimulus : process
    begin
        rst_n <= '0';
        wait until rising_edge(clk);
        wait until rising_edge(clk);
        rst_n <= '1';
        wait until rising_edge(clk);

