/**
 * @file bench.cpp  (solutions/08_latency_bench)
 * @brief Benchmark driver for Exercise 08 — measures rdtsc() overhead.
 *
 * Compile (from repo root):
 *   g++ -std=c++20 -O2 -I solutions/08_latency_bench bench.cpp -o bench_release
 *   g++ -std=c++20 -O0 -I solutions/08_latency_bench bench.cpp -o bench_debug
 *
 * Run and compare:
 *   ./bench_release   # fast path — compiler eliminates dead stores
 *   ./bench_debug     # unoptimized — shows raw instruction cost
 *
 * Fill in your own results table in exercises/08_latency_bench/bench.cpp's
 * README section after running both binaries.
 */
#include "latency.hpp"
#include <cstdio>
#include <ctime>

// ---------------------------------------------------------------------------
// MHz calibration — measure rdtsc ticks per second using CLOCK_MONOTONIC.
// ---------------------------------------------------------------------------
static double calibrate_mhz() {
    struct timespec t0{}, t1{};
    clock_gettime(CLOCK_MONOTONIC, &t0);
    uint64_t c0 = rdtsc();
    // busy-wait ~100 ms
    while (true) {
        clock_gettime(CLOCK_MONOTONIC, &t1);
        uint64_t ns = static_cast<uint64_t>(t1.tv_sec - t0.tv_sec) * 1'000'000'000ULL
                    + static_cast<uint64_t>(t1.tv_nsec - t0.tv_nsec);
        if (ns >= 100'000'000ULL) {
            uint64_t c1 = rdtsc();
            return static_cast<double>(c1 - c0) / static_cast<double>(ns) * 1000.0;
        }
    }
}

int main() {
    // ------------------------------------------------------------------
    // Calibrate
    // ------------------------------------------------------------------
    std::printf("Calibrating CPU frequency...\n");
    double mhz = calibrate_mhz();
    std::printf("  Measured: %.1f MHz\n\n", mhz);

    constexpr int WARMUP = 10'000;
    constexpr int N      = 1'000'000;

    // ------------------------------------------------------------------
    // Warm up the instruction cache
    // ------------------------------------------------------------------
    for (int i = 0; i < WARMUP; ++i) {
        volatile uint64_t dummy = rdtsc();
        (void)dummy;
    }

    // ------------------------------------------------------------------
    // Benchmark 1: rdtsc() overhead (cost of the measurement tool itself)
    // ------------------------------------------------------------------
    Histogram rdtsc_hist;
    for (int i = 0; i < N; ++i) {
        uint64_t t0 = rdtsc();
        uint64_t t1 = rdtsc();
        // compiler barrier prevents reordering across the measured region
        __asm__ volatile("" ::: "memory");
        rdtsc_hist.record(t1 - t0);
    }

    std::printf("rdtsc() overhead (%d samples):\n", N);
    rdtsc_hist.print(mhz);
    std::printf("\n");

    // ------------------------------------------------------------------
    // Benchmark 2: Histogram::record() overhead
    // ------------------------------------------------------------------
    Histogram rec_hist;
    Histogram dummy_hist;
    for (int i = 0; i < N; ++i) {
        uint64_t t0 = rdtsc();
        dummy_hist.record(static_cast<uint64_t>(i));
        __asm__ volatile("" ::: "memory");
        uint64_t t1 = rdtsc();
        rec_hist.record(t1 - t0);
    }

    std::printf("Histogram::record() overhead (%d samples):\n", N);
    rec_hist.print(mhz);
    std::printf("\n");

    std::printf("Done.  Fill in results/README_latency_bench.md with the table.\n");
    return 0;
}
