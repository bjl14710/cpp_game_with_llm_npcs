#pragma once

// textures_proc.hpp — Procedural texture generators.
//
// All textures are 64×64 RGBA, generated in CPU memory and uploaded via
// createTexture() (defined in main.cpp). No image files are loaded from disk.
//
// Noise approach: integer hash (Wang hash variant) seeded per pixel + octave,
// giving a deterministic concrete-like pattern without <random> overhead.
// Each function returns a GLuint handle — caller owns the GL texture object.

#include <SFML/Graphics.hpp>
#include <cstdint>
#include <vector>

// Forward declaration — defined in main.cpp.
unsigned int createTexture(const std::vector<std::uint8_t>& pixels, int size);

// Simple integer hash — maps (x, y, seed) to [0, 255].
// Used by every generator below; not meant to be cryptographic.
inline std::uint8_t hashNoise(int x, int y, int seed) {
    std::uint32_t h = static_cast<std::uint32_t>(x * 1619 + y * 31337 + seed * 6971);
    h = (h ^ (h >> 16)) * 0x45d9f3bU;
    h = (h ^ (h >> 16)) * 0x45d9f3bU;
    h ^= (h >> 16);
    return static_cast<std::uint8_t>(h & 0xFFU);
}

