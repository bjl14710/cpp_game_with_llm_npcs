// Concrete wall texture: grey base with subtle noise grain.
// Used for load-bearing walls and ceilings.
// TODO(impl): fill pixels using smoothNoise(); base colour sf::Color(105,102,98).
inline unsigned int makeConcreteTexture() {
    constexpr int kSize = 64;
    std::vector<std::uint8_t> pixels(kSize * kSize * 4, 255);
    for (int y = 0; y < kSize; ++y) {
        for (int x = 0; x < kSize; ++x) {
            // TODO(impl): compute noise, mix with base concrete colour, write RGBA.
            const int i = (y * kSize + x) * 4;
            pixels[i + 0] = 105; // R — placeholder flat colour
            pixels[i + 1] = 102; // G
            pixels[i + 2] = 98;  // B
            pixels[i + 3] = 255;
        }
    }
    return createTexture(pixels, kSize);
}

// Brick wall texture: alternating mortar lines with row offset.
// Used for site-area walls and T-spawn. Row height = 10 px, mortar = 2 px.
// TODO(impl): implement the row-offset brick pattern and grout lines.
inline unsigned int makeBrickTexture() {
    constexpr int kSize = 64;
    constexpr int kBrickH  = 10;  // brick height in pixels
    constexpr int kMortarW = 2;   // mortar line thickness
    constexpr int kBrickW  = 32;  // brick width in pixels
    std::vector<std::uint8_t> pixels(kSize * kSize * 4, 255);
    for (int y = 0; y < kSize; ++y) {
        for (int x = 0; x < kSize; ++x) {
            const int i = (y * kSize + x) * 4;
            const int row  = y / kBrickH;
            const int rowY = y % kBrickH;
            // Row offset: odd rows shift bricks by half width.
            const int offset  = (row % 2) * (kBrickW / 2);
            const int brickX  = (x + offset) % kBrickW;
            const bool mortar = (rowY < kMortarW) || (brickX < kMortarW);
            // TODO(impl): add hashNoise() grain to brick and mortar colours.
            if (mortar) {
                pixels[i + 0] = 78;
                pixels[i + 1] = 74;
                pixels[i + 2] = 70;
            } else {
                pixels[i + 0] = 162;
                pixels[i + 1] = 94;
                pixels[i + 2] = 68;
            }
            pixels[i + 3] = 255;
        }
    }
    return createTexture(pixels, kSize);
}

// Brushed metal texture: horizontal streaks with hash grain.
// Used for cover objects, railings, and door frames.
// TODO(impl): layer horizontal streak lines over a steel-grey base + hashNoise().
inline unsigned int makeMetalTexture() {
    constexpr int kSize = 64;
    std::vector<std::uint8_t> pixels(kSize * kSize * 4, 255);
    for (int y = 0; y < kSize; ++y) {
        for (int x = 0; x < kSize; ++x) {
            const int i = (y * kSize + x) * 4;
            // Horizontal streak: every ~6 rows a slightly lighter band.
            const bool streak = (y % 6) < 2;
            // TODO(impl): add hashNoise(x, y, 42) grain scaled ±8 on top.
            const std::uint8_t base = streak ? 130 : 100;
            pixels[i + 0] = base;
            pixels[i + 1] = base;
            pixels[i + 2] = static_cast<std::uint8_t>(base + 8);
            pixels[i + 3] = 255;
        }
    }
    return createTexture(pixels, kSize);
}

