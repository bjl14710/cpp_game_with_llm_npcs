# Final CMakeLists.txt shape (reached incrementally across commits 3, 4, 17).
cmake_minimum_required(VERSION 3.20)
project(cpp_game_with_llm_npcs LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

find_package(Threads REQUIRED)

# Core: SFML-free game logic; this is everything the unit tests cover.
add_library(llm_npc_core STATIC
    src/core/City.cpp
    src/core/Config.cpp
    src/core/DialogueSession.cpp
    src/core/KeyBindings.cpp
    src/core/LlmClient.cpp
    src/core/Npc.cpp
    src/core/PersonaLoader.cpp
    src/core/World.cpp
)
target_include_directories(llm_npc_core PUBLIC
    ${CMAKE_CURRENT_SOURCE_DIR}/src/core
    ${CMAKE_CURRENT_SOURCE_DIR}/external
)
target_link_libraries(llm_npc_core PUBLIC Threads::Threads)
if(WIN32)
    # httplib needs winsock when built with MinGW.
    target_link_libraries(llm_npc_core PUBLIC ws2_32)
endif()

# Game executable: requires SFML + OpenGL, so it is skipped automatically on
# headless build machines (the dev container builds core + tests only).
find_package(SFML 2.6 COMPONENTS graphics window system QUIET)
find_package(OpenGL QUIET)
if(SFML_FOUND AND OPENGL_FOUND)
    add_executable(cpp_game_with_llm_npcs
        src/app/main.cpp
        src/app/DialogUI.cpp
        src/app/InputMap.cpp
        src/app/Menu.cpp
        src/app/Renderer3D.cpp
    )
    target_include_directories(cpp_game_with_llm_npcs PRIVATE
        ${CMAKE_CURRENT_SOURCE_DIR}/src/app
    )
    target_link_libraries(cpp_game_with_llm_npcs
        PRIVATE
            llm_npc_core
            sfml-graphics
            sfml-window
            sfml-system
            OpenGL::GL
    )
else()
    message(STATUS "SFML or OpenGL not found; building core library and tests only")
endif()

# Unit tests (doctest, vendored in external/).
enable_testing()
# The glob picks up tests/test_main.cpp (the doctest runner) too.
file(GLOB LLM_NPC_TEST_SOURCES ${CMAKE_CURRENT_SOURCE_DIR}/tests/test_*.cpp)
add_executable(core_tests ${LLM_NPC_TEST_SOURCES})
target_include_directories(core_tests PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/tests)
target_link_libraries(core_tests PRIVATE llm_npc_core)
add_test(NAME core_tests COMMAND core_tests)
