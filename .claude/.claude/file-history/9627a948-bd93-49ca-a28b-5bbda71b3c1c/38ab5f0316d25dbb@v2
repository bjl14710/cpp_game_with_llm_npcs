<script>
// ═══════════════════════════════════════════════════════════
// QUESTION BANK — 20 questions, 7 MC + 13 written
// ═══════════════════════════════════════════════════════════
const BANK = [

// ─── FOLDERS ────────────────────────────────────────────
{id:'fo1',ch:'folders',type:'w',
 q:'Describe the role of each of the two key folders. What goes in each, and what is the critical difference in how Silmulator treats them?',
 c:[{l:'hardware_docs/ — vendor PDFs, manuals, scpi_commands.md (reference only, not auto-loaded)',t:['hardware_docs','reference','pdf','manual','not auto','not parsed']},
    {l:'custom_blocks/ — JSON specs auto-discovered at startup and registered in BLOCK_REGISTRY',t:['custom_blocks','json','auto','startup','block_registry','executable']}],
 m:`hardware_docs/ is the offline reference library. Drop vendor PDFs, programmer's references, and extracted SCPI command tables here. Nothing in this folder runs automatically — Silmulator does not parse or load these files at startup. They exist so engineers on a lab bench can consult the original docs without leaving the project, and they ship inside Docker images and installers for offline use.
custom_blocks/ is the executable layer. Every .json file here is auto-discovered by discover_specs() at startup and registered in BLOCK_REGISTRY. The block appears in the Add menu immediately on next launch — no Python required.`
},

{id:'fo2',ch:'folders',type:'mc',
 q:'A team-mate adds a Tektronix TBS series PDF to the repo. Where do they put it so it ships with the Docker image AND the custom-block wizard can find it later?',
 opts:[
  {t:'hardware_docs/tektronix/TBS/programmer_reference.pdf — reference folder by vendor/model, included in the Docker build.',c:true,
   w:'Correct. hardware_docs/ follows the vendor/model subfolder convention and is included in the Docker build context. The wizard reads scpi_commands.md from this tree; long-form PDFs live here for offline reference.'},
  {t:'silmulator/custom_blocks/tektronix_tbs.pdf — custom_blocks/ is where all device artifacts live so discover_specs() finds them.',c:false,
   w:'discover_specs() only reads .json files. A PDF in custom_blocks/ would be ignored by the discovery logic and would clutter the spec directory.'},
  {t:'docs/learning/tektronix/ — the docs/learning/ folder is Silmulator\'s primary document store for external references.',c:false,
   w:'docs/learning/ is the teaching workspace for this lesson system (lessons, drills, PROGRESS.md). It has no connection to hardware device reference material.'},
  {t:'silmulator/devices/tektronix/ — device-related files belong next to the Python device classes.',c:false,
   w:'silmulator/devices/ holds Python device classes (power_supply.py, oscilloscope.py, etc.). PDFs don\'t belong here — they\'re not code and would not be loaded by any discovery mechanism.'},
 ]
},

{id:'fo3',ch:'folders',type:'w',
 q:'What is the scpi_commands.md file convention and why is it more useful to the custom-block wizard than the full PDF?',
 c:[{l:'extracted command table in markdown',t:['markdown','table','extracted','command table','cleaned']},
    {l:'wizard reads it first to pre-fill JSON spec',t:['wizard','pre-fill','reads first','autofill','populate']},
    {l:'PDF is not machine-parseable / too large / offline reference only',t:['pdf not parsed','too large','not parseable','raw pdf','offline']}],
 m:`scpi_commands.md is a hand-extracted markdown table of the commands you plan to test, placed in the same hardware_docs/vendor/model/ folder as the PDF. The custom-block wizard reads it first when it exists.
Format: a markdown table with columns for command name, direction (write/query), and response/notes.
Why more useful than the PDF: PDFs are binary, hundreds of pages, with images and tables that are not machine-parseable. The markdown file is a short, structured, text-based summary of just the commands relevant to your test — the wizard can extract the command list directly from it to pre-fill the JSON spec's "commands" object, saving manual transcription.`
},

// ─── JSON SPEC ──────────────────────────────────────────
{id:'sp1',ch:'spec',type:'w',
 q:'List the six top-level fields of a JSON spec and give the type and purpose of each.',
 snip:`{
    <span class="k2">"name"</span>:         <span class="str">"My Device"</span>,
    <span class="k2">"manufacturer"</span>: <span class="str">"Acme"</span>,
    <span class="k2">"model"</span>:        <span class="str">"AX-1000"</span>,
    <span class="k2">"color"</span>:        <span class="str">"#336699"</span>,
    <span class="k2">"ports"</span>:        [...],
    <span class="k2">"commands"</span>:     {...}
}`,
 c:[{l:'name — string, key in BLOCK_REGISTRY and palette display name',t:['name','registry','palette','display']},
    {l:'manufacturer + model — shown on block face and in *IDN? response',t:['manufacturer','model','block face','idn']},
    {l:'color — CSS hex, becomes block BODY_COLOR',t:['color','hex','body_color','css']},
    {l:'ports — array of {id, label, x, y} objects',t:['ports','array','id','label','x','y']},
    {l:'commands — object mapping SCPI key to response string',t:['commands','map','scpi','response','object']},
   ],
 m:`name (string) — the BLOCK_REGISTRY key and what appears in the Add menu / block palette. Must be unique.
manufacturer (string) — shown on the block's face and used in the *IDN? response string.
model (string) — shown on the block's face alongside manufacturer; also in *IDN?.
color (string) — any CSS hex color (e.g. "#336699"). Becomes the block's body color (lighter/darker variants are derived from it).
ports (array) — list of port objects, each with {id, label, x, y} where x and y are fractions of block width/height.
commands (object) — maps SCPI command strings (keys) to response strings (values). Keys are normalized to uppercase by BlockSpec.from_dict().`
},

{id:'sp2',ch:'spec',type:'mc',
 q:'You want an input port on the left edge at the one-third vertical mark, and an output port on the right edge at the two-thirds vertical mark. What are the correct x and y values?',
 opts:[
  {t:'IN: x=0.0, y=0.33 · OUT: x=1.0, y=0.67 — left/right edges, fractional vertical positions.',c:true,
   w:'Correct. x=0.0 is the left edge (BLOCK_WIDTH × 0.0 = 0), x=1.0 is the right edge (BLOCK_WIDTH × 1.0 = 220). y=0.33 is one-third down the block height, y=0.67 is two-thirds. All are fractions of block dimensions.'},
  {t:'IN: x=0, y=33 · OUT: x=220, y=107 — add_port() uses pixel coordinates, not fractions.',c:false,
   w:'add_port() does the multiplication: setPos(BLOCK_WIDTH * x_frac, BLOCK_HEIGHT * y_frac). You pass fractions (0.0–1.0), not pixels. The conversion happens inside add_port().'},
  {t:'IN: x=0.0, y=0.67 · OUT: x=1.0, y=0.33 — y increases upward in Qt\'s coordinate system.',c:false,
   w:'Qt\'s coordinate system has y increasing DOWNWARD (origin at top-left). y=0.0 is the top, y=1.0 is the bottom. One-third down = 0.33, two-thirds down = 0.67.'},
  {t:'IN: x=0.5, y=0.0 · OUT: x=0.5, y=1.0 — ports must be on top/bottom edges to avoid block overlap.',c:false,
   w:'Ports can be placed anywhere on the block perimeter (or even inside it). x=0.0 and x=1.0 are the conventional left and right edge positions, not invalid choices.'},
 ]
},

{id:'sp3',ch:'spec',type:'w',
 q:'What does BlockSpec.from_dict() do to command keys? Write the exact Python expression used (line 88 of custom_block.py) and explain why it matters for dispatch.',
 snip:`<span class="fl">88</span>commands={<span class="fn">str</span>(k).<span class="fn">upper</span>(): <span class="fn">str</span>(v) <span class="kw">for</span> k, v <span class="kw">in</span> data.<span class="fn">get</span>(<span class="str">"commands"</span>, {}).<span class="fn">items</span>()},`,
 c:[{l:'str(k).upper() — uppercases every command key',t:['upper','uppercase','str(k)','upper()']},
    {l:'ScpiParser also normalizes to uppercase before dispatch',t:['scpiparser','normalize','dispatch','path','uppercase path']},
    {l:'allows lowercase JSON keys to match correctly',t:['lowercase','case insensitive','match','allows','regardless of case']}],
 m:`Expression: {str(k).upper(): str(v) for k, v in data.get("commands", {}).items()}
This dict comprehension builds the commands dictionary with ALL keys forced to uppercase.
Why it matters: ScpiParser.parse() normalizes the SCPI path to uppercase before dispatching. The _CustomDevice handler table is keyed by these normalized paths. If a JSON author writes "volt" (lowercase), from_dict() stores it as "VOLT". When the firmware sends "VOLT 5.0", ScpiParser produces path="VOLT", and the handler lookup _handlers.get("VOLT") succeeds. Without this normalization, lowercase JSON keys would never match.`
},

{id:'sp4',ch:'spec',type:'mc',
 q:'A JSON spec\'s block height is computed as <code>max(120, 40 + 20 × max(1, len(spec.ports)))</code>. A spec has 4 ports. What is the block height?',
 opts:[
  {t:'120 px — max(120, 40 + 20 × 4) = max(120, 120) = 120.',c:true,
   w:'Correct. 40 + 20 × 4 = 40 + 80 = 120. max(120, 120) = 120. The formula ensures a minimum of 120 px and adds 20 px per port above the first.'},
  {t:'160 px — 40 + 20 × 4 = 120, plus the TITLE_HEIGHT of 40 px gives 160.',c:false,
   w:'TITLE_HEIGHT is NOT added here — that\'s a separate rendering concept. The formula is max(120, 40 + 20 × port_count) and nothing else. For 4 ports: max(120, 120) = 120.'},
  {t:'80 px — 40 + 20 × max(1, 4) = 40 + 80 = 120, clamped below 120 to the base size of 80.',c:false,
   w:'The clamp is a MINIMUM, not a maximum. max(120, ...) ensures the height is AT LEAST 120. There is no 80 px default.'},
  {t:'140 px — 40 + 20 × (4 + 1) = 40 + 100 = 140, using port_count + 1 for the title row.',c:false,
   w:'There is no "+1" for the title row in the formula. It\'s simply max(120, 40 + 20 × max(1, len(spec.ports))). For 4 ports: max(120, 120) = 120.'},
 ]
},

// ─── RESPONSE PATTERNS ──────────────────────────────────
{id:'re1',ch:'resp',type:'w',
 q:'Describe the three response types in a JSON spec commands dict. For each, give the rule and a concrete example.',
 c:[{l:'literal — no { in value → return value as-is',t:['literal','no {','as-is','static string','always return']},
    {l:'empty — empty string → write-only, no response',t:['empty','write-only','no response','""']},
    {l:'template — contains { → substitute cmd.params via .format()',t:['template','{0}','format','param','substitut']}],
 m:`Literal: the response value has no "{" character. _make_handler() returns the string as-is on every call. Example: "PING": "pong" → send PING → response is always "pong".
Empty: the response value is an empty string (""). _make_handler() returns "" (no response emitted). Used for write-only commands. Example: "VOLT": "" → send VOLT 5.0 → no response.
Template: the response value contains "{" (e.g. "{0}"). _make_handler() calls template.format(*cmd.params) to substitute SCPI parameters. Example: "ECHO": "echo:{0}" → send ECHO hello → response is "echo:hello". "{0}" is the first parameter, "{1}" the second, etc.`
},

{id:'re2',ch:'resp',type:'mc',
 q:'A JSON spec has <code>"STATUS?": "OK"</code>. Firmware sends <code>STATUS?</code>. Walk through the dispatch path.',
 snip:`<span class="cm"># custom_block.py:108–111</span>
<span class="kw">def</span> <span class="fn">_setup_handlers</span>(self) -> <span class="cls">None</span>:
    <span class="kw">for</span> cmd_path, response_template <span class="kw">in</span> self._spec.commands.<span class="fn">items</span>():
        normalized = cmd_path.<span class="fn">rstrip</span>(<span class="str">"?"</span>)           <span class="cm"># line 110</span>
        self.<span class="fn">_register</span>(normalized, <span class="fn">_make_handler</span>(response_template))`,
 opts:[
  {t:'from_dict() stores key as "STATUS" (upper, no ?). ScpiParser strips "?" → path="STATUS". Handler lookup "STATUS" → returns "OK".',c:true,
   w:'Correct. from_dict() uppercases: "STATUS?" → key "STATUS?" in the commands dict. _setup_handlers() then calls rstrip("?") → "STATUS" as the registration path. ScpiParser processes "STATUS?" → path="STATUS", is_query=True. _handlers["STATUS"](cmd) returns "OK".'},
  {t:'from_dict() stores "STATUS?" as-is. ScpiParser strips "?" → "STATUS". Handler lookup fails — no "STATUS" key, only "STATUS?".',c:false,
   w:'_setup_handlers() calls cmd_path.rstrip("?") before registering. So "STATUS?" becomes registration path "STATUS". The lookup succeeds.'},
  {t:'ScpiParser does not strip "?" — is_query is set as a bool flag, but the path stays "STATUS?". Handler lookup "STATUS?" succeeds.',c:false,
   w:'ScpiParser.parse() does strip the "?" from the path. The path field of ScpiCommand is always the command string without the trailing "?". is_query=True when the "?" was present.'},
  {t:'"STATUS?" in the JSON is treated as a query command specifically; write commands without "?" use a separate handler table.',c:false,
   w:'There is only one handler table (_handlers). Both writes and queries go through the same lookup by normalized path. The distinction is the is_query flag on ScpiCommand, not separate tables.'},
 ]
},

{id:'re3',ch:'resp',type:'w',
 q:'A spec has <code>"SCALE": "x{0}:{1}"</code>. Firmware sends <code>SCALE 2 V</code>. ScpiParser produces params=["2", "V"]. What is the response?',
 c:[{l:'x2:V',t:['x2:v','x2:V']},
    {l:'{0} substituted with "2", {1} substituted with "V"',t:['{0}','substitut','format','params[0]','params[1]']}],
 m:`Response: "x2:V"
_make_handler("x{0}:{1}") detects "{" in the template, calls "x{0}:{1}".format("2", "V"). Python's str.format() substitutes positional placeholders: {0} → "2", {1} → "V". Result: "x2:V".`
},

{id:'re4',ch:'resp',type:'mc',
 q:'_make_handler() catches IndexError and KeyError when calling template.format(*cmd.params). What does it return in that case?',
 opts:[
  {t:'The template string as-is (e.g. "echo:{0}") — it falls back to the literal template rather than raising.',c:true,
   w:'Correct. Lines 122-123: except (IndexError, KeyError): return template. If params don\'t have enough elements (IndexError) or a named placeholder is missing (KeyError), the template is returned unchanged as a fallback.'},
  {t:'An empty string — failed substitution is treated the same as a write-only command.',c:false,
   w:'The empty-string path is checked on line 117 (if not template: return ""). A failed .format() falls through to the except clause on line 122, which returns the TEMPLATE, not "".'},
  {t:'A SCPI error string like "-113,\\"Undefined header\\""  — the device error queue is used for substitution failures.',c:false,
   w:'Error queue entries are used by BaseDevice._sys_error() for SYSTEM:ERROR queries. _make_handler() is a standalone function outside BaseDevice; it doesn\'t have access to the error queue and doesn\'t push errors.'},
  {t:'None — Python re-raises the exception, and BaseDevice.process() catches it and returns "".',c:false,
   w:'_make_handler() explicitly catches IndexError and KeyError and returns the template. The exception does not propagate to BaseDevice.process().'},
 ]
},

// ─── PIPELINE ───────────────────────────────────────────
{id:'pi1',ch:'pipe',type:'w',
 q:'Walk through the three functions that run during Silmulator startup to turn JSON files into palette blocks. Name each function, what it does, and what it returns.',
 c:[{l:'discover_specs() — scans directories, parses JSON → list of BlockSpec objects',t:['discover_specs','scan','parse','blockspec','list']},
    {l:'make_custom_block_class() — creates a dynamic BaseBlock subclass from a BlockSpec → class',t:['make_custom_block_class','dynamic','subclass','baseblock','type','class']},
    {l:'register_custom_blocks() — puts the class in BLOCK_REGISTRY under spec.name',t:['register_custom_blocks','registry','block_registry','spec.name','populate']},
   ],
 m:`1. discover_specs(extra_dirs=None): scans PACKAGED_DIR (silmulator/custom_blocks/) then USER_DIR (~/.silmulator/custom_blocks/) for .json files (alphabetical). Calls BlockSpec.from_file() on each. Skips broken files (try/except Exception: continue). Skips duplicate names (first-seen wins). Returns a List[BlockSpec].
2. make_custom_block_class(spec): called once per spec. Creates a new class dynamically (class _Block(BaseBlock):) with BLOCK_WIDTH/HEIGHT from the spec, _setup_ports() from spec.ports, and _paint_content() showing manufacturer/model/counts. Sets __name__ to Custom_<name>. Returns the class (a type object).
3. register_custom_blocks(registry, extra_dirs=None): calls discover_specs(), then for each spec calls make_custom_block_class() and stores the result as registry[spec.name]. Returns the list of specs.`
},

{id:'pi2',ch:'pipe',type:'mc',
 q:'Which two directories does discover_specs() scan when called with no arguments, and in what order?',
 opts:[
  {t:'silmulator/custom_blocks/ first, then ~/.silmulator/custom_blocks/ — packaged before user.',c:true,
   w:'Correct. Lines 175-177: PACKAGED_DIR is appended first, USER_DIR second. discover_specs() processes dirs in the order they appear in the list, so packaged specs are seen before user specs, making the packaged name win on duplicates.'},
  {t:'~/.silmulator/custom_blocks/ first, then silmulator/custom_blocks/ — user overrides packaged.',c:false,
   w:'The order is packaged first, user second (lines 176-177). This means the packaged name wins on a collision, not the user name.'},
  {t:'hardware_docs/ for SCPI tables, then silmulator/custom_blocks/ for full JSON specs.',c:false,
   w:'discover_specs() only scans for .json files in custom_blocks directories. hardware_docs/ is a reference folder that discover_specs() never reads.'},
  {t:'silmulator/custom_blocks/ and ~/.silmulator/custom_blocks/ simultaneously — both are merged and sorted by name.',c:false,
   w:'The dirs are processed sequentially in the order they appear in the dirs list, not simultaneously. First-seen wins, so order matters.'},
 ]
},

{id:'pi3',ch:'pipe',type:'w',
 q:'What does make_custom_block_class() set as the Python class name (__name__ and __qualname__), and why does it matter?',
 snip:`<span class="fl">161</span>_Block.__name__ = <span class="str">f"Custom_{spec.name.replace(' ', '_')}"</span>
<span class="fl">162</span>_Block.__qualname__ = _Block.__name__`,
 c:[{l:'"Custom_" + spec.name with spaces replaced by underscores',t:['custom_','underscore','replace space','replace',' _']},
    {l:'makes repr/debugger output meaningful instead of "<class _Block>"',t:['repr','debug','meaningful','readable','instead of _block']}],
 m:`The class gets __name__ = f"Custom_{spec.name.replace(' ', '_')}". For a spec with name="My Device", this produces "Custom_My_Device".
Without this, every custom block class would have __name__ = "_Block" (the inner class name) — all identical. This matters for:
- Debugging: repr(block) shows the meaningful class name.
- Test output: failing tests show "Custom_My_Device failed" not "_Block failed".
- PyInstaller/pickle: class names must be unique for serialization to work correctly.
__qualname__ is set to the same value for consistency (some introspection tools use qualname over name).`
},

// ─── TRAPS ──────────────────────────────────────────────
{id:'tr1',ch:'traps',type:'mc',
 q:'You drop <code>broken.json</code> (invalid JSON syntax) and <code>good.json</code> (valid spec) into <code>silmulator/custom_blocks/</code>. What does the GUI show at startup?',
 opts:[
  {t:'Only good.json\'s block appears. broken.json is silently skipped; discover_specs() catches the exception and continues.',c:true,
   w:'Correct. discover_specs() wraps each file in try/except Exception: continue (lines 185-188). A parse error in broken.json is caught and that spec is skipped. Processing continues with good.json. The outer try/except in canvas.py (lines 40-43) is an additional safety net but is not needed here.'},
  {t:'Neither block appears — register_custom_blocks() fails atomically when any spec raises an exception.',c:false,
   w:'discover_specs() processes files individually with try/except. A failure in one file doesn\'t affect others. The loop continues to the next file after a failed parse.'},
  {t:'good.json\'s block appears but Silmulator shows a warning dialog listing broken.json as a parse error.',c:false,
   w:'discover_specs() silently skips bad files — there is no logging, no dialog, no error.log written. Failures are non-fatal and non-visible.'},
  {t:'Both blocks appear — Silmulator loads broken.json as a partial spec using whatever fields could be parsed.',c:false,
   w:'json.load() on syntactically invalid JSON raises json.JSONDecodeError immediately. No partial loading occurs. The except clause in discover_specs() catches it and skips the file entirely.'},
 ]
},

{id:'tr2',ch:'traps',type:'w',
 q:'You have "My Block" in silmulator/custom_blocks/a.json and also in ~/.silmulator/custom_blocks/b.json. Which spec is used and why? What happens to the other?',
 c:[{l:'packaged version (silmulator/custom_blocks/) wins — scanned first',t:['packaged','first','silmulator/custom_blocks','wins first','discovered first']},
    {l:'user version is silently skipped (first-seen wins via seen_names set)',t:['skip','seen_names','user','second','silently','ignored']}],
 m:`The PACKAGED version (silmulator/custom_blocks/a.json) wins.
discover_specs() appends PACKAGED_DIR to the scan list first (line 176), then USER_DIR (line 177). When it processes silmulator/custom_blocks/a.json and finds name="My Block", it adds "My Block" to seen_names. When it later reads ~/.silmulator/custom_blocks/b.json and gets the same name, line 189 fires: if spec.name in seen_names: continue — the user spec is silently skipped.
The user dir is intended for adding NEW blocks, not overriding packaged ones. To override, rename your user spec to something unique or modify the packaged spec directly.`
},

{id:'tr3',ch:'traps',type:'w',
 q:'Your JSON spec has "name" missing. What happens during discover_specs() and why?',
 snip:`<span class="fl">73</span><span class="kw">if</span> <span class="str">"name"</span> <span class="kw">not in</span> data:
<span class="fl">74</span>    <span class="kw">raise</span> <span class="cls">ValueError</span>(<span class="str">f"custom block spec missing 'name': {source}"</span>)`,
 c:[{l:'BlockSpec.from_dict() raises ValueError',t:['valueerror','raises','value error','missing name']},
    {l:'discover_specs() catches it (except Exception: continue) and skips the file',t:['caught','except','continue','skip','silently']}],
 m:`BlockSpec.from_dict() checks for "name" on line 73 and raises ValueError if it's absent. This propagates up to discover_specs() which has a try/except Exception: continue around the from_file() call. The ValueError is caught, the file is skipped silently, and processing continues with the next .json file. No block is registered. No error is shown in the GUI. The fix is simple: add a "name" field to the spec.`
},

{id:'tr4',ch:'traps',type:'mc',
 q:'A spec has <code>"MUL": "{0}×{1}"</code>. Firmware sends <code>MUL 7</code> — only one param. What does the block return?',
 opts:[
  {t:'The template string "{{0}}×{{1}}" as-is — IndexError is raised when accessing params[1], caught, and the template is returned.',c:false,
   w:'Close. The template IS returned, but not with doubled braces. _make_handler() catches IndexError and returns the template variable as-is: "{0}×{1}". The curly braces are not escaped in the returned value.'},
  {t:'"{0}×{1}" — IndexError on params[1] is caught; the raw template string is returned unchanged.',c:true,
   w:'Correct. "x{0}:{1}".format("7") raises IndexError because params[1] doesn\'t exist. The except (IndexError, KeyError): return template clause (line 122-123) returns the template string "{0}×{1}" unchanged.'},
  {t:'An empty string — IndexError is caught and _make_handler() falls back to the write-only path.',c:false,
   w:'The empty-string return (line 117) only fires when the template IS the empty string. A non-empty template that fails .format() returns the template string, not "".'},
  {t:'"7×" — format() partially substitutes {0} before failing on {1} and returns what it has so far.',c:false,
   w:'Python\'s str.format() doesn\'t partially substitute. It raises IndexError before returning anything. The try/except catches this and returns the full template string.'},
 ]
},

// ─── SPEC VS PYTHON ─────────────────────────────────────
{id:'sv1',ch:'svp',type:'w',
 q:'A firmware engineer needs to test that after sending FREQ 1E6, a subsequent FREQ? returns 1000000.0. Can they use a JSON spec? What\'s missing and what\'s the upgrade path?',
 c:[{l:'JSON spec cannot store state — no variables or memory between commands',t:['no state','cannot store','static','no memory','literal only']},
    {l:'FREQ? would return a hardcoded literal, not the last-set value',t:['hardcoded','literal','last-set','cannot return what was set','not dynamic']},
    {l:'upgrade: Python subclass with instance variable to track the frequency',t:['python subclass','instance variable','upgrade','track','_freq','state variable']}],
 m:`No — JSON specs cannot implement this. A spec's response is always a static literal, empty string, or simple parameter echo. There is no way to store state between commands: when FREQ 1E6 is received (with response ""), nowhere in the JSON layer can the value 1E6 be remembered. When FREQ? is sent, the literal response must be hardcoded (e.g. "1000000.0") and will not reflect whatever VOLT was last set.
The upgrade path: promote to a Python subclass of BaseDevice. Add self._freq = 1000000.0 as an instance variable. The FREQ write handler updates it; the FREQ query handler returns str(self._freq). Start with the JSON spec to verify the firmware sends commands in the right format, then promote to Python when stateful responses are needed.`
},

{id:'sv2',ch:'svp',type:'mc',
 q:'Which capability does a JSON spec have that a Python subclass does NOT without extra boilerplate?',
 opts:[
  {t:'Per-user installation: dropping a JSON in ~/.silmulator/custom_blocks/ adds the block without any repo change.',c:true,
   w:'Correct. JSON specs support a two-path discovery: packaged (silmulator/custom_blocks/) and user (~/.silmulator/custom_blocks/). A Python subclass must be imported in canvas.py to appear in BLOCK_REGISTRY — a code change that requires modifying the repo.'},
  {t:'Stateful simulation: JSON specs maintain a command history and replay it on query.',c:false,
   w:'JSON specs have no state. Every command response is a static lookup: literal, empty, or template. Stateful simulation requires Python instance variables.'},
  {t:'Computed responses: JSON templates can evaluate math expressions at runtime.',c:false,
   w:'JSON templates use Python\'s str.format() with positional parameters — simple string substitution only. They cannot evaluate math, call functions, or do any computation.'},
  {t:'IEEE 488.2 common commands: JSON specs inherit *IDN?, *RST, etc. from SCPI standard auto-registration.',c:false,
   w:'IEEE 488.2 common commands come from BaseDevice._setup_common_handlers(), which Python subclasses inherit automatically. JSON specs must manually add "*IDN?" etc. to their commands dict.'},
 ]
},

{id:'sv3',ch:'svp',type:'w',
 q:'A built-in block like PowerSupplyBlock can return a slightly noisy measurement on MEAS:VOLT:DC?. Why can\'t a JSON spec do this, and what class hierarchy makes it possible in Python?',
 c:[{l:'JSON spec returns static literal — no math or noise possible',t:['static','literal','no math','no noise','no computation']},
    {l:'Python subclass overrides _setup_handlers() with a function that adds Gaussian noise',t:['_setup_handlers','python subclass','handler function','gaussian','noise','compute']},
    {l:'_CustomDevice / BaseDevice hierarchy — process() dispatches to handler functions',t:['basedevice','process','handler','_handlers dict','dispatch']}],
 m:`A JSON spec can only produce the three response types (literal, empty, template). Template substitution uses str.format() — there's no way to call math.gauss(), access self._voltage, or compute anything dynamic.
Python makes it possible via the class hierarchy: PowerSupplyBlock subclasses BaseBlock, which holds a PowerSupply device. PowerSupply subclasses BaseDevice, and in _setup_handlers() it registers a Python function as the handler for "MEAS:VOLT:DC". That function does: return str(self._voltage + random.gauss(0, self._voltage * 1e-5)). When BaseDevice.process() dispatches the command, it calls this function — which can access self state and compute arbitrary values.`
},

