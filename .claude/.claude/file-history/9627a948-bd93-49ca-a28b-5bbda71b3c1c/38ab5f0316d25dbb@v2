// ═══════════════════════════════════════════════════════════
const CHS=['folders','spec','resp','pipe','traps','svp'];
let active=new Set(CHS),qs=[],idx=0,saved={},mcR={},wR={};

document.querySelectorAll('.chip:not(.all)').forEach(c=>{
  c.addEventListener('click',()=>{
    const ch=c.dataset.ch;
    active.has(ch)?active.delete(ch):active.add(ch);
    c.classList.toggle('on',active.has(ch));
    document.querySelector('.chip.all').classList.toggle('on',active.size===CHS.length);
    upMeta();
  });
});
document.querySelector('.chip.all').addEventListener('click',()=>{
  const allOn=active.size===CHS.length;
  allOn?active.clear():CHS.forEach(c=>active.add(c));
  document.querySelectorAll('.chip:not(.all)').forEach(c=>c.classList.toggle('on',!allOn));
  document.querySelector('.chip.all').classList.toggle('on',!allOn);
  upMeta();
});
function upMeta(){const n=BANK.filter(q=>active.has(q.ch)).length;document.getElementById('smeta').textContent=`${n} question${n===1?'':'s'} selected`;}
function shuf(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
function go(){qs=BANK.filter(q=>active.has(q.ch));if(document.getElementById('sh').checked)shuf(qs);if(!qs.length)return;idx=0;saved={};mcR={};wR={};show('Q');render();}
function show(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active');}
function render(){
  const q=qs[idx],n=qs.length;
  document.getElementById('qn').textContent=`Q ${idx+1} / ${n}`;
  document.getElementById('pf').style.width=((idx+1)/n*100)+'%';
  document.getElementById('ct').textContent=q.ch;
  const tt=document.getElementById('tt');tt.textContent=q.type==='mc'?'MC':'Written';tt.className='ttag '+(q.type==='mc'?'mc':'wr');
  document.getElementById('qt').innerHTML=q.q;
  const sn=document.getElementById('qs');if(q.snip){sn.style.display='block';sn.innerHTML=q.snip;}else sn.style.display='none';
  document.getElementById('MA').style.display=q.type==='mc'?'block':'none';
  document.getElementById('WA').style.display=q.type!=='mc'?'block':'none';
  q.type==='mc'?renderMC(q):renderW(q);
  document.getElementById('bp').disabled=idx===0;
  const last=idx===n-1;
  document.getElementById('bn').style.display=last?'none':'inline-block';
  document.getElementById('bf').style.display=last?'inline-block':'none';
}
function renderMC(q){
  const list=document.getElementById('mo');list.innerHTML='';
  const fb=document.getElementById('mf');fb.style.display='none';
  const prev=mcR[q.id];
  shuf([...q.opts]).forEach(o=>{
    const li=document.createElement('li');li.tabIndex=0;
    li.dataset.correct=o.c?'true':'false';li.dataset.why=o.w;li.textContent=o.t;
    if(prev)li.classList.add('lk');
    li.addEventListener('click',()=>{
      if(li.classList.contains('lk'))return;
      list.querySelectorAll('li').forEach(x=>x.classList.add('lk'));
      const ok=li.dataset.correct==='true';
      li.classList.add(ok?'ok':'no');
      if(!ok)list.querySelector('[data-correct="true"]')?.classList.add('ok');
      mcR[q.id]=ok?'ok':'no';
      fb.style.display='block';fb.className='mfb '+(ok?'ok':'no');
      fb.textContent=(ok?'✓ Correct. ':'✗ Not quite. ')+li.dataset.why;
    });
    li.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' ')li.click();});
    list.appendChild(li);
  });
  if(prev){fb.style.display='block';fb.className='mfb '+(prev==='ok'?'ok':'no');fb.textContent=prev==='ok'?'✓ Marked correct.':'✗ Marked incorrect.';}
}
function renderW(q){
  const sv=saved[q.id]||{};
  document.getElementById('wa').value=sv.t||'';
  const kr=document.getElementById('kr');kr.style.display=sv.kr?'block':'none';
  if(sv.kr){document.getElementById('kt').innerHTML=sv.kr.tally;document.getElementById('kc').innerHTML=sv.kr.chips;}
  document.getElementById('md').style.display=sv.ms?'block':'none';
  if(sv.ms)document.getElementById('mt').textContent=qs[idx].m;
  document.getElementById('sr').style.display=sv.ms?'flex':'none';
}
function saveW(){const q=qs[idx];if(!q||q.type!=='w')return;if(!saved[q.id])saved[q.id]={};saved[q.id].t=document.getElementById('wa').value;}
function chkW(){
  const q=qs[idx];const txt=(document.getElementById('wa').value||'').toLowerCase();
  const hits=q.c.map(c=>({l:c.l,h:c.t.some(t=>txt.includes(t.toLowerCase()))}));
  const got=hits.filter(h=>h.h).length;
  const tally=`<strong>${got} / ${hits.length} key concepts detected</strong>`;
  const chips=hits.map(h=>`<span class="kc ${h.h?'h':'m'}">${h.h?'✓':'✗'} ${h.l}</span>`).join('');
  document.getElementById('kt').innerHTML=tally;document.getElementById('kc').innerHTML=chips;document.getElementById('kr').style.display='block';
  if(!saved[q.id])saved[q.id]={};saved[q.id].kr={tally,chips};saved[q.id].t=document.getElementById('wa').value;
}
function showM(){
  const q=qs[idx];document.getElementById('mt').textContent=q.m;document.getElementById('md').style.display='block';document.getElementById('sr').style.display='flex';
  if(!saved[q.id])saved[q.id]={};saved[q.id].ms=true;saved[q.id].t=document.getElementById('wa').value;
}
function rate(v){wR[qs[idx].id]=v;if(!saved[qs[idx].id])saved[qs[idx].id]={};saved[qs[idx].id].rate=v;document.getElementById('sr').querySelectorAll('button').forEach(b=>b.style.opacity='.4');const b=v==='k'?document.getElementById('sr').children[1]:document.getElementById('sr').children[2];if(b)b.style.opacity='1';}
function prev(){saveW();if(idx>0){idx--;render();}}
function next(){saveW();if(idx<qs.length-1){idx++;render();}}
function results(){
  saveW();
  const mc=qs.filter(q=>q.type==='mc'),mcOk=Object.values(mcR).filter(v=>v==='ok').length,pct=mc.length?Math.round(mcOk/mc.length*100):0;
  document.getElementById('rb').textContent=`${mcOk}/${mc.length}`;
  document.getElementById('rl').textContent=(pct===100?'Perfect MC!':pct>=60?`${pct}% — review misses below`:`${pct}% — revisit lesson 0006`)+' · Written: check self-ratings';
  const miss=qs.filter(q=>q.type==='mc'&&mcR[q.id]==='no');
  const rm=document.getElementById('rm');rm.innerHTML=miss.length?miss.map(q=>`<div class="miss">${q.q.slice(0,68)}…<span class="mcorr">✓ ${q.opts.find(o=>o.c).t.slice(0,55)}</span></div>`).join(''):'<em style="color:var(--dim);font-size:.84rem">None!</em>';
  const revW=qs.filter(q=>q.type==='w'&&wR[q.id]==='r');
  const rw=document.getElementById('rw');rw.innerHTML=revW.length?revW.map(q=>`<div class="miss">${q.q.slice(0,68)}…</div>`).join(''):'<em style="color:var(--dim);font-size:.84rem">None flagged.</em>';
  show('R');
}
function rev(){
  const mc=qs.filter(q=>q.type==='mc'&&mcR[q.id]==='no');
  const wr=qs.filter(q=>q.type==='w'&&wR[q.id]==='r');
  const all=[...mc,...wr];if(!all.length)return;
  mc.forEach(q=>delete mcR[q.id]);wr.forEach(q=>{delete wR[q.id];delete saved[q.id];});
  qs=all;idx=0;show('Q');render();
}
</script>
