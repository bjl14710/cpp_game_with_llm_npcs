<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Drill 0006 — Hardware Docs &amp; Custom Blocks</title>
<style>
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
:root{
  --bg:#0d1117;--surf:#161b22;--surf2:#21262d;--surf3:#30363d;
  --green:#34d399;--blue:#60a5fa;--yellow:#fbbf24;--red:#f87171;
  --orange:#fb923c;--teal:#22d3ee;
  --text:#c9d1d9;--dim:#6e7681;--border:#30363d;--code:#010409;
  --mono:'Cascadia Code','Fira Mono','Consolas',monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;
     background:var(--bg);color:var(--text);font-size:15px;line-height:1.68;min-height:100vh}
.screen{display:none;max-width:820px;margin:0 auto;padding:2rem 1.5rem 5rem}
.screen.active{display:block}

/* ── start ── */
.hd{text-align:center;margin-bottom:1.8rem}
.lbl{font-family:var(--mono);font-size:.72rem;color:var(--dim);letter-spacing:.15em;
     text-transform:uppercase;margin-bottom:.4rem}
.ttl{font-size:2rem;color:#fff;margin-bottom:.35rem}
.sub{color:var(--green);font-size:.94rem;margin-bottom:.3rem}

/* mini pipeline */
.pipe{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;
      gap:.45rem;margin:1.3rem 0 1.6rem}
.ps{font-family:var(--mono);font-size:.74rem;padding:.3rem .7rem;border-radius:4px;
    border:1px solid var(--border)}
.ps.a{border-color:var(--blue);color:var(--blue);background:rgba(96,165,250,.08)}
.ps.b{border-color:var(--green);color:var(--green);background:rgba(52,211,153,.07)}
.ps.c{border-color:var(--yellow);color:var(--yellow);background:rgba(251,191,36,.07)}
.ps.d{border-color:var(--orange);color:var(--orange);background:rgba(251,146,60,.07)}
.arr{color:var(--dim);font-size:1rem}

/* chips */
.chips{display:flex;flex-wrap:wrap;gap:.5rem;justify-content:center;margin:1.2rem 0}
.chip{font-family:var(--mono);font-size:.8rem;padding:.33rem .82rem;
      border:1px solid var(--border);border-radius:20px;cursor:pointer;
      background:var(--surf);color:var(--dim);user-select:none;transition:all .15s}
.chip.on{border-color:var(--green);color:var(--green);background:rgba(52,211,153,.07)}
.chip.all{border-color:var(--yellow);color:var(--yellow)}
.chip.all.on{background:rgba(251,191,36,.06)}
.smeta{text-align:center;color:var(--dim);font-size:.85rem;margin-bottom:.7rem}
.shuf{display:flex;align-items:center;justify-content:center;gap:.65rem;
      margin-bottom:1.2rem;font-size:.86rem;color:var(--dim)}
.tog{position:relative;display:inline-block;width:36px;height:20px}
.tog input{opacity:0;width:0;height:0}
.sl{position:absolute;inset:0;background:var(--surf2);border-radius:20px;cursor:pointer;transition:background .2s}
.sl:before{content:'';position:absolute;width:14px;height:14px;left:3px;top:3px;
           background:#fff;border-radius:50%;transition:transform .2s}
input:checked+.sl{background:var(--green)}
input:checked+.sl:before{transform:translateX(16px)}

/* ── question ── */
.qhdr{display:flex;align-items:center;gap:.8rem;margin-bottom:1.4rem;flex-wrap:wrap}
.qnum{font-family:var(--mono);font-size:.78rem;color:var(--dim)}
.pbar{flex:1;height:5px;background:var(--surf2);border-radius:3px;min-width:80px}
.pfill{height:100%;background:var(--green);border-radius:3px;transition:width .3s}
.ctag{font-family:var(--mono);font-size:.7rem;padding:.18rem .52rem;
      border:1px solid var(--border);border-radius:12px;color:var(--dim)}
.ttag{font-family:var(--mono);font-size:.7rem;padding:.18rem .52rem;border-radius:12px}
.ttag.mc{background:rgba(96,165,250,.12);color:var(--blue)}
.ttag.wr{background:rgba(251,146,60,.12);color:var(--orange)}

.qtxt{font-size:1.04rem;font-weight:600;color:#fff;margin-bottom:.9rem;line-height:1.52}
pre.snip{background:var(--code);border:1px solid var(--border);border-radius:6px;
         padding:.85rem 1.1rem;overflow-x:auto;font-family:var(--mono);
         font-size:.82rem;line-height:1.7;margin-bottom:1rem;display:none}
.cm{color:#2d4a5a;font-style:italic}.kw{color:#ff7b72}.fn{color:var(--green)}
.str{color:#a5d6ff}.cls{color:var(--yellow)}.fl{color:var(--dim);user-select:none;margin-right:.8rem}
.num{color:var(--orange)}.op{color:var(--dim)}.k2{color:var(--teal)}

/* mc */
.opts{list-style:none}
.opts li{background:var(--surf);border:1px solid var(--border);border-radius:5px;
         padding:.5rem .9rem;margin-bottom:.4rem;cursor:pointer;user-select:none;
         transition:border-color .13s,background .13s;font-size:.9rem}
.opts li:hover:not(.lk){border-color:var(--green);background:rgba(52,211,153,.06)}
.opts li.ok{border-color:var(--green);background:rgba(52,211,153,.08);color:var(--green)}
.opts li.no{border-color:var(--red);background:rgba(248,113,113,.06);color:var(--red)}
.opts li.lk{cursor:default}
.mfb{margin-top:.55rem;font-size:.86rem;padding:.4rem .75rem;border-radius:4px;display:none}
.mfb.ok{background:rgba(52,211,153,.08);color:var(--green);border:1px solid rgba(52,211,153,.25)}
.mfb.no{background:rgba(248,113,113,.07);color:var(--red);border:1px solid rgba(248,113,113,.25)}

/* written */
textarea{width:100%;min-height:108px;background:var(--surf);border:1px solid var(--border);
         border-radius:6px;padding:.7rem .9rem;color:#e6edf3;font-family:inherit;
         font-size:.92rem;resize:vertical;line-height:1.55}
textarea:focus{outline:2px solid var(--green)}
.wacts{display:flex;gap:.5rem;margin-top:.55rem;flex-wrap:wrap}
.kwres{margin-top:.75rem;display:none}
.tally{font-weight:700;margin-bottom:.4rem;font-size:.88rem}
.kwchips{display:flex;flex-wrap:wrap;gap:.32rem;margin-bottom:.45rem}
.kc{font-family:var(--mono);font-size:.74rem;padding:.15rem .48rem;border-radius:12px}
.kc.h{background:rgba(52,211,153,.11);color:var(--green);border:1px solid rgba(52,211,153,.25)}
.kc.m{background:rgba(248,113,113,.09);color:var(--red);border:1px solid rgba(248,113,113,.25)}
.knote{color:var(--dim);font-size:.77rem}
.modans{display:none;margin-top:.75rem;background:var(--surf);border:1px solid var(--border);
        border-radius:6px;padding:.75rem 1rem;font-size:.89rem;line-height:1.65;white-space:pre-wrap}
.modlbl{font-family:var(--mono);font-size:.7rem;color:var(--dim);text-transform:uppercase;
        letter-spacing:.08em;margin-bottom:.3rem}
.sr{display:none;align-items:center;gap:.5rem;flex-wrap:wrap;font-size:.85rem;
    color:var(--dim);margin-top:.6rem}

/* nav */
.nav{display:flex;gap:.5rem;margin-top:1.4rem;flex-wrap:wrap;align-items:center}
.spc{flex:1}
.btn{font-family:var(--mono);font-size:.82rem;padding:.42rem .95rem;
     border:1px solid transparent;border-radius:5px;cursor:pointer;transition:opacity .15s}
.pri{background:var(--green);color:#000}.pri:hover{opacity:.82}
.sec{background:var(--surf2);color:#e6edf3;border-color:var(--border)}.sec:hover{border-color:var(--green)}
.grn{background:var(--green);color:#000}.red{background:var(--red);color:#fff}
.gld{background:var(--yellow);color:#000}
.sm{padding:.3rem .68rem;font-size:.76rem}

/* results */
.rhdr{text-align:center;margin-bottom:1.8rem}
.sbig{font-size:3.4rem;font-family:var(--mono);color:var(--green)}
.slbl{color:var(--dim);font-size:.88rem;margin-top:.22rem}
.rcols{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:1.3rem 0}
@media(max-width:520px){.rcols{grid-template-columns:1fr}}
.rcard{background:var(--surf);border:1px solid var(--border);border-radius:7px;padding:.85rem 1.05rem}
.rcard h3{font-family:var(--mono);font-size:.77rem;color:var(--dim);
          text-transform:uppercase;letter-spacing:.08em;margin-bottom:.55rem}
.miss{background:var(--surf2);border-radius:4px;padding:.35rem .6rem;margin-bottom:.35rem;font-size:.85rem}
.mcorr{color:var(--green);font-family:var(--mono);font-size:.79rem;display:block;margin-top:.18rem}
</style>
