// ══════════════════════════════════════════════════════
// APP STATE
// ══════════════════════════════════════════════════════
let selectedCh = new Set(['device','block','registry','gui','separation','traps']);
let doShuffle = true;
let queue = [];
let idx = 0;
let mcResults = {}; // qidx → true/false
let wrResults = {}; // qidx → 'knew'|'review'|null
let typedAnswers = {};

// ── channel chips ──
document.querySelectorAll('.chip').forEach(c => {
  c.addEventListener('click', () => {
    if (c.dataset.ch === 'all') {
      const allOn = selectedCh.size === 6;
      if (allOn) { selectedCh.clear(); document.querySelectorAll('.chip:not(.all-chip)').forEach(x => x.classList.remove('on')); c.classList.remove('on'); }
      else { selectedCh = new Set(['device','block','registry','gui','separation','traps']); document.querySelectorAll('.chip:not(.all-chip)').forEach(x => x.classList.add('on')); c.classList.add('on'); }
    } else {
      if (selectedCh.has(c.dataset.ch)) { selectedCh.delete(c.dataset.ch); c.classList.remove('on'); }
      else { selectedCh.add(c.dataset.ch); c.classList.add('on'); }
      const allChip = document.querySelector('.all-chip');
      allChip.classList.toggle('on', selectedCh.size === 6);
    }
    updateCount();
  });
});

function updateCount() {
  const n = BANK.filter(q => selectedCh.has(q.ch)).length;
  document.getElementById('count-note').textContent = n + ' questions selected';
  document.getElementById('begin-btn').disabled = n === 0;
}

function toggleShuffle() {
  doShuffle = !doShuffle;
  document.getElementById('shuffle-tog').classList.toggle('on', doShuffle);
}

function begin() {
  queue = BANK.filter(q => selectedCh.has(q.ch));
  if (doShuffle) shuffle(queue);
  idx = 0; mcResults = {}; wrResults = {}; typedAnswers = {};
  document.getElementById('start-screen').classList.add('hidden');
  document.getElementById('drill-screen').classList.remove('hidden');
  render();
}

function restart() {
  document.getElementById('results-screen').classList.add('hidden');
  document.getElementById('start-screen').classList.remove('hidden');
  updateCount();
}

function reviewMissed() {
  const missed = queue.filter((q, i) => {
    if (q.type === 'mc') return mcResults[i] === false;
    if (q.type === 'wr') return wrResults[i] === 'review' || wrResults[i] == null;
    return false;
  });
  if (!missed.length) { alert('No misses to review!'); return; }
  queue = missed;
  if (doShuffle) shuffle(queue);
  idx = 0; mcResults = {}; wrResults = {}; typedAnswers = {};
  document.getElementById('results-screen').classList.add('hidden');
  document.getElementById('drill-screen').classList.remove('hidden');
  render();
}

function go(dir) {
  // save textarea
  const ta = document.querySelector('#q-body textarea');
  if (ta) typedAnswers[idx] = ta.value;
  idx += dir;
  if (idx >= queue.length) { showResults(); return; }
  if (idx < 0) idx = 0;
  render();
}

function render() {
  const q = queue[idx];
  document.getElementById('prog-text').textContent = `Q ${idx+1} / ${queue.length}`;
  document.getElementById('prog-fill').style.width = ((idx / queue.length) * 100) + '%';

  // meta tags
  const chLabel = {device:'device layer',block:'block layer',registry:'registration',gui:'gui path',separation:'device/block split',traps:'traps & gotchas'};
  document.getElementById('q-meta').innerHTML =
    `<span class="tag ch-${q.ch}">${chLabel[q.ch]}</span>` +
    `<span class="tag type-${q.type}">${q.type === 'mc' ? 'multiple choice' : 'written recall'}</span>`;

  document.getElementById('q-text').innerHTML = q.q;

  const body = document.getElementById('q-body');
  body.innerHTML = '';

  if (q.type === 'mc') renderMC(q, body);
  else renderWR(q, body);

  document.getElementById('prev-btn').disabled = idx === 0;
  const isLast = idx === queue.length - 1;
  const nb = document.getElementById('next-btn');
  nb.textContent = isLast ? 'finish ✓' : 'next →';
  nb.className = 'nav-btn' + (isLast ? ' finish' : '');
}

function renderMC(q, body) {
  const ul = document.createElement('ul'); ul.className = 'opts';
  const opts = [...q.opts];
  shuffle(opts);
  opts.forEach(opt => {
    const li = document.createElement('li');
    li.innerHTML = opt.t;
    li.dataset.correct = String(opt.correct);
    li.dataset.why = opt.why;
    ul.appendChild(li);
  });
  body.appendChild(ul);

  const fb = document.createElement('div'); fb.className = 'mc-fb'; body.appendChild(fb);

  // restore already-answered
  const prev = mcResults[idx];
  if (prev !== undefined) {
    ul.querySelectorAll('li').forEach(li => {
      li.classList.add('lk');
      if (li.dataset.correct === 'true') li.classList.add('ok');
    });
    fb.style.display = 'block';
    fb.className = 'mc-fb ' + (prev ? 'ok' : 'no');
    fb.textContent = prev ? '✓ Correct.' : '✗ Not quite — correct answer highlighted.';
  }

  ul.querySelectorAll('li').forEach(li => {
    li.addEventListener('click', () => {
      if (li.classList.contains('lk')) return;
      ul.querySelectorAll('li').forEach(x => x.classList.add('lk'));
      const correct = li.dataset.correct === 'true';
      li.classList.add(correct ? 'ok' : 'no');
      if (!correct) ul.querySelector('[data-correct="true"]').classList.add('ok');
      mcResults[idx] = correct;
      fb.style.display = 'block';
      fb.className = 'mc-fb ' + (correct ? 'ok' : 'no');
      fb.textContent = (correct ? '✓ Correct. ' : '✗ Not quite. ') + li.dataset.why;
    });
  });
}

function renderWR(q, body) {
  const ta = document.createElement('textarea');
  ta.placeholder = 'Type your answer here…';
  ta.value = typedAnswers[idx] || '';
  body.appendChild(ta);

  const actions = document.createElement('div'); actions.className = 'wr-actions';
  const checkBtn = document.createElement('button'); checkBtn.className = 'wr-btn'; checkBtn.textContent = 'Check my answer';
  const showBtn = document.createElement('button'); showBtn.className = 'wr-btn show-btn'; showBtn.textContent = 'Show model answer';
  actions.append(checkBtn, showBtn); body.appendChild(actions);

  const hitsDiv = document.createElement('div'); hitsDiv.className = 'concept-hits'; body.appendChild(hitsDiv);
  const modelDiv = document.createElement('div'); modelDiv.className = 'model-ans'; body.appendChild(modelDiv);

  const roughNote = document.createElement('p'); roughNote.className = 'rough-note';
  roughNote.textContent = 'Keyword check is rough — self-judge honestly against the model answer.';
  body.appendChild(roughNote);

  checkBtn.addEventListener('click', () => {
    typedAnswers[idx] = ta.value;
    const text = ta.value.toLowerCase();
    const results = q.concepts.map(c => ({ label: c.label, hit: c.terms.some(t => text.includes(t.toLowerCase())) }));
    const got = results.filter(r => r.hit).length;
    const total = results.length;
    hitsDiv.innerHTML = `<div class="tally">${got} / ${total} key concepts detected</div>` +
      results.map(r => `<div class="${r.hit ? 'hit' : 'miss'}">${r.hit ? '✓' : '✗'} ${r.label}</div>`).join('');
  });

  showBtn.addEventListener('click', () => {
    typedAnswers[idx] = ta.value;
    modelDiv.style.display = 'block';
    modelDiv.innerHTML = `<strong>Model answer:</strong><br>${q.model.replace(/\n/g,'<br>')}
      <div class="self-rate">
        <button class="sr-btn sr-knew" onclick="rate(${idx},'knew',this)">✓ Knew it</button>
        <button class="sr-btn sr-review" onclick="rate(${idx},'review',this)">⚑ Needs review</button>
      </div>`;
    // restore rating
    if (wrResults[idx]) {
      const btn = wrResults[idx] === 'knew' ? modelDiv.querySelector('.sr-knew') : modelDiv.querySelector('.sr-review');
      if (btn) btn.style.fontWeight = '700';
    }
  });

  // restore if already rated
  if (wrResults[idx]) {
    modelDiv.style.display = 'block';
    modelDiv.innerHTML = `<strong>Model answer:</strong><br>${q.model.replace(/\n/g,'<br>')}
      <div class="self-rate">
        <button class="sr-btn sr-knew" onclick="rate(${idx},'knew',this)">✓ Knew it</button>
        <button class="sr-btn sr-review" onclick="rate(${idx},'review',this)">⚑ Needs review</button>
      </div>`;
    const btn = wrResults[idx] === 'knew' ? modelDiv.querySelector('.sr-knew') : modelDiv.querySelector('.sr-review');
    if (btn) btn.style.fontWeight = '700';
  }
}

function rate(i, rating, btn) {
  wrResults[i] = rating;
  btn.closest('.self-rate').querySelectorAll('button').forEach(b => b.style.fontWeight = '');
  btn.style.fontWeight = '700';
}

function showResults() {
  document.getElementById('drill-screen').classList.add('hidden');
  document.getElementById('results-screen').classList.remove('hidden');

  const mcQs = queue.filter((q, i) => q.type === 'mc');
  const mcTotal = mcQs.length;
  const mcCorrect = Object.values(mcResults).filter(Boolean).length;
  document.getElementById('mc-score').textContent = `${mcCorrect}/${mcTotal}`;

  const wrQs = queue.filter((q, i) => q.type === 'wr');
  const knew = Object.values(wrResults).filter(r => r === 'knew').length;
  const wrTotal = wrQs.length;
  document.getElementById('wr-score').textContent = `${knew}/${wrTotal}`;

  const missDiv = document.getElementById('miss-list');
  const missed = queue.filter((q, i) => {
    if (q.type === 'mc') return mcResults[i] === false;
    if (q.type === 'wr') return wrResults[i] === 'review' || wrResults[i] == null;
    return false;
  });
  if (missed.length) {
    missDiv.innerHTML = `<h3>Topics to revisit (${missed.length})</h3>` +
      missed.map(q => `<div class="miss-item">${q.q.replace(/<[^>]+>/g,'').substring(0,100)}…</div>`).join('');
  } else {
    missDiv.innerHTML = '<p style="color:var(--green);font-family:var(--mono)">✓ Clean sweep — no misses!</p>';
  }
}

// Fisher-Yates
function shuffle(a) {
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

updateCount();
