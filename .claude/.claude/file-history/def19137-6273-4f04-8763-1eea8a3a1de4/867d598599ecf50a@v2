<script>
// ── Section progress ──────────────────────────────────────────
const checks = document.querySelectorAll('.section-check');
const totalSections = checks.length;

function updateProgress() {
  const done = [...checks].filter(c => c.checked).length;
  document.getElementById('progress-fill').style.width = (done / totalSections * 100) + '%';
  document.getElementById('progress-text').textContent = done + ' / ' + totalSections + ' sections complete';
}

checks.forEach(c => c.addEventListener('change', updateProgress));
updateProgress();

// ── Quiz shuffle & logic ──────────────────────────────────────
function shuffle(arr) {
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

let correct = 0;
let answered = 0;
const totalQ = 5;

document.querySelectorAll('[data-question]').forEach(block => {
  const list = block.querySelector('.options');
  const items = [...list.children];
  shuffle(items).forEach(li => list.appendChild(li)); // randomize DOM order

  const feedback = block.querySelector('.feedback');

  list.querySelectorAll('li').forEach(li => {
    li.addEventListener('click', () => {
      if (block.dataset.done) return; // already answered
      block.dataset.done = 'true';
      answered++;

      const isCorrect = li.dataset.correct === 'true';
      if (isCorrect) correct++;

      // mark all options
      list.querySelectorAll('li').forEach(opt => {
        opt.classList.add('disabled');
        if (opt.dataset.correct === 'true') opt.classList.add('correct');
        else opt.classList.add('wrong');
      });

      feedback.hidden = false;
      feedback.textContent = (isCorrect ? '✓ Correct. ' : '✗ Not quite. ') + li.dataset.why;
      feedback.className = 'feedback ' + (isCorrect ? 'correct-fb' : 'wrong-fb');

      if (answered === totalQ) {
        const sa = document.getElementById('score-area');
        sa.hidden = false;
        document.getElementById('score-val').textContent = correct;
        sa.style.color = correct >= 4 ? 'var(--green)' : correct >= 2 ? 'var(--yellow)' : 'var(--red)';
      }
    });
  });
});

// ── Scenario toggles ──────────────────────────────────────────
document.getElementById('toggleA').addEventListener('click', e => {
  e.preventDefault();
  const el = document.getElementById('ansA');
  el.hidden = !el.hidden;
});
document.getElementById('toggleB').addEventListener('click', e => {
  e.preventDefault();
  const el = document.getElementById('ansB');
  el.hidden = !el.hidden;
});
</script>
