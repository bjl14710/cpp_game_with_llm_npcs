<script>
  function shuffle(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  const totalQuestions = document.querySelectorAll('[data-question]').length;
  let correct = 0;
  const scoreText = document.getElementById('scoreText');
  function renderScore() { scoreText.textContent = correct + ' / ' + totalQuestions; }
  renderScore();

  document.querySelectorAll('[data-question]').forEach(q => {
    const list = q.querySelector('.options');
    shuffle([...list.children]).forEach(li => list.appendChild(li));

    const feedback = q.querySelector('.feedback');
    list.querySelectorAll('li').forEach(li => {
      li.addEventListener('click', () => {
        if (q.dataset.answered === '1') return;
        q.dataset.answered = '1';

        const isRight = li.dataset.correct === 'true';
        li.classList.add(isRight ? 'picked-correct' : 'picked-wrong');
        list.querySelectorAll('li').forEach(other => {
          if (other !== li) other.classList.add('locked');
        });

        feedback.hidden = false;
        feedback.className = 'feedback ' + (isRight ? 'correct' : 'wrong');
        feedback.textContent = (isRight ? '✓ Correct. ' : '✗ Not quite. ') + li.dataset.why;

        if (isRight) correct++;
        renderScore();
      });
    });
  });

  document.querySelectorAll('#progressList input[type=checkbox]').forEach(cb => {
    cb.addEventListener('change', () => {
      cb.closest('li').classList.toggle('done', cb.checked);
    });
  });
</script>
