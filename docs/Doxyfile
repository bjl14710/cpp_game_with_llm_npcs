# Doxyfile — Silmulator v1.0.0
# Generated for Doxygen 1.9+
# Run: doxygen docs/Doxyfile (from the Silmulator/ root directory)
# Output: docs/doxygen/html/index.html

#---------------------------------------------------------------------------
# Project information
#---------------------------------------------------------------------------
PROJECT_NAME           = "Silmulator"
PROJECT_NUMBER         = "1.0.0"
PROJECT_BRIEF          = "SIL/HIL/CIL Virtual Hardware Simulator"
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = YES

#---------------------------------------------------------------------------
# Build related
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
INLINE_INHERITED_MEMB  = YES
FULL_PATH_NAMES        = NO
SHORT_NAMES            = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES
SEPARATE_MEMBER_PAGES  = NO
TAB_SIZE               = 4

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = cpp_core/include \
                         cpp_core/src \
                         silmulator/devices \
                         silmulator/scpi \
                         silmulator/code_parser \
                         silmulator/utils

INPUT_ENCODING         = UTF-8

FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.cpp \
                         *.py

RECURSIVE              = YES

EXCLUDE                = silmulator/gui

EXCLUDE_PATTERNS       = */build/* \
                         */__pycache__/* \
                         *.pyc

EXCLUDE_SYMBOLS        =

#---------------------------------------------------------------------------
# Python support (via doxypypy or breathe)
#---------------------------------------------------------------------------
FILTER_PATTERNS        = *.py=doxypypy
# If doxypypy is not installed, comment the line above and set:
# FILTER_PATTERNS =
# Python docstrings will still appear as plain text.

#---------------------------------------------------------------------------
# Source browsing
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

#---------------------------------------------------------------------------
# HTML output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_HEADER            =
HTML_FOOTER            =
HTML_EXTRA_STYLESHEET  =
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 250
GENERATE_HTMLHELP      = NO

#---------------------------------------------------------------------------
# LaTeX output (disabled — use HTML)
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO

#---------------------------------------------------------------------------
# Diagrams (requires Graphviz / dot)
#---------------------------------------------------------------------------
HAVE_DOT               = YES
DOT_NUM_THREADS        = 0
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 10
TEMPLATE_RELATIONS     = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_PATH               =
DOTFILE_DIRS           =
DOT_GRAPH_MAX_NODES    = 100
MAX_DOT_GRAPH_DEPTH    = 0
DOT_TRANSPARENT        = YES
DOT_MULTI_TARGETS      = YES
GENERATE_LEGEND        = YES
DOT_CLEANUP            = YES

#---------------------------------------------------------------------------
# Preprocessor
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = cpp_core/include
INCLUDE_FILE_PATTERNS  =
PREDEFINED             =

#---------------------------------------------------------------------------
# Index
#---------------------------------------------------------------------------
ALPHABETICAL_INDEX     = YES
COLS_IN_ALPHA_INDEX    = 5
GENERATE_DOCSET        = NO
GENERATE_ECLIPSEHELP   = NO
GENERATE_QHP           = NO
GENERATE_PERLMOD       = NO

#---------------------------------------------------------------------------
# Search
#---------------------------------------------------------------------------
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
