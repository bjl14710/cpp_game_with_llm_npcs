  trigger = hi there
  trigger = im back
  trigger = good morning
  trigger = hey marge
  trigger = morning marge
  trigger = hi
  trigger = hey
  trigger = im here
  trigger = hello marge
  reply = Back for more! I knew you would be. The rye or the sourdough today? [[MOOD: happy]]
  reply = There you are. I saved you the good end of the loaf. [[MOOD: happy]]
  reply = Look who it is. Kettle's on, and don't argue with me about it. [[MOOD: happy]]
  reply = Well, hello. My dough rises, my regulars return — that's the whole trick to a day. [[MOOD: happy]]

topic = bread_menu
  familiarity = any
  trigger = what do you sell
  trigger = what do you have
  trigger = sell
  trigger = whats good
  trigger = what bread
  trigger = do you sell bread
  trigger = anything to eat
  trigger = im hungry
  trigger = what do you recommend
  trigger = whats fresh
  trigger = food
  trigger = buy bread
  reply = Sourdough, rye, and a milk loaf that sells out by ten. Start with the sourdough. [[MOOD: happy]]
  reply = Bread, love. Good bread. The rye's got a crust on it you could knock on. [[MOOD: happy]]
  reply = Everything you see, and the sourdough twice over. It's what I'd feed my own. [[MOOD: happy]]
  reply = Fresh loaves, still ticking as they cool. Listen — that crackle means you want that one. [[MOOD: happy]]

