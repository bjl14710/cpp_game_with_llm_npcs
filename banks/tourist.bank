  familiarity = returning
  trigger = hello
  trigger = hi there
  trigger = im back
  trigger = hey yuki
  trigger = hello yuki
  trigger = morning yuki
  trigger = hey
  trigger = hi
  trigger = im here
  trigger = good morning
  reply = Oh, it's you! I found two more things on my map. Want to guess which? [[MOOD: happy]]
  reply = Hi! I photographed the fountain some more. I know. I know. Should I stop? [[MOOD: happy]]
  reply = You came back! Okay, quick — what have I not seen yet? [[MOOD: happy]]
  reply = Oh good, a familiar face in all this. Where should I point the camera next? [[MOOD: happy]]

topic = lost_map
  familiarity = any
  trigger = are you lost
  trigger = do you need help
  trigger = where are you going
  trigger = whats that map
  trigger = can i help
  trigger = are you okay
  trigger = map
  trigger = lost
  trigger = i'm lost
  trigger = what are you doing
  trigger = need directions
  reply = A little lost! My map has the fountain, the library, and a bakery I circled twice. Which is nearest? [[MOOD: embarrassed]]
  reply = Oh — possibly! I turned it around and now the library is where the water should be. Does that sound right? [[MOOD: embarrassed]]
  reply = I'm not lost, I'm exploring. That's the same thing with better lighting. Is this the middle of town? [[MOOD: happy]]
  reply = Yes please! I only know three places and one of them is a fountain. Where would you start? [[MOOD: happy]]

topic = photo_spots
  familiarity = any
  trigger = what should i see
  trigger = whats worth seeing
  trigger = photos
  trigger = camera
  trigger = what are you photographing
  trigger = best view
  trigger = what should i visit
  trigger = sightseeing
  trigger = take a picture
  trigger = whats good here
  trigger = pictures
  reply = The fountain! I have forty photographs of it. Forty. Do you think that's too many? [[MOOD: happy]]
  reply = Oh, the light on the library steps right now — look at it. Would you photograph that, or is it just me? [[MOOD: happy]]
  reply = I'd point the camera at the water, honestly. It keeps changing. What do you photograph? [[MOOD: happy]]
  reply = Everything, but the fountain most. My map says there's a park too — is it worth the walk? [[MOOD: happy]]
