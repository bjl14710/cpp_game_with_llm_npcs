  trigger = hey
  trigger = good morning
  trigger = morning
  trigger = excuse me
  trigger = hi
  trigger = hello there
  trigger = afternoon
  trigger = greetings
  reply = Oh! Hello! Do you live here? I arrived this morning and everything is enormous. [[MOOD: happy]]
  reply = Hi! Sorry — I'm holding my map upside down, aren't I. Is that the fountain over there? [[MOOD: happy]]
  reply = Oh, hello! You look like someone who knows where things are. Are you? [[MOOD: happy]]
  reply = Hi there! I'm Yuki. I have a camera and a very crumpled map. Which should I trust? [[MOOD: happy]]

