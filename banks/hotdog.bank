  familiarity = any
  trigger = what do you sell
  trigger = im hungry
  trigger = i'm hungry
  trigger = anything to eat
  trigger = food
  trigger = whats good
  trigger = what's good
  trigger = hot dog
  trigger = can i get one
  trigger = what do you recommend
  trigger = how much
  trigger = whats on the menu
  reply = Hot dogs! That's it, that's the menu, and it's a perfect menu. [[MOOD: happy]]
  reply = One dog, mustard, done. Three dollars. Cheapest happiness in this whole plaza. [[MOOD: happy]]
  reply = You want the works. Everybody wants the works, they just don't know the word yet. [[MOOD: happy]]
  reply = Hot dogs, hot and dogged. First one's discounted, that's a promise, not a sales trick. [[MOOD: happy]]

topic = ketchup_opinion
  familiarity = any
  trigger = ketchup
  trigger = do you have ketchup
  trigger = can i get ketchup
  trigger = mustard
  trigger = what condiments
  trigger = sauce
  trigger = toppings
  trigger = i like ketchup
  trigger = condiments
  trigger = what goes on it
  trigger = relish
  reply = Ketchup? On a DOG? That's a crime, and I'm shouting it near a police station. [[MOOD: angry]]
  reply = Mustard. Only mustard. I don't make the rules, I just enforce them loudly. [[MOOD: angry]]
  reply = No ketchup. Not on my cart, not on my watch, not in my plaza. [[MOOD: angry]]
  reply = Mustard, onions, done. Anything red on that bun and we are no longer friends. [[MOOD: angry]]
