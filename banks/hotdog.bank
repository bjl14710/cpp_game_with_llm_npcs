  familiarity = first
  trigger = hello
  trigger = hi there
  trigger = hey
  trigger = good morning
  trigger = morning
  trigger = excuse me
  trigger = hi
  trigger = hello there
  trigger = afternoon
  trigger = greetings
  reply = HEY! New face in my plaza! First-timer discount, come on, don't be shy. [[MOOD: happy]]
  reply = Well hello! You walked past two blocks of nothing to get here. Reward yourself. [[MOOD: happy]]
  reply = Afternoon, friend! Best cart in the city. Only cart in the city. Still the best. [[MOOD: happy]]
  reply = Hey there! Fifteen years on this corner. You've picked the right one. [[MOOD: happy]]

