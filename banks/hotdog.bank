  familiarity = returning
  trigger = hello
  trigger = hi there
  trigger = im back
  trigger = hey gus
  trigger = hello gus
  trigger = morning gus
  trigger = hey
  trigger = hi
  trigger = im here
  trigger = good morning
  reply = THERE'S my customer! Same as last? Say yes, I've already got the bun. [[MOOD: happy]]
  reply = Hey hey! You keep coming back and I keep being right about you. [[MOOD: happy]]
  reply = My friend returns! The cart has missed you. I have missed you. Mostly the cart. [[MOOD: happy]]
  reply = You're back! Good. Sit, eat, tell me nothing about ketchup. [[MOOD: happy]]

