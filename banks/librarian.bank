# banks/librarian.bank — seed content for issue #153, human-approved via PR.
persona = Ms. Adaeze Obi

topic = greeting_first
  familiarity = first
  trigger = hello
  trigger = hi there
  trigger = hey
  trigger = good morning
  trigger = morning
  trigger = excuse me
  trigger = hi
  trigger = hello there
  trigger = afternoon
  trigger = greetings
  reply = Good afternoon. You may speak at that volume; the steps are not the reading room. [[MOOD: neutral]]
  reply = Hello. I am Ms. Obi, and this is the City Library. Both of us are quieter than we look. [[MOOD: neutral]]
  reply = Good morning. Whatever you are looking for, we very likely shelved it. [[MOOD: neutral]]
  reply = Hello there. Take the steps slowly; the fountain is worth listening to on the way up. [[MOOD: happy]]

topic = greeting_returning
  familiarity = returning
  trigger = hello
  trigger = hi there
  trigger = im back
  trigger = hello ms obi
  trigger = hi ms obi
  trigger = morning ms obi
  trigger = hey
  trigger = hi
  trigger = im here
  trigger = good morning
  reply = Ah. You have returned, and — I hope — so has the book. [[MOOD: neutral]]
  reply = Hello. I set something aside that I think will suit you better than the last one did. [[MOOD: happy]]
  reply = Good afternoon. The steps have been holding your seat. [[MOOD: happy]]
  reply = You are becoming a regular. That is the highest compliment this building offers. [[MOOD: happy]]

topic = book_recommendation
  familiarity = any
  trigger = recommend a book
  trigger = what should i read
  trigger = any good books
  trigger = book
  trigger = reading
  trigger = what do you recommend
  trigger = library
  trigger = do you have books
  trigger = something to read
  trigger = suggest a book
  trigger = whats good
  trigger = what's good
  reply = Try The Quiet Ledger. It is about a bookkeeper who notices everything and says almost nothing. [[MOOD: happy]]
  reply = Salt and Paper Streets. A slim history of a city much like this one. Shelved under local. [[MOOD: happy]]
  reply = The Fountain Almanac. Dreadful title, remarkable book. Read the middle third first. [[MOOD: happy]]
  reply = I would give you Hollow Bell. It is patient, and it rewards patience. Most good things do. [[MOOD: neutral]]

topic = directions_precise
  familiarity = any
  trigger = im lost
  trigger = i'm lost
  trigger = lost
  trigger = where am i
  trigger = directions
  trigger = which way
  trigger = where is the plaza
  trigger = how do i get there
  trigger = help me find
  trigger = where do i go
  trigger = where is the bakery
  trigger = whats around here
  reply = East forty paces to the fountain, then north for the park. Cardinal directions, not landmarks. [[MOOD: neutral]]
  reply = The plaza lies directly east of these steps. Sixty paces, fewer if you are in a hurry. [[MOOD: neutral]]
  reply = Bakery is southwest of these steps. Two hundred paces, and you will smell it before you see it. [[MOOD: neutral]]
  reply = North and east from here. The park sits at the far corner, where the guitar noise begins. [[MOOD: neutral]]
