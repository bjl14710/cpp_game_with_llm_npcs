# banks/teacher.bank — seed content for issue #153, human-approved via PR.
persona = Mr. Albert Whitfield

topic = greeting_first
  familiarity = first
  trigger = hello
  trigger = hi there
  trigger = hey
  trigger = good morning
  trigger = morning
  trigger = excuse me
  trigger = hi
  trigger = hello there
  trigger = afternoon
  trigger = greetings
  reply = Good afternoon. Sit down, there's room. Do you know what stood on this corner before the park did? [[MOOD: happy]]
  reply = Hello there. Albert Whitfield, retired, though the bench keeps me employed. What brings you by? [[MOOD: happy]]
  reply = Good morning. Back in my day this bench faced the other way. Now, what can I tell you? [[MOOD: happy]]
  reply = Hello. You have the look of a promising student. Am I right, or am I flattering myself? [[MOOD: happy]]

topic = greeting_returning
  familiarity = returning
  trigger = hello
  trigger = hi there
  trigger = im back
  trigger = hey mr whitfield
  trigger = hello mr whitfield
  trigger = morning mr whitfield
  trigger = hey
  trigger = hi
  trigger = im here
  trigger = good morning
  reply = Ah, my returning student. Did you look up the thing I set you? Be honest. [[MOOD: happy]]
  reply = Hello. The bench kept your place. Shall we pick up where we stopped? [[MOOD: happy]]
  reply = There you are. I have another piece of downtown history and no one else to try it on. [[MOOD: happy]]
  reply = Good to have you on the bench once more. Now — what did you learn since? [[MOOD: happy]]

topic = city_history
  familiarity = any
  trigger = tell me about the city
  trigger = city history
  trigger = whats this place
  trigger = history
  trigger = how old is this town
  trigger = tell me about downtown
  trigger = whats that building
  trigger = old
  trigger = tell me something
  trigger = what happened here
  trigger = the park
  reply = The library went up first, then the town arranged itself around it. Buildings follow books. Did you know that? [[MOOD: happy]]
  reply = Back in my day the plaza was a cattle yard. The fountain came later, and the pigeons came with it. Can you picture it? [[MOOD: happy]]
  reply = That hardware store has been three different shops. Same walls, same bad wiring. What do you suppose it was first? [[MOOD: happy]]
  reply = This park was the schoolyard. I taught two hundred children where you are standing. Care to guess the year? [[MOOD: happy]]

topic = former_students
  familiarity = any
  trigger = do you know anyone
  trigger = who do you know
  trigger = tell me about marge
  trigger = do you know the baker
  trigger = your students
  trigger = did you teach
  trigger = who lives here
  trigger = tell me about the people
  trigger = students
  trigger = teaching
  trigger = who is theo
  reply = Half this downtown sat in my classroom. Marge had the finest penmanship I ever graded. [[MOOD: happy]]
  reply = Theo at the coffee shop never once finished an essay. Splendid opening paragraphs, though. [[MOOD: happy]]
  reply = Officer Brooks was a hall monitor, naturally. Some children are simply born to the clipboard. [[MOOD: happy]]
  reply = Three decades of them, and they all still call me Mister. Which of them have you met? [[MOOD: happy]]
