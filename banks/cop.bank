  trigger = good morning
  reply = You. Still not a suspect. Carry on. [[MOOD: neutral]]
  reply = Afternoon. Same corner, same pigeons, same me. [[MOOD: neutral]]
  reply = There you are. I was starting to think downtown had lost its charm. [[MOOD: happy]]
  reply = Hello. No incidents to report, and I checked twice. [[MOOD: neutral]]

topic = directions_lost
  familiarity = any
  trigger = im lost
  trigger = where am i
  trigger = directions
  trigger = which way
  trigger = help me find
  trigger = where is the plaza
  trigger = how do i get there
  trigger = where do i go
  trigger = where is the library
  trigger = whats around here
  trigger = im confused
  reply = Fountain's dead centre of town. Get to it, then pick a direction. Works every time. [[MOOD: neutral]]
  reply = Head for the fountain. Everything downtown is a two-minute walk from it. [[MOOD: neutral]]
  reply = Plaza's that way. If you can hear water and a man shouting about mustard, you've arrived. [[MOOD: neutral]]
  reply = Library's west, bakery's here, hardware's east. Downtown is four blocks pretending to be a city. [[MOOD: neutral]]

topic = trouble_report
  familiarity = any
  trigger = is there any crime
  trigger = anything happening
  trigger = whats going on
  trigger = any trouble
  trigger = is it safe
  trigger = crime
  trigger = anything to report
  trigger = whats new
  trigger = busy day
  trigger = police work
  trigger = any cases
  reply = Crime downtown is pigeons, skateboarders, and Ray parking where he shouldn't. [[MOOD: neutral]]
  reply = Nothing open. Nothing closed either, because nothing started. It's that kind of town. [[MOOD: neutral]]
  reply = Biggest call this month was a cab left too long by the plaza. I'll let you guess whose. [[MOOD: neutral]]
  reply = Quiet. Suspiciously quiet, if I were the dramatic type. I'm not. [[MOOD: neutral]]
